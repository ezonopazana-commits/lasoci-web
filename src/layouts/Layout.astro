---
import '../styles/global.css';
interface Props {
  title: string;
  lang?: 'es' | 'ca';
}
const { title, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="la Soci — Associació del Personal de CaixaBank" />
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('lasoci_lang') || 'es';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
      })();
    </script>
    <style is:global>
      body { visibility: hidden; }
      body.lang-ready { visibility: visible; }

      /* Orange border by default, green on focus */
      .form-input {
        border-color: #f97316 !important;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .form-input:focus {
        border-color: #22c55e !important;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15) !important;
        outline: none !important;
      }

      /* Nav hover effect */
      .nav-link {
        border: 1px solid transparent !important;
        transition: all 0.2s ease !important;
      }
      .nav-link:hover {
        border-color: #4ade80 !important;
        background-color: rgba(74, 222, 128, 0.15) !important;
        color: white !important;
      }

      /* Lang dropdown styles */
      #lang-dropdown-menu {
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.15s ease, transform 0.15s ease;
        pointer-events: none;
      }
      #lang-dropdown-menu.open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: all;
      }
      .lang-option.active {
        background-color: #f0f4ff;
        font-weight: 600;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white font-sans">

    <!-- NAVBAR -->
    <nav style="background:linear-gradient(135deg,#0d1b2e 0%,#1a2744 60%,#1e2f55 100%);border-bottom:1px solid rgba(255,255,255,0.07);" class="text-white shadow-2xl sticky top-0 z-50 backdrop-blur-sm">
      <div class="max-w-7xl mx-auto px-5 flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/" class="flex items-center flex-shrink-0">
          <img src="/logo-lasoci.png.JPG" alt="la Soci" class="h-9 w-auto object-contain" />
        </a>

        <!-- Nav links desktop -->
        <div class="hidden lg:flex items-center gap-1 text-sm font-medium flex-1 justify-center">
          <a href="/secciones" class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition whitespace-nowrap" data-i18n="nav_seccions">Secciones</a>
          <a href="/agenda" class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition whitespace-nowrap">Agenda</a>
          <a href="/viajes" class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition whitespace-nowrap" data-i18n="nav_viajes">Viajes</a>
          <a href="/ventajas" class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition whitespace-nowrap" data-i18n="nav_ventajas">Ventajas</a>
          <!-- Quiénes somos dropdown -->
          <div class="relative group">
            <button class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition flex items-center gap-1 whitespace-nowrap" data-i18n="nav_quienes">Quiénes somos
              <svg class="w-3 h-3 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="absolute top-full left-0 mt-1 w-52 bg-white rounded-xl shadow-xl border border-gray-100 py-1 hidden group-hover:block z-50">
              <a href="/quienes-somos" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" data-i18n="qs_nav_nosotros">Nosotros</a>
              <a href="/quienes-somos/historia" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" data-i18n="qs_nav_historia">Historia</a>
              <a href="/quienes-somos/organizacion" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" data-i18n="qs_nav_org">Organización</a>
              <a href="/quienes-somos/preguntas" class="block px-4 py-2 text-sm text-gray-700 hover:bg-gray-50" data-i18n="qs_nav_faq">Preguntas frecuentes</a>
            </div>
          </div>
          <a href="/noticias" class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition whitespace-nowrap" data-i18n="nav_noticies">Noticias</a>
          <a href="/contacto" class="text-gray-300 hover:text-white hover:bg-white/10 px-3 py-2 rounded-lg transition whitespace-nowrap" data-i18n="nav_contacte">Contacto</a>
        </div>

        <!-- Right side -->
        <div class="hidden lg:flex items-center gap-2 flex-shrink-0">
          <!-- Selector idioma -->
          <div class="relative" id="lang-dropdown">
            <button id="lang-btn" class="flex items-center gap-1.5 bg-white/10 hover:bg-white/20 px-3 py-2 rounded-lg transition text-sm">
              <img id="lang-flag-img" src="https://flagcdn.com/w40/es.png" class="w-5 h-5 rounded-full object-cover flex-shrink-0" alt="" />
              <span id="lang-label" class="text-xs">Español</span>
              <svg id="lang-chevron" class="w-3 h-3 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div id="lang-dropdown-menu" class="absolute right-0 mt-2 w-44 bg-white rounded-xl shadow-2xl overflow-hidden z-50 border border-gray-200 py-1">
              <button onclick="setLang('es')" id="lang-opt-es" class="lang-option w-full flex items-center justify-between px-4 py-2.5 text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                <div class="flex items-center gap-2">
                  <img src="https://flagcdn.com/w40/es.png" class="w-6 h-6 rounded-full object-cover" alt="ES" />
                  <span>Español</span>
                </div>
                <svg id="check-es" class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button onclick="setLang('ca')" id="lang-opt-ca" class="lang-option w-full flex items-center justify-between px-4 py-2.5 text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                <div class="flex items-center gap-2">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Flag_of_Catalonia.svg/40px-Flag_of_Catalonia.svg.png" class="w-6 h-6 rounded-full object-cover" alt="CA" />
                  <span>Català</span>
                </div>
                <svg id="check-ca" class="w-4 h-4 text-blue-600 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button onclick="setLang('en')" id="lang-opt-en" class="lang-option w-full flex items-center justify-between px-4 py-2.5 text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                <div class="flex items-center gap-2">
                  <img src="https://flagcdn.com/w40/gb.png" class="w-6 h-6 rounded-full object-cover" alt="EN" />
                  <span>English</span>
                </div>
                <svg id="check-en" class="w-4 h-4 text-blue-600 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
            </div>
          </div>

          <a href="/socios/registro" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition font-semibold text-sm flex items-center gap-1 whitespace-nowrap" data-i18n="nav_asociate">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            +Asóciate
          </a>
          <a href="/socios/login" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg transition font-semibold text-sm whitespace-nowrap" data-i18n="nav_area">Área socios</a>
        </div>

        <!-- Mobile burger -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg hover:bg-white/10 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 px-5 py-4 space-y-1">
        <a href="/secciones" class="block text-gray-300 hover:text-white py-2 text-sm" data-i18n="nav_seccions">Secciones</a>
        <a href="/agenda" class="block text-gray-300 hover:text-white py-2 text-sm">Agenda</a>
        <a href="/viajes" class="block text-gray-300 hover:text-white py-2 text-sm" data-i18n="nav_viajes">Viajes</a>
        <a href="/ventajas" class="block text-gray-300 hover:text-white py-2 text-sm" data-i18n="nav_ventajas">Ventajas</a>
        <a href="/quienes-somos" class="block text-gray-300 hover:text-white py-2 text-sm" data-i18n="nav_quienes">Quiénes somos</a>
        <a href="/noticias" class="block text-gray-300 hover:text-white py-2 text-sm" data-i18n="nav_noticies">Noticias</a>
        <a href="/contacto" class="block text-gray-300 hover:text-white py-2 text-sm" data-i18n="nav_contacte">Contacto</a>
        <div class="flex gap-2 pt-3">
          <a href="/socios/registro" class="flex-1 bg-green-500 text-white text-center py-2 rounded-lg text-sm font-semibold" data-i18n="nav_asociate">+Asóciate</a>
          <a href="/socios/login" class="flex-1 bg-orange-500 text-white text-center py-2 rounded-lg text-sm font-semibold" data-i18n="nav_area">Área socios</a>
        </div>
      </div>
    </nav>

    <!-- COOKIE BANNER -->
    <div id="cookie-banner" class="fixed bottom-0 left-0 right-0 z-[100] bg-white border-t border-gray-200 shadow-2xl hidden">
      <div class="max-w-5xl mx-auto px-6 py-6">
        <!-- Logo -->
        <div class="flex items-center gap-2 mb-4">
          <img src="/logo-lasoci.png.JPG" alt="la Soci" class="h-7 w-auto" />
        </div>
        <!-- Texto -->
        <p class="text-sm text-gray-700 mb-3">
          <strong class="text-blue-700" data-i18n="cookie_title">Antes de continuar, te explicamos para qué usamos las cookies.</strong>
          <span data-i18n="cookie_desc"> Este sitio web de la Soci recoge datos sobre tu navegación a través de cookies propias y de terceros, que analizamos para:</span>
        </p>
        <ul class="text-sm text-gray-700 mb-3 space-y-1 list-disc pl-5">
          <li data-i18n="cookie_li1"><strong>Mejorar nuestro sitio web</strong>, nuestros servicios y funcionalidades.</li>
          <li data-i18n="cookie_li2"><strong>Recordar tus preferencias</strong> de idioma y sesión.</li>
          <li data-i18n="cookie_li3"><strong>Analizar el uso</strong> de la web para mejorar la experiencia.</li>
        </ul>
        <p class="text-sm text-gray-600 mb-5">
          <span data-i18n="cookie_more">Puedes conocer más sobre el uso de cookies en nuestra </span>
          <a href="/cookies" class="text-blue-600 hover:underline" data-i18n="cookie_policy">política de cookies</a>.
        </p>
        <!-- Botones -->
        <div class="flex flex-wrap items-center gap-3">
          <button onclick="configurarCookies()" class="text-sm font-semibold text-blue-700 hover:underline" data-i18n="cookie_btn_config">Configurar cookies</button>
          <button onclick="rechazarCookies()" class="bg-blue-700 hover:bg-blue-800 text-white text-sm font-semibold px-6 py-2.5 rounded-full transition" data-i18n="cookie_btn_rechazar">Rechazar</button>
          <button onclick="aceptarCookies()" class="bg-blue-700 hover:bg-blue-800 text-white text-sm font-semibold px-6 py-2.5 rounded-full transition" data-i18n="cookie_btn_aceptar">Aceptar</button>
        </div>
      </div>
    </div>

    <!-- COOKIE CONFIG MODAL -->
    <div id="cookie-modal" class="fixed inset-0 bg-black/50 z-[101] hidden flex items-end sm:items-center justify-center p-4">
      <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
        <div class="flex items-center justify-between px-6 py-4 border-b border-gray-100">
          <h3 class="font-bold text-gray-800" data-i18n="cookie_config_title">Configurar cookies</h3>
          <button onclick="cerrarConfig()" class="text-gray-400 hover:text-gray-600 text-xl">✕</button>
        </div>
        <div class="p-6 space-y-5">
          <!-- Técnicas (siempre activas) -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold text-gray-800 text-sm" data-i18n="cookie_tecnicas">Cookies técnicas</p>
              <p class="text-xs text-gray-500 mt-1" data-i18n="cookie_tecnicas_desc">Necesarias para el funcionamiento del sitio web. No pueden desactivarse.</p>
            </div>
            <div class="flex-shrink-0">
              <div class="w-12 h-6 bg-blue-600 rounded-full flex items-center justify-end px-1 cursor-not-allowed opacity-70">
                <div class="w-4 h-4 bg-white rounded-full shadow"></div>
              </div>
              <p class="text-xs text-blue-600 text-center mt-1" data-i18n="cookie_siempre">Siempre</p>
            </div>
          </div>
          <div class="border-t border-gray-100"></div>
          <!-- Analíticas -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold text-gray-800 text-sm" data-i18n="cookie_analiticas">Cookies analíticas</p>
              <p class="text-xs text-gray-500 mt-1" data-i18n="cookie_analiticas_desc">Nos permiten analizar el uso del sitio para mejorar la experiencia. Utilizamos datos anónimos.</p>
            </div>
            <div class="flex-shrink-0">
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="chk-analiticas" class="sr-only peer" />
                <div class="w-12 h-6 bg-gray-300 peer-checked:bg-blue-600 rounded-full transition peer-focus:ring-2 peer-focus:ring-blue-300">
                  <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full shadow transition peer-checked:translate-x-6"></div>
                </div>
              </label>
            </div>
          </div>
          <div class="border-t border-gray-100"></div>
          <!-- Preferencias -->
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-semibold text-gray-800 text-sm" data-i18n="cookie_preferencias">Cookies de preferencias</p>
              <p class="text-xs text-gray-500 mt-1" data-i18n="cookie_preferencias_desc">Recuerdan tus preferencias (idioma, sesión, etc.) para personalizar tu experiencia.</p>
            </div>
            <div class="flex-shrink-0">
              <label class="relative inline-flex items-center cursor-pointer">
                <input type="checkbox" id="chk-preferencias" class="sr-only peer" checked />
                <div class="w-12 h-6 bg-gray-300 peer-checked:bg-blue-600 rounded-full transition peer-focus:ring-2 peer-focus:ring-blue-300">
                  <div class="absolute top-1 left-1 w-4 h-4 bg-white rounded-full shadow transition peer-checked:translate-x-6"></div>
                </div>
              </label>
            </div>
          </div>
        </div>
        <div class="px-6 py-4 border-t border-gray-100 flex gap-3 justify-end">
          <button onclick="guardarConfig()" class="bg-blue-700 hover:bg-blue-800 text-white px-6 py-2.5 rounded-full text-sm font-semibold transition" data-i18n="cookie_btn_guardar">Guardar preferencias</button>
          <button onclick="aceptarCookies()" class="bg-gray-100 hover:bg-gray-200 text-gray-700 px-6 py-2.5 rounded-full text-sm font-semibold transition" data-i18n="cookie_btn_aceptar_todas">Aceptar todas</button>
        </div>
      </div>
    </div>

    <!-- CONTENT -->
    <main>
      <slot />
    </main>

    <!-- FOOTER -->
    <footer style="background:linear-gradient(160deg,#0d1b2e 0%,#111827 50%,#0f172a 100%);border-top:1px solid rgba(255,255,255,0.06);" class="text-gray-400 pt-14 pb-6 px-6 mt-0">
      <div class="max-w-6xl mx-auto">

        <!-- Top row -->
        <div class="grid grid-cols-1 md:grid-cols-5 gap-10 pb-10" style="border-bottom:1px solid rgba(255,255,255,0.08);">

          <!-- Brand -->
          <div class="md:col-span-2">
            <div class="text-white font-bold text-2xl mb-4" style="font-family:serif;letter-spacing:-1px;">
              <span class="text-orange-400">la</span><span class="text-white">Soci</span>
            </div>
            <p class="text-sm text-gray-400 leading-relaxed mb-5" data-i18n="footer_desc">Somos la Asociación de todos los trabajadores y trabajadoras de CaixaBank y la Fundación "la Caixa" y sus familias.</p>
            <!-- Redes sociales + Asóciate en misma fila -->
            <div class="flex flex-wrap items-center gap-2">
              <a href="https://www.facebook.com/lasoci.caixa" target="_blank" title="Facebook" class="w-9 h-9 rounded-xl flex items-center justify-center hover:opacity-80 transition" style="background:#1877f2">
                <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              </a>
              <a href="https://x.com/APCAIXA" target="_blank" title="X / Twitter" class="w-9 h-9 rounded-xl flex items-center justify-center hover:opacity-80 transition" style="background:#111;border:1px solid rgba(255,255,255,0.15)">
                <svg width="12" height="12" fill="white" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://www.linkedin.com/company/associaci%C3%B3-del-personal-de-la-caixa-" target="_blank" title="LinkedIn" class="w-9 h-9 rounded-xl flex items-center justify-center hover:opacity-80 transition" style="background:#0077b5">
                <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
              </a>
              <a href="https://www.youtube.com/user/APCaixa" target="_blank" title="YouTube" class="w-9 h-9 rounded-xl flex items-center justify-center hover:opacity-80 transition" style="background:#ff0000">
                <svg width="14" height="14" fill="white" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
              <a href="https://www.instagram.com/la.soci" target="_blank" title="Instagram" class="w-9 h-9 rounded-xl flex items-center justify-center hover:opacity-80 transition" style="background:radial-gradient(circle at 30% 107%, #fdf497 0%, #fd5949 45%, #d6249f 60%, #285AEB 90%)">
