---
import '../styles/global.css';
interface Props {
  title: string;
  lang?: 'es' | 'ca';
}
const { title, lang = 'es' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content="la Soci — Associació del Personal de CaixaBank" />
    <script is:inline>
      (function() {
        var lang = localStorage.getItem('lasoci_lang') || 'es';
        document.documentElement.setAttribute('data-lang', lang);
        document.documentElement.lang = lang;
      })();
    </script>
    <style is:global>
      body { visibility: hidden; }
      body.lang-ready { visibility: visible; }

      /* Orange border by default, green on focus */
      .form-input {
        border-color: #f97316 !important;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
      }
      .form-input:focus {
        border-color: #22c55e !important;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.15) !important;
        outline: none !important;
      }

      /* Nav hover effect */
      .nav-link {
        border: 1px solid transparent !important;
        transition: all 0.2s ease !important;
      }
      .nav-link:hover {
        border-color: #4ade80 !important;
        background-color: rgba(74, 222, 128, 0.15) !important;
        color: white !important;
      }

      /* Lang dropdown styles */
      #lang-dropdown-menu {
        opacity: 0;
        transform: translateY(-8px);
        transition: opacity 0.15s ease, transform 0.15s ease;
        pointer-events: none;
      }
      #lang-dropdown-menu.open {
        opacity: 1;
        transform: translateY(0);
        pointer-events: all;
      }
      .lang-option.active {
        background-color: #f0f4ff;
        font-weight: 600;
      }

      /* Footer column separators */
      .footer-cols { gap: 0; }
      @media (min-width: 768px) {
        .footer-cols > div {
          padding: 0 2.5rem;
        }
        .footer-cols > div:first-child {
          padding-left: 0;
          padding-right: 2.5rem;
        }
        .footer-cols > div:last-child {
          padding-right: 0;
        }
        .footer-cols > div:not(:first-child) {
          border-left: 1px solid rgba(255,255,255,0.07);
        }
      }
      @media (max-width: 767px) {
        .footer-cols > div {
          padding: 1.25rem 0;
          border-bottom: 1px solid rgba(255,255,255,0.07);
        }
        .footer-cols > div:last-child {
          border-bottom: none;
        }
        footer .px-6 {
          padding-left: 1rem;
          padding-right: 1rem;
        }
      }

      /* Footer link hover más visible */
      .footer-link {
        color: #94a3b8;
        transition: color 0.18s ease, padding-left 0.18s ease;
        display: inline-block;
        position: relative;
        text-decoration: none;
      }
      .footer-link::after {
        content: '';
        position: absolute;
        bottom: -1px;
        left: 0;
        width: 0;
        height: 1px;
        background: #f97316;
        transition: width 0.2s ease;
      }
      .footer-link:hover {
        color: #ffffff !important;
        padding-left: 6px;
      }
      .footer-link:hover::after {
        width: 100%;
      }
    </style>
  </head>
  <body class="min-h-screen bg-white font-sans">

    <!-- NAVBAR -->
    <nav style="background:linear-gradient(160deg,#1e2d45 0%,#243350 50%,#1a2840 100%);border-bottom:1px solid rgba(255,255,255,0.1);" class="text-white shadow-2xl sticky top-0 z-50 backdrop-blur-sm">
      <div class="max-w-6xl mx-auto px-5 flex items-center justify-between h-16">

        <!-- Logo -->
        <a href="/" class="flex items-center flex-shrink-0">
          <img src="/logo-lasoci.png.JPG" alt="la Soci" class="h-9 w-auto object-contain" />
        </a>

        <!-- Nav links desktop -->
        <div class="hidden lg:flex items-center gap-0.5 text-sm font-medium flex-1 justify-center">
          <a href="/secciones" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_seccions">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            <span>Secciones</span>
            <span class="nav-underline"></span>
          </a>
          <a href="/agenda" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            <span>Agenda</span>
            <span class="nav-underline"></span>
          </a>
          <a href="/viajes" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_viajes">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
            <span>Viajes</span>
            <span class="nav-underline"></span>
          </a>
          <a href="/ventajas" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_ventajas">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
            <span>Ventajas</span>
            <span class="nav-underline"></span>
          </a>
          <a href="/tienda" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_tienda">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
            <span>Tienda</span>
            <span class="nav-underline"></span>
          </a>
          <a href="/biblioteca" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_biblioteca">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
            <span>Biblioteca</span>
            <span class="nav-underline"></span>
          </a>
          <a href="/videoteca" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_videoteca">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 10.5L19.5 7.5v9l-3.75-3m-12 4.5h9a1.5 1.5 0 001.5-1.5v-7.5a1.5 1.5 0 00-1.5-1.5h-9A1.5 1.5 0 002.25 9v7.5a1.5 1.5 0 001.5 1.5z"/></svg>
            <span>Videoteca</span>
            <span class="nav-underline"></span>
          </a>
          <!-- Quiénes somos dropdown -->
          <div class="relative group">
            <button class="nav-link relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_quienes">
              <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              <span>Quiénes somos</span>
              <svg class="w-3 h-3 opacity-60 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              <span class="nav-underline"></span>
            </button>
            <div class="absolute top-full left-0 pt-2 w-56 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-1 group-hover:translate-y-0 transition-all duration-200 z-50">
              <div class="bg-white rounded-xl shadow-2xl border border-gray-100 py-1.5 overflow-hidden">
                <a href="/quienes-somos" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors" data-i18n="qs_nav_nosotros">
                  <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a4 4 0 00-3-3.87M9 20H4v-2a4 4 0 013-3.87m6-1.13a4 4 0 100-8 4 4 0 000 8zm6 4v-2a4 4 0 00-3-3.87m-9-1.13a4 4 0 110-8 4 4 0 010 8z"/></svg>
                  Nosotros
                </a>
                <a href="/quienes-somos/historia" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors" data-i18n="qs_nav_historia">
                  <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Historia
                </a>
                <a href="/quienes-somos/organizacion" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors" data-i18n="qs_nav_org">
                  <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2M5 21H3m16 0h-2M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5"/></svg>
                  Organización
                </a>
                <a href="/quienes-somos/preguntas" class="flex items-center gap-2.5 px-4 py-2.5 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors" data-i18n="qs_nav_faq">
                  <svg class="w-4 h-4 opacity-60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                  Preguntas frecuentes
                </a>
              </div>
            </div>
          </div>
          <div class="relative group">
            <a href="/noticias" class="nav-link relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_noticies">
              <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2M7 8h6m-6 4h6m-6 4h3"/></svg>
              <span>Noticias</span>
              <svg class="w-3 h-3 opacity-50 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              <span class="nav-underline"></span>
            </a>
            <div class="absolute top-full left-0 pt-2 w-44 opacity-0 invisible group-hover:opacity-100 group-hover:visible translate-y-1 group-hover:translate-y-0 transition-all duration-200 z-50">
              <div class="bg-white rounded-xl shadow-2xl border border-gray-100 py-1.5 overflow-hidden">
                <a href="/noticias" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors">Noticias</a>
                <a href="/noticias/revista" class="block px-4 py-2.5 text-sm text-gray-700 hover:bg-orange-50 hover:text-orange-600 transition-colors" data-i18n="nav_revista">Revista</a>
              </div>
            </div>
          </div>
          <a href="/contacto" class="nav-link group relative flex items-center gap-1.5 text-gray-300 hover:text-white px-3 py-2 rounded-lg transition-colors whitespace-nowrap" data-i18n="nav_contacte">
            <svg class="w-4 h-4 opacity-70 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            <span>Contacto</span>
            <span class="nav-underline"></span>
          </a>
        </div>

        <!-- Right side -->
        <div class="hidden lg:flex items-center gap-2 flex-shrink-0">
          <!-- Selector idioma -->
          <div class="relative" id="lang-dropdown">
            <button id="lang-btn" class="flex items-center gap-1.5 bg-white/10 hover:bg-white/20 px-3 py-2 rounded-lg transition text-sm">
              <img id="lang-flag-img" src="https://flagcdn.com/w40/es.png" class="w-5 h-5 rounded-full object-cover flex-shrink-0" alt="" />
              <span id="lang-label" class="text-xs">Español</span>
              <svg id="lang-chevron" class="w-3 h-3 opacity-60 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>
            <div id="lang-dropdown-menu" class="absolute right-0 mt-2 w-44 bg-white rounded-xl shadow-2xl overflow-hidden z-50 border border-gray-200 py-1">
              <button onclick="setLang('es')" id="lang-opt-es" class="lang-option w-full flex items-center justify-between px-4 py-2.5 text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                <div class="flex items-center gap-2">
                  <img src="https://flagcdn.com/w40/es.png" class="w-6 h-6 rounded-full object-cover" alt="ES" />
                  <span>Español</span>
                </div>
                <svg id="check-es" class="w-4 h-4 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button onclick="setLang('ca')" id="lang-opt-ca" class="lang-option w-full flex items-center justify-between px-4 py-2.5 text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                <div class="flex items-center gap-2">
                  <img src="https://upload.wikimedia.org/wikipedia/commons/thumb/c/ce/Flag_of_Catalonia.svg/40px-Flag_of_Catalonia.svg.png" class="w-6 h-6 rounded-full object-cover" alt="CA" />
                  <span>Català</span>
                </div>
                <svg id="check-ca" class="w-4 h-4 text-blue-600 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
              <button onclick="setLang('en')" id="lang-opt-en" class="lang-option w-full flex items-center justify-between px-4 py-2.5 text-gray-700 hover:bg-gray-50 text-sm transition-colors">
                <div class="flex items-center gap-2">
                  <img src="https://flagcdn.com/w40/gb.png" class="w-6 h-6 rounded-full object-cover" alt="EN" />
                  <span>English</span>
                </div>
                <svg id="check-en" class="w-4 h-4 text-blue-600 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg>
              </button>
            </div>
          </div>

          <!-- Usuario logueado -->
          <div id="nav-user-badge" class="hidden items-center gap-2 bg-white/10 px-3 py-1.5 rounded-xl border border-white/20">
            <div class="w-7 h-7 rounded-full bg-orange-500 flex items-center justify-center text-xs font-bold text-white flex-shrink-0" id="nav-user-avatar">?</div>
            <div class="hidden md:block">
              <p class="text-xs font-semibold text-white leading-none" id="nav-user-name">—</p>
              <p class="text-xs text-white/50 leading-none mt-0.5">Conectado</p>
            </div>
            <a href="/socios/dashboard" class="text-white/70 hover:text-white transition">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
            </a>
          </div>

          <a href="/socios/registro" class="bg-green-500 hover:bg-green-600 text-white px-4 py-2 rounded-lg transition font-semibold text-sm flex items-center gap-1 whitespace-nowrap" data-i18n="nav_asociate">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/></svg>
            +Asóciate
          </a>
          <a href="/socios/login" class="bg-orange-500 hover:bg-orange-600 text-white px-4 py-2 rounded-lg transition font-semibold text-sm whitespace-nowrap" data-i18n="nav_area">Área socios</a>
        </div>

        <!-- Mobile burger -->
        <button id="mobile-menu-btn" class="lg:hidden p-2 rounded-lg hover:bg-white/10 transition">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      </div>

      <!-- Mobile menu -->
      <div id="mobile-menu" class="hidden lg:hidden border-t border-white/10 px-5 py-4 space-y-1">
        <a href="/secciones" class="flex items-center gap-3 text-gray-300 hover:text-white hover:bg-white/10 py-2.5 px-3 rounded-xl text-sm transition" data-i18n="nav_seccions">
          <svg class="w-4.5 h-4.5 opacity-70 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
          Secciones</a>
        <a href="/agenda" class="flex items-center gap-3 text-gray-300 hover:text-white hover:bg-white/10 py-2.5 px-3 rounded-xl text-sm transition">
          <svg class="w-4.5 h-4.5 opacity-70 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
          Agenda</a>
        <a href="/viajes" class="flex items-center gap-3 text-gray-300 hover:text-white hover:bg-white/10 py-2.5 px-3 rounded-xl text-sm transition" data-i18n="nav_viajes">
          <svg class="w-4.5 h-4.5 opacity-70 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
