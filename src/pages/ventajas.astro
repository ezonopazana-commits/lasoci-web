---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Ventajas — la Soci">
  <div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-16 px-6 text-center">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">la Soci</p>
    <h1 class="text-4xl font-bold mb-4" data-i18n="vent_title">Ventajas</h1>
    <p class="text-blue-200 max-w-xl mx-auto" data-i18n="vent_sub">Descuentos y ventajas exclusivas para asociados y sus familias</p>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Categorías -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">💊</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vent_salud">Salud y Belleza</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">👨‍👩‍👧</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vent_familia">La persona y la familia</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🎉</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vent_ocio">Tiempo libre</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🤝</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vent_social">Sociales</h3>
      </div>
    </div>

    <!-- Ventajas destacadas -->
    <h2 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="vent_destacadas">Ventajas destacadas</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {[
        { img: 'https://documents.lasoci.org/oferimentsImg/apple_foto.jpg', dto: 'Hasta 10% dto.', nombre: 'Apple', desc: 'Ventajas exclusivas de Apple a precio preferencial.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/portaventura.jpg', dto: 'Hasta 50% dto.', nombre: 'Port Aventura', desc: '40 atracciones, espectáculos y restaurantes.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/paradores_foto.jpg', dto: '15% dto.', nombre: 'Paradores', desc: 'Escapadas con encanto. Descuento exclusivo.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/europcar.jpg', dto: '10% dto.', nombre: 'Europcar', desc: 'Alquiler de coches nacional e internacional.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/fnac_foto.jpg', dto: 'Hasta 27% dto.', nombre: 'Fnac', desc: 'Electrónica, libros, música y fotografía.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/SEAT_1.jpg', dto: 'Hasta 22% dto.', nombre: 'SEAT/Cupra', desc: 'Descuentos en vehículos SEAT y CUPRA.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/grimaldi_foto.jpg', dto: 'Hasta 20% dto.', nombre: 'Grimaldi Lines', desc: 'Viajes en barco a Cerdeña, Italia y Baleares.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/hotelius_1.jpg', dto: '15% dto.', nombre: 'Hotelius Club', desc: 'Más de 50.000 hoteles con 15% de descuento.' },
        { img: 'https://documents.lasoci.org/oferimentsImg/Parques-Reunidos-Foto_3.jpg', dto: 'Hasta 46% dto.', nombre: 'Parques Reunidos', desc: 'Parque Warner, Zoo Aquarium Madrid y más.' },
      ].map(v => (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
          <div class="relative">
            <img src={v.img} alt={v.nombre} class="w-full h-36 object-cover" />
            <span class="absolute top-2 left-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-lg">{v.dto}</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-800 mb-1">{v.nombre}</h3>
            <p class="text-gray-500 text-xs">{v.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
      <p class="text-amber-800 text-sm mb-4" data-i18n="vent_login_info">Inicia sesión con tu usuario para acceder a todas las ventajas y ver los detalles de cada oferta.</p>
      <a href="/socios/login" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-xl transition inline-block" data-i18n="vent_btn">Acceder a todas las ventajas</a>
    </div>
  </div>

  <script>
    const T = {
      es: { vent_title:'Ventajas', vent_sub:'Descuentos y ventajas exclusivas para asociados y sus familias', vent_salud:'Salud y Belleza', vent_familia:'La persona y la familia', vent_ocio:'Tiempo libre', vent_social:'Sociales', vent_destacadas:'Ventajas destacadas', vent_login_info:'Inicia sesión con tu usuario para acceder a todas las ventajas y ver los detalles de cada oferta.', vent_btn:'Acceder a todas las ventajas' },
      ca: { vent_title:'Avantatges', vent_sub:"Descomptes i avantatges exclusius per a associats i les seves famílies", vent_salud:'Salut i Bellesa', vent_familia:'La persona i la família', vent_ocio:'Temps lliure', vent_social:'Socials', vent_destacadas:'Avantatges destacats', vent_login_info:"Inicia sessió amb el teu usuari per accedir a tots els avantatges i veure els detalls de cada oferta.", vent_btn:'Accedir a tots els avantatges' },
      en: { vent_title:'Benefits', vent_sub:'Exclusive discounts and benefits for members and their families', vent_salud:'Health & Beauty', vent_familia:'Person & Family', vent_ocio:'Leisure', vent_social:'Social', vent_destacadas:'Featured benefits', vent_login_info:'Sign in to access all benefits and see the details of each offer.', vent_btn:'Access all benefits' }
    };
    function applyLang(lang) { const t=T[lang]||T.es; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.getAttribute('data-i18n'); if(t[k]) el.textContent=t[k]; }); }
    applyLang(localStorage.getItem('lasoci_lang')||'es');
    window.addEventListener('langchange', e => applyLang(e.detail.lang));
  </script>
</Layout>
