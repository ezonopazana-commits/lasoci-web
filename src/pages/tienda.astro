---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tienda — la Soci">
  <div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-4 px-6 text-center">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">la Soci</p>
    <h1 class="text-2xl font-bold mb-4" data-i18n="tnd_title">Tienda deportiva</h1>
    <p class="text-blue-200 max-w-xl mx-auto" data-i18n="tnd_sub">Descuentos en pádel, fútbol y ciclismo con las principales marcas españolas</p>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Categorías -->
    <div class="grid grid-cols-3 gap-4 mb-12">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="tnd_padel">Pádel</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.2l3.6 2.6-1.4 4.3H9.8l-1.4-4.3L12 7.2zM12 3v4.2M3.4 9.5l4.9.2M19.6 9.5l-4.9.2M6.6 19l2.6-4.9M17.4 19l-2.6-4.9"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="tnd_futbol">Fútbol</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><circle cx="5.5" cy="17.5" r="3.2"/><circle cx="18.5" cy="17.5" r="3.2"/><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 17.5L10 8h4l1.5 3M10 8L8 5h3m4.5 12.5L15 11l3.5 6.5"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="tnd_ciclismo">Ciclismo</h3>
      </div>
    </div>

    <!-- Marcas destacadas -->
    <h2 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="tnd_destacadas">Marcas con convenio</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-14">
      {[
        { icon: 'padel', dto: 'Próximamente', nombre: 'Pádel Nuestro', desc: 'Principal distribuidor de pádel de España: palas, ropa y zapatillas de Bullpadel, Head, Babolat y más.' },
        { icon: 'padel', dto: 'Próximamente', nombre: 'Bullpadel · NOX · StarVie', desc: 'Las marcas españolas de referencia en pádel.' },
        { icon: 'futbol', dto: 'Próximamente', nombre: 'Joma', desc: 'Marca española con más de 50 años, proveedor técnico de clubes de LaLiga. Equipaciones de fútbol.' },
        { icon: 'bici', dto: 'Próximamente', nombre: 'Orbea', desc: 'El mayor fabricante español de bicicletas, con sede en el País Vasco.' },
        { icon: 'bici', dto: 'Próximamente', nombre: 'BH Bikes', desc: 'Marca histórica española de bicicletas de carretera, montaña y eléctricas.' },
        { icon: 'ropa', dto: 'Próximamente', nombre: 'Valento', desc: 'Ropa deportiva multideporte al por mayor, sin pedido mínimo.' },
      ].map(v => (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
          <div class="relative bg-gradient-to-br from-blue-50 to-orange-50 h-28 flex items-center justify-center">
            {v.icon === 'padel' && <svg class="w-12 h-12 text-blue-900/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/></svg>}
            {v.icon === 'futbol' && <svg class="w-12 h-12 text-blue-900/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.2l3.6 2.6-1.4 4.3H9.8l-1.4-4.3L12 7.2zM12 3v4.2M3.4 9.5l4.9.2M19.6 9.5l-4.9.2M6.6 19l2.6-4.9M17.4 19l-2.6-4.9"/></svg>}
            {v.icon === 'bici' && <svg class="w-12 h-12 text-blue-900/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><circle cx="5.5" cy="17.5" r="3.2"/><circle cx="18.5" cy="17.5" r="3.2"/><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 17.5L10 8h4l1.5 3M10 8L8 5h3m4.5 12.5L15 11l3.5 6.5"/></svg>}
            {v.icon === 'ropa' && <svg class="w-12 h-12 text-blue-900/70" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><path stroke-linecap="round" stroke-linejoin="round" d="M8 4l4 2 4-2 4 4-3 3v9H7v-9L4 8l4-4z"/></svg>}
            <span class="absolute top-2 left-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-lg">{v.dto}</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-800 mb-1">{v.nombre}</h3>
            <p class="text-gray-500 text-xs">{v.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- DEMO interactiva -->
    <div class="rounded-2xl border-2 border-dashed border-blue-200 bg-blue-50/40 p-6 mb-12">
      <div class="flex items-center gap-2 mb-1">
        <span class="bg-blue-600 text-white text-[10px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full" data-i18n="tnd_demo_badge">Demo</span>
        <h2 class="text-xl font-bold text-gray-800" data-i18n="tnd_demo_titulo">Así se verá la tienda</h2>
      </div>
      <p class="text-gray-500 text-sm mb-6" data-i18n="tnd_demo_sub">Productos y precios de ejemplo — prueba a añadir cosas al carrito.</p>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 mb-6" id="demo-productos">
        {[
          { id: 'p1', icon: 'padel', nombre: 'Pala de pádel Pro', precioOrig: 159, precioSoci: 135 },
          { id: 'p2', icon: 'futbol', nombre: 'Camiseta equipación', precioOrig: 45, precioSoci: 36 },
          { id: 'p3', icon: 'bici', nombre: 'Bicicleta urbana', precioOrig: 890, precioSoci: 712 },
        ].map(p => (
          <div class="bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden">
            <div class="h-24 bg-gradient-to-br from-blue-100 to-orange-100 flex items-center justify-center">
              {p.icon === 'padel' && <svg class="w-10 h-10 text-blue-900/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="3.2"/></svg>}
              {p.icon === 'futbol' && <svg class="w-10 h-10 text-blue-900/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><circle cx="12" cy="12" r="9"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 7.2l3.6 2.6-1.4 4.3H9.8l-1.4-4.3L12 7.2zM12 3v4.2M3.4 9.5l4.9.2M19.6 9.5l-4.9.2M6.6 19l2.6-4.9M17.4 19l-2.6-4.9"/></svg>}
              {p.icon === 'bici' && <svg class="w-10 h-10 text-blue-900/60" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.4"><circle cx="5.5" cy="17.5" r="3.2"/><circle cx="18.5" cy="17.5" r="3.2"/><path stroke-linecap="round" stroke-linejoin="round" d="M5.5 17.5L10 8h4l1.5 3M10 8L8 5h3m4.5 12.5L15 11l3.5 6.5"/></svg>}
            </div>
            <div class="p-3.5">
              <h4 class="font-semibold text-gray-800 text-sm mb-1">{p.nombre}</h4>
              <p class="text-xs text-gray-400 line-through">{p.precioOrig} €</p>
              <p class="text-base font-bold text-orange-600 mb-2">{p.precioSoci} € <span class="text-[10px] font-medium text-green-600 align-middle">socio</span></p>
              <button class="demo-add-btn w-full bg-blue-900 hover:bg-blue-800 text-white text-xs font-semibold py-2 rounded-lg transition" data-nombre={p.nombre} data-precio={p.precioSoci} data-i18n="tnd_demo_add">Añadir al carrito</button>
            </div>
          </div>
        ))}
      </div>

      <div class="bg-white rounded-xl border border-gray-100 p-4 flex items-center justify-between">
        <div class="flex items-center gap-2 text-sm text-gray-600">
          <svg class="w-5 h-5 text-blue-900" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
          <span id="demo-carrito-count" data-i18n="tnd_demo_vacio">Carrito vacío</span>
        </div>
        <span id="demo-carrito-total" class="font-bold text-gray-800"></span>
      </div>
      <p class="text-[11px] text-gray-400 mt-3 text-center" data-i18n="tnd_demo_nota">Esto es una simulación: ni los productos ni los precios son reales todavía.</p>
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
      <p class="text-amber-800 text-sm mb-4" data-i18n="tnd_login_info">Estamos cerrando los acuerdos con estas marcas. Inicia sesión para que te avisemos en cuanto estén disponibles los descuentos.</p>
      <a href="/socios/login" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-xl transition inline-block" data-i18n="tnd_btn">Avísame cuando esté disponible</a>
    </div>
  </div>

  <script>
    const T = {
      es: { tnd_title:'Tienda deportiva', tnd_sub:'Descuentos en pádel, fútbol y ciclismo con las principales marcas españolas', tnd_padel:'Pádel', tnd_futbol:'Fútbol', tnd_ciclismo:'Ciclismo', tnd_destacadas:'Marcas con convenio', tnd_demo_badge:'Demo', tnd_demo_titulo:'Así se verá la tienda', tnd_demo_sub:'Productos y precios de ejemplo — prueba a añadir cosas al carrito.', tnd_demo_add:'Añadir al carrito', tnd_demo_vacio:'Carrito vacío', tnd_demo_nota:'Esto es una simulación: ni los productos ni los precios son reales todavía.', tnd_login_info:'Estamos cerrando los acuerdos con estas marcas. Inicia sesión para que te avisemos en cuanto estén disponibles los descuentos.', tnd_btn:'Avísame cuando esté disponible' },
      ca: { tnd_title:'Botiga esportiva', tnd_sub:'Descomptes en pàdel, futbol i ciclisme amb les principals marques espanyoles', tnd_padel:'Pàdel', tnd_futbol:'Futbol', tnd_ciclismo:'Ciclisme', tnd_destacadas:'Marques amb conveni', tnd_demo_badge:'Demo', tnd_demo_titulo:'Així es veurà la botiga', tnd_demo_sub:'Productes i preus d\u2019exemple — prova a afegir coses al carret.', tnd_demo_add:'Afegir al carret', tnd_demo_vacio:'Carret buit', tnd_demo_nota:'Això és una simulació: ni els productes ni els preus s\u00f3n reals encara.', tnd_login_info:'Estem tancant els acords amb aquestes marques. Inicia sessi\u00f3 perqu\u00e8 t\u2019avisem quan estiguin disponibles els descomptes.', tnd_btn:'Avisa\u2019m quan estigui disponible' },
      en: { tnd_title:'Sports Shop', tnd_sub:'Discounts on padel, football and cycling gear from leading Spanish brands', tnd_padel:'Padel', tnd_futbol:'Football', tnd_ciclismo:'Cycling', tnd_destacadas:'Partner brands', tnd_demo_badge:'Demo', tnd_demo_titulo:'A preview of the shop', tnd_demo_sub:'Sample products and prices — try adding items to the cart.', tnd_demo_add:'Add to cart', tnd_demo_vacio:'Cart is empty', tnd_demo_nota:'This is a simulation: products and prices are not real yet.', tnd_login_info:'We are finalizing agreements with these brands. Sign in so we can notify you once discounts are available.', tnd_btn:'Notify me when available' }
    };
    function applyLang(lang) { const t=T[lang]||T.es; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.getAttribute('data-i18n'); if(t[k]) el.textContent=t[k]; }); }
    applyLang(localStorage.getItem('lasoci_lang')||'es');
    window.addEventListener('langchange', e => applyLang(e.detail.lang));

    // Demo carrito (solo simulación visual, no persiste ni hay pago real)
    let carrito = [];
    document.querySelectorAll('.demo-add-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        carrito.push({ nombre: btn.dataset.nombre, precio: parseFloat(btn.dataset.precio) });
        const lang = localStorage.getItem('lasoci_lang') || 'es';
        const countEl = document.getElementById('demo-carrito-count');
        const totalEl = document.getElementById('demo-carrito-total');
        const total = carrito.reduce((s, i) => s + i.precio, 0);
        const labels = { es: n => `${n} artículo${n!==1?'s':''} en el carrito`, ca: n => `${n} article${n!==1?'s':''} al carret`, en: n => `${n} item${n!==1?'s':''} in cart` };
        countEl.textContent = labels[lang](carrito.length);
        totalEl.textContent = total.toFixed(2) + ' €';
        btn.textContent = '✓';
        setTimeout(() => { btn.textContent = (T[lang]||T.es).tnd_demo_add; }, 700);
      });
    });
  </script>
</Layout>
