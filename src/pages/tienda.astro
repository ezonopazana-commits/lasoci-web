---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Tienda — la Soci">
  <div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-4 px-6 text-center">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">la Soci</p>
    <h1 class="text-2xl font-bold mb-4" data-i18n="tnd_title">Tienda deportiva</h1>
    <p class="text-blue-200 max-w-xl mx-auto" data-i18n="tnd_sub">Descuentos en pádel, fútbol y ciclismo con las principales marcas españolas</p>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Categorías -->
    <div class="grid grid-cols-3 gap-4 mb-12">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🎾</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="tnd_padel">Pádel</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">⚽</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="tnd_futbol">Fútbol</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🚴</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="tnd_ciclismo">Ciclismo</h3>
      </div>
    </div>

    <!-- Marcas destacadas -->
    <h2 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="tnd_destacadas">Marcas con convenio</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {[
        { logo: '🎾', dto: 'Próximamente', nombre: 'Pádel Nuestro', desc: 'Principal distribuidor de pádel de España: palas, ropa y zapatillas de Bullpadel, Head, Babolat y más.' },
        { logo: '🎾', dto: 'Próximamente', nombre: 'Bullpadel · NOX · StarVie', desc: 'Las marcas españolas de referencia en pádel.' },
        { logo: '⚽', dto: 'Próximamente', nombre: 'Joma', desc: 'Marca española con más de 50 años, proveedor técnico de clubes de LaLiga. Equipaciones de fútbol.' },
        { logo: '🚴', dto: 'Próximamente', nombre: 'Orbea', desc: 'El mayor fabricante español de bicicletas, con sede en el País Vasco.' },
        { logo: '🚴', dto: 'Próximamente', nombre: 'BH Bikes', desc: 'Marca histórica española de bicicletas de carretera, montaña y eléctricas.' },
        { logo: '👕', dto: 'Próximamente', nombre: 'Valento', desc: 'Ropa deportiva multideporte al por mayor, sin pedido mínimo.' },
      ].map(v => (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
          <div class="relative bg-gray-50 h-28 flex items-center justify-center">
            <span class="text-5xl">{v.logo}</span>
            <span class="absolute top-2 left-2 bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-lg">{v.dto}</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-800 mb-1">{v.nombre}</h3>
            <p class="text-gray-500 text-xs">{v.desc}</p>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
      <p class="text-amber-800 text-sm mb-4" data-i18n="tnd_login_info">Estamos cerrando los acuerdos con estas marcas. Inicia sesión para que te avisemos en cuanto estén disponibles los descuentos.</p>
      <a href="/socios/login" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-xl transition inline-block" data-i18n="tnd_btn">Avísame cuando esté disponible</a>
    </div>
  </div>

  <script>
    const T = {
      es: { tnd_title:'Tienda deportiva', tnd_sub:'Descuentos en pádel, fútbol y ciclismo con las principales marcas españolas', tnd_padel:'Pádel', tnd_futbol:'Fútbol', tnd_ciclismo:'Ciclismo', tnd_destacadas:'Marcas con convenio', tnd_login_info:'Estamos cerrando los acuerdos con estas marcas. Inicia sesión para que te avisemos en cuanto estén disponibles los descuentos.', tnd_btn:'Avísame cuando esté disponible' },
      ca: { tnd_title:'Botiga esportiva', tnd_sub:'Descomptes en pàdel, futbol i ciclisme amb les principals marques espanyoles', tnd_padel:'Pàdel', tnd_futbol:'Futbol', tnd_ciclismo:'Ciclisme', tnd_destacadas:'Marques amb conveni', tnd_login_info:'Estem tancant els acords amb aquestes marques. Inicia sessió perquè t\u2019avisem quan estiguin disponibles els descomptes.', tnd_btn:'Avisa\u2019m quan estigui disponible' },
      en: { tnd_title:'Sports Shop', tnd_sub:'Discounts on padel, football and cycling gear from leading Spanish brands', tnd_padel:'Padel', tnd_futbol:'Football', tnd_ciclismo:'Cycling', tnd_destacadas:'Partner brands', tnd_login_info:'We are finalizing agreements with these brands. Sign in so we can notify you once discounts are available.', tnd_btn:'Notify me when available' }
    };
    function applyLang(lang) { const t=T[lang]||T.es; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.getAttribute('data-i18n'); if(t[k]) el.textContent=t[k]; }); }
    applyLang(localStorage.getItem('lasoci_lang')||'es');
    window.addEventListener('langchange', e => applyLang(e.detail.lang));
  </script>
</Layout>
