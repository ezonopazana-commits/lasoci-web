---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Noticias — la Soci">

<div class="bg-gradient-to-br from-blue-900 via-blue-800 to-blue-900 text-white py-4 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">NOTICIAS</p>
    <h1 class="text-4xl font-bold mb-3">Últimas noticias</h1>
    <p class="text-blue-200 text-lg">Mantente al día con todo lo que ocurre en la Soci</p>
  </div>
</div>

<div class="max-w-5xl mx-auto px-6 py-10">

  <!-- Filtros -->
  <div class="flex flex-wrap gap-2 mb-8" id="filtros">
    <button onclick="filtrar('todos')" class="filtro-btn activo px-4 py-1.5 rounded-full text-sm font-medium border-2 border-orange-400 text-orange-600 bg-orange-50">Todos</button>
    <button onclick="filtrar('Deporte')" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border border-gray-200 text-gray-600 hover:border-orange-300 hover:text-orange-500 transition">🏃 Deporte</button>
    <button onclick="filtrar('Cultura')" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border border-gray-200 text-gray-600 hover:border-orange-300 hover:text-orange-500 transition">🎭 Cultura</button>
    <button onclick="filtrar('Asociación')" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border border-gray-200 text-gray-600 hover:border-orange-300 hover:text-orange-500 transition">🤝 Asociación</button>
    <button onclick="filtrar('Voluntariado')" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border border-gray-200 text-gray-600 hover:border-orange-300 hover:text-orange-500 transition">💚 Voluntariado</button>
    <button onclick="filtrar('Gastronomía')" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border border-gray-200 text-gray-600 hover:border-orange-300 hover:text-orange-500 transition">🍳 Gastronomía</button>
  </div>

  <!-- Grid de noticias -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="noticias-grid">

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Deporte">
      <a href="https://www.lasoci.org/es/clinic-de-pickleball-en-sevilla/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/06/pickleball-sevilla-600x400.jpg" alt="Clínic de Pickleball en Sevilla" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-orange-500 uppercase tracking-wide">Deporte</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Clínic de Pickleball en Sevilla</h2>
          <p class="text-sm text-gray-500 mb-3">El sábado 16 de mayo tuvo lugar un clínic de pickleball a cargo de Pickleball Sevilla…</p>
          <p class="text-xs text-gray-400">3 junio, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Cultura">
      <a href="https://www.lasoci.org/es/gent-amb-experiencia-samarcanda-y-la-ruta-de-la-seda/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/05/samarcanda1-600x400.jpg" alt="Samarcanda y la ruta de la seda" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-purple-500 uppercase tracking-wide">Cultura</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Gent amb Experiència: Samarcanda y la ruta de la seda</h2>
          <p class="text-sm text-gray-500 mb-3">En mayo, 33 personas de la sección Gent amb Experiència visitaron Samarcanda…</p>
          <p class="text-xs text-gray-400">27 mayo, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Cultura Gastronomía">
      <a href="https://www.lasoci.org/es/gastronomia-bilbao-participa-en-un-taller-de-cocina-peruana/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/05/IMG_3992-1-600x400.jpg" alt="Taller cocina peruana Bilbao" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-purple-500 uppercase tracking-wide">Gastronomía</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Gastronomía Bilbao participa en un taller de cocina peruana</h2>
          <p class="text-sm text-gray-500 mb-3">El restaurante Rocoto acogió un exitoso taller de cocina peruana en Bilbao…</p>
          <p class="text-xs text-gray-400">21 mayo, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Asociación">
      <a href="https://www.lasoci.org/es/encuentro-lasoci-triatlon-menorca-2026/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/05/triatlo-associacio-600x400.jpg" alt="Triatlón Menorca" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-blue-500 uppercase tracking-wide">Asociación</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Apúntate al Encuentro Associació de Triatlón en Menorca</h2>
          <p class="text-sm text-gray-500 mb-3">El 27 de septiembre, participa con triatletas de la Soci en Artiem Half Menorca…</p>
          <p class="text-xs text-gray-400">15 mayo, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Asociación">
      <a href="https://www.lasoci.org/es/apertura-del-plazo-de-presentacion-de-voluntarios-para-formar-parte-de-la-comision-electoral/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2022/05/comissio-electoral-600x400.png" alt="Comisión Electoral" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-blue-500 uppercase tracking-wide">Asociación</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Apertura del plazo para la Comisión Electoral</h2>
          <p class="text-sm text-gray-500 mb-3">Constitución de la Comisión Electoral para la renovación de la Junta Rectora…</p>
          <p class="text-xs text-gray-400">13 mayo, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Deporte">
      <a href="https://www.lasoci.org/es/x-copa-associacio-de-padel-en-figueres/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/04/x-copa-de-padel_tallada-600x400.jpg" alt="Copa Pádel Figueres" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-orange-500 uppercase tracking-wide">Deporte</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">X Copa Associació de Pádel en Figueres</h2>
          <p class="text-sm text-gray-500 mb-3">Se disputó la X Copa Associació de Pádel reuniendo a participantes de toda la red…</p>
          <p class="text-xs text-gray-400">29 abril, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Deporte">
      <a href="https://www.lasoci.org/es/multiaventura-sevilla-se-estrena-haciendo-escalada-en-rocodromo/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/04/MultiAventuraSevilla2-600x400.jpg" alt="Multiaventura Sevilla" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-orange-500 uppercase tracking-wide">Deporte</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Multiaventura Sevilla se estrena haciendo escalada en rocódromo</h2>
          <p class="text-sm text-gray-500 mb-3">Primera actividad de la sección en el Rock and Wall Climbing de Sevilla…</p>
          <p class="text-xs text-gray-400">21 abril, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Cultura">
      <a href="https://www.lasoci.org/es/visita-al-institut-cartografic-i-geologic-de-catalunya/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/04/grup-visita-institut-cartografic-600x400.jpg" alt="Institut Cartogràfic" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-purple-500 uppercase tracking-wide">Cultura</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">Visita al Institut Cartogràfic i Geològic de Catalunya</h2>
          <p class="text-sm text-gray-500 mb-3">La sección Història Barcelona clausuró su ciclo sobre Cartografía con esta visita…</p>
          <p class="text-xs text-gray-400">13 abril, 2026</p>
        </div>
      </a>
    </article>

    <article class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition group" data-cat="Voluntariado">
      <a href="https://www.lasoci.org/es/2-sin-3-un-primer-paso-sobre-el-escenario-en-un-concierto-solidario/" target="_blank">
        <img src="https://www.lasoci.org/wp-content/uploads/2026/04/2-SIN-3-en-San-Martin-1-600x400.jpg" alt="2 sin 3 concierto solidario" class="w-full h-48 object-cover group-hover:scale-105 transition duration-300" />
        <div class="p-5">
          <span class="text-xs font-semibold text-green-500 uppercase tracking-wide">Voluntariado</span>
          <h2 class="text-base font-bold text-gray-800 mt-1 mb-2 leading-snug">"2 sin 3": un primer paso sobre el escenario en un concierto solidario</h2>
          <p class="text-sm text-gray-500 mb-3">Un emotivo concierto solidario con la participación de socios voluntarios…</p>
          <p class="text-xs text-gray-400">Abril, 2026</p>
        </div>
      </a>
    </article>

  </div>

  <!-- Ver más -->
  <div class="text-center mt-10">
    <a href="https://www.lasoci.org/es/noticias/" target="_blank" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-600 text-white font-semibold px-6 py-3 rounded-xl transition">
      Ver todas las noticias
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
    </a>
  </div>

</div>

<script>
  window.filtrar = function(cat) {
    const articles = document.querySelectorAll('#noticias-grid article');
    articles.forEach(a => {
      if (cat === 'todos' || a.dataset.cat?.includes(cat)) {
        a.style.display = '';
      } else {
        a.style.display = 'none';
      }
    });
    document.querySelectorAll('.filtro-btn').forEach(b => {
      b.classList.remove('activo', 'border-orange-400', 'text-orange-600', 'bg-orange-50');
      b.classList.add('border-gray-200', 'text-gray-600');
    });
    const active = [...document.querySelectorAll('.filtro-btn')].find(b => b.textContent.includes(cat === 'todos' ? 'Todos' : cat));
    if (active) {
      active.classList.add('activo', 'border-2', 'border-orange-400', 'text-orange-600', 'bg-orange-50');
      active.classList.remove('border-gray-200', 'text-gray-600');
    }
  };
</script>

</Layout>
