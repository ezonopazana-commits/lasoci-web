---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seguimiento de contacto — la Soci">

<div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-12 px-6">
  <div class="max-w-2xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">Contacto</p>
    <h1 class="text-3xl font-bold mb-2">Consulta tu mensaje</h1>
    <p class="text-blue-200 text-sm">Introduce el ID de seguimiento que recibiste al enviar tu mensaje.</p>
  </div>
</div>

<div class="max-w-2xl mx-auto px-4 py-10">

  <!-- Buscador -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
    <label class="block text-sm font-medium text-gray-700 mb-2">ID de seguimiento</label>
    <div class="flex gap-3">
      <input id="f-id" type="text" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx"
        class="flex-1 border border-gray-300 rounded-xl px-4 py-2.5 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <button id="btn-buscar" class="bg-blue-900 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-blue-800 transition">
        Consultar
      </button>
    </div>
    <div id="buscar-error" class="hidden mt-3 text-sm text-red-600"></div>
  </div>

  <!-- Resultado -->
  <div id="resultado" class="hidden space-y-4">

    <!-- Datos del mensaje -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <div class="flex items-center justify-between mb-4">
        <h2 class="font-bold text-gray-900">Tu mensaje</h2>
        <span id="r-estado" class="text-xs font-bold px-3 py-1 rounded-full"></span>
      </div>
      <div class="grid grid-cols-2 gap-3 text-sm mb-4">
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Nombre</p>
          <p id="r-nombre" class="font-medium text-gray-900"></p>
        </div>
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Asunto</p>
          <p id="r-asunto" class="text-gray-700"></p>
        </div>
        <div>
          <p class="text-xs text-gray-400 mb-0.5">Fecha envío</p>
          <p id="r-fecha" class="text-gray-500 text-xs"></p>
        </div>
      </div>
      <div>
        <p class="text-xs text-gray-400 mb-2">Mensaje enviado</p>
        <div id="r-mensaje" class="bg-gray-50 rounded-xl p-4 text-sm text-gray-700 leading-relaxed whitespace-pre-wrap"></div>
      </div>
    </div>

    <!-- Respuesta del admin -->
    <div id="bloque-respuesta" class="hidden bg-white rounded-2xl border border-green-200 shadow-sm p-6">
      <div class="flex items-center gap-2 mb-4">
        <span class="text-green-600 text-lg">✅</span>
        <h2 class="font-bold text-gray-900">Respuesta de la Soci</h2>
      </div>
      <div id="r-respuesta" class="bg-green-50 rounded-xl p-4 text-sm text-gray-700 leading-relaxed whitespace-pre-wrap"></div>
      <p id="r-respondido-at" class="text-xs text-gray-400 mt-2"></p>
    </div>

    <!-- Sin respuesta -->
    <div id="bloque-pendiente" class="hidden bg-white rounded-2xl border border-yellow-200 shadow-sm p-6">
      <div class="flex items-center gap-3">
        <span class="text-yellow-500 text-2xl">⏳</span>
        <div>
          <p class="font-semibold text-gray-900">Mensaje recibido</p>
          <p class="text-sm text-gray-500">Tu mensaje está siendo revisado. Te responderemos en menos de 48 horas.</p>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const ASUNTOS = {
    informacion: 'Información general', socio: 'Hacerse socio',
    seccion: 'Secciones', evento: 'Eventos',
    sugerencia: 'Sugerencia o queja', otro: 'Otro'
  };

  // Leer ID de la URL si viene como parámetro
  const params = new URLSearchParams(window.location.search);
  const idParam = params.get('id');
  if (idParam) {
    document.getElementById('f-id').value = idParam;
    buscar();
  }

  document.getElementById('btn-buscar').addEventListener('click', buscar);
  document.getElementById('f-id').addEventListener('keydown', e => { if (e.key === 'Enter') buscar(); });

  async function buscar() {
    const id = document.getElementById('f-id').value.trim();
    const errEl = document.getElementById('buscar-error');
    errEl.classList.add('hidden');
    document.getElementById('resultado').classList.add('hidden');

    if (!id) { errEl.textContent = 'Introduce el ID de seguimiento.'; errEl.classList.remove('hidden'); return; }

    const btn = document.getElementById('btn-buscar');
    btn.textContent = 'Buscando...'; btn.disabled = true;

    const { data: m, error } = await supabase
      .from('contactos')
      .select('id, nombre, apellidos, asunto, mensaje, created_at, respuesta, respondido_at')
      .eq('id', id)
      .single();

    btn.textContent = 'Consultar'; btn.disabled = false;

    if (error || !m) {
      errEl.textContent = 'No se encontró ningún mensaje con ese ID. Comprueba que lo has introducido correctamente.';
      errEl.classList.remove('hidden');
      return;
    }

    // Rellenar datos
    document.getElementById('r-nombre').textContent = `${m.nombre} ${m.apellidos || ''}`;
    document.getElementById('r-asunto').textContent  = ASUNTOS[m.asunto] || m.asunto || '—';
    document.getElementById('r-fecha').textContent   = new Date(m.created_at).toLocaleString('es-ES');
    document.getElementById('r-mensaje').textContent = m.mensaje;

    const estadoEl = document.getElementById('r-estado');
    if (m.respuesta) {
      estadoEl.textContent = 'Respondido';
      estadoEl.className = 'text-xs font-bold px-3 py-1 rounded-full bg-green-100 text-green-700';
      document.getElementById('r-respuesta').textContent = m.respuesta;
      document.getElementById('r-respondido-at').textContent = m.respondido_at
        ? `Respondido el ${new Date(m.respondido_at).toLocaleString('es-ES')}`
        : '';
      document.getElementById('bloque-respuesta').classList.remove('hidden');
      document.getElementById('bloque-pendiente').classList.add('hidden');
    } else {
      estadoEl.textContent = 'Pendiente';
      estadoEl.className = 'text-xs font-bold px-3 py-1 rounded-full bg-yellow-100 text-yellow-700';
      document.getElementById('bloque-respuesta').classList.add('hidden');
      document.getElementById('bloque-pendiente').classList.remove('hidden');
    }

    document.getElementById('resultado').classList.remove('hidden');
  }
</script>

</Layout>
