---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Seguimiento de contacto — la Soci">

<div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-12 px-6">
  <div class="max-w-2xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">Contacto</p>
    <h1 class="text-3xl font-bold mb-2">Consulta tus mensajes</h1>
    <p class="text-blue-200 text-sm">Introduce tu email para ver todos tus mensajes y las respuestas del equipo.</p>
  </div>
</div>

<div class="max-w-2xl mx-auto px-4 py-10">

  <!-- Buscador por email -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 mb-6">
    <label class="block text-sm font-medium text-gray-700 mb-2">Tu dirección de email</label>
    <div class="flex gap-3">
      <input id="f-email" type="email" placeholder="tu@email.com"
        class="flex-1 border border-gray-300 rounded-xl px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <button id="btn-buscar" class="bg-blue-900 text-white px-5 py-2.5 rounded-xl text-sm font-semibold hover:bg-blue-800 transition">
        Consultar
      </button>
    </div>
    <div id="buscar-error" class="hidden mt-3 text-sm text-red-600"></div>
  </div>

  <!-- Lista de mensajes -->
  <div id="resultado" class="hidden space-y-4">
    <p id="resultado-titulo" class="text-sm text-gray-500 mb-2"></p>
    <div id="lista-mensajes" class="space-y-4"></div>
  </div>

</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const ASUNTOS = {
    informacion: 'Información general', socio: 'Hacerse socio',
    seccion: 'Secciones', evento: 'Eventos',
    sugerencia: 'Sugerencia o queja', otro: 'Otro'
  };

  document.getElementById('btn-buscar').addEventListener('click', buscar);
  document.getElementById('f-email').addEventListener('keydown', e => { if (e.key === 'Enter') buscar(); });

  async function buscar() {
    const email = document.getElementById('f-email').value.trim().toLowerCase();
    const errEl = document.getElementById('buscar-error');
    errEl.classList.add('hidden');
    document.getElementById('resultado').classList.add('hidden');

    if (!email || !email.includes('@')) {
      errEl.textContent = 'Introduce un email válido.';
      errEl.classList.remove('hidden');
      return;
    }

    const btn = document.getElementById('btn-buscar');
    btn.textContent = 'Buscando...'; btn.disabled = true;

    const { data: mensajes, error } = await supabase
      .from('contactos')
      .select('id, nombre, apellidos, asunto, mensaje, created_at, respuesta, respondido_at')
      .eq('email', email)
      .order('created_at', { ascending: false });

    btn.textContent = 'Consultar'; btn.disabled = false;

    if (error || !mensajes?.length) {
      errEl.textContent = 'No encontramos mensajes con ese email. Comprueba que es el mismo con el que enviaste el formulario.';
      errEl.classList.remove('hidden');
      return;
    }

    document.getElementById('resultado-titulo').textContent =
      `${mensajes.length} mensaje${mensajes.length > 1 ? 's' : ''} encontrado${mensajes.length > 1 ? 's' : ''}`;

    document.getElementById('lista-mensajes').innerHTML = mensajes.map(m => {
      const fecha = new Date(m.created_at).toLocaleString('es-ES');
      const asunto = ASUNTOS[m.asunto] || m.asunto || '—';
      const respondido = m.respuesta
        ? `<div class="mt-4 pt-4 border-t border-green-100">
            <div class="flex items-center gap-2 mb-2">
              <span class="text-green-600">✅</span>
              <p class="text-xs font-semibold text-green-700">Respuesta del equipo</p>
            </div>
            <div class="bg-green-50 rounded-xl p-4 text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">${m.respuesta}</div>
            <p class="text-xs text-gray-400 mt-1">${m.respondido_at ? 'Respondido el ' + new Date(m.respondido_at).toLocaleString('es-ES') : ''}</p>
          </div>`
        : `<div class="mt-4 pt-4 border-t border-yellow-100 flex items-center gap-3">
            <span class="text-yellow-500">⏳</span>
            <p class="text-sm text-gray-500">Tu mensaje está siendo revisado. Te responderemos en menos de 48 horas.</p>
          </div>`;

      const badge = m.respuesta
        ? '<span class="bg-green-100 text-green-700 text-xs font-bold px-2 py-0.5 rounded-full">Respondido</span>'
        : '<span class="bg-yellow-100 text-yellow-700 text-xs font-bold px-2 py-0.5 rounded-full">Pendiente</span>';

      return `
        <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
          <div class="flex items-center justify-between mb-3">
            <div>
              <p class="font-semibold text-gray-900">${asunto}</p>
              <p class="text-xs text-gray-400">${fecha}</p>
            </div>
            ${badge}
          </div>
          <div class="bg-gray-50 rounded-xl p-4 text-sm text-gray-700 leading-relaxed whitespace-pre-wrap">${m.mensaje}</div>
          ${respondido}
        </div>`;
    }).join('');

    document.getElementById('resultado').classList.remove('hidden');
  }
</script>

</Layout>
