---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contacto — la Soci">

<style>
  .input-field {
    width: 100%;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 10px 14px;
    font-size: 14px;
    transition: border .15s, box-shadow .15s;
    background: white;
    color: #111827;
  }
  .input-field:focus {
    outline: none;
    border-color: #3b82f6;
    box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
  }
  .social-btn {
    width: 42px; height: 42px;
    border-radius: 10px;
    display: flex; align-items: center; justify-content: center;
    transition: transform .15s, opacity .15s;
    color: white;
  }
  .social-btn:hover { transform: translateY(-2px); opacity: .85; }
  .info-row { display: flex; align-items: flex-start; gap: 14px; }
  .info-icon { width: 40px; height: 40px; border-radius: 10px; background: #eff6ff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
</style>

<!-- Hero -->
<div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-6 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">Contacto</p>
    <h1 class="text-4xl font-bold mb-2">¿Hablamos?</h1>
    <p class="text-blue-200 text-base max-w-xl">Estamos aquí para ayudarte. Escríbenos y te responderemos lo antes posible.</p>
  </div>
</div>

<div class="max-w-5xl mx-auto px-4 py-12">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">

    <!-- Columna izquierda: info + mapa -->
    <div class="space-y-8">

      <!-- Datos de contacto -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6 space-y-5">
        <h2 class="text-lg font-bold text-gray-900 mb-4">Información de contacto</h2>

        <div class="info-row">
          <div class="info-icon"><span class="text-blue-600 text-lg">✉️</span></div>
          <div>
            <p class="text-xs text-gray-400 font-medium mb-0.5">Email</p>
            <a href="mailto:info@lasoci.org" class="text-blue-700 font-semibold hover:underline">info@lasoci.org</a>
          </div>
        </div>

        <div class="info-row">
          <div class="info-icon"><span class="text-blue-600 text-lg">📞</span></div>
          <div>
            <p class="text-xs text-gray-400 font-medium mb-0.5">Teléfono</p>
            <a href="tel:+34932111544" class="text-gray-800 font-semibold hover:text-blue-700">93 211 15 44</a>
          </div>
        </div>

        <div class="info-row">
          <div class="info-icon"><span class="text-blue-600 text-lg">📍</span></div>
          <div>
            <p class="text-xs text-gray-400 font-medium mb-0.5">Dirección</p>
            <p class="text-gray-800 font-semibold">Sardenya, 521-523</p>
            <p class="text-gray-500 text-sm">08024 Barcelona</p>
          </div>
        </div>

        <!-- Redes sociales -->
        <div class="pt-3 border-t border-gray-100">
          <p class="text-xs text-gray-400 font-medium mb-3">Síguenos</p>
          <div class="flex gap-2">
            <a href="https://www.facebook.com/lasoci.caixa" target="_blank" class="social-btn" style="background:#1877f2">
              <svg width="18" height="18" fill="white" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
            <a href="https://x.com/APCAIXA" target="_blank" class="social-btn" style="background:#000">
              <svg width="16" height="16" fill="white" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
            </a>
            <a href="https://www.linkedin.com/company/associaci%C3%B3-del-personal-de-la-caixa-" target="_blank" class="social-btn" style="background:#0077b5">
              <svg width="18" height="18" fill="white" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
            </a>
            <a href="https://www.youtube.com/user/APCaixa" target="_blank" class="social-btn" style="background:#ff0000">
              <svg width="18" height="18" fill="white" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
            </a>
            <a href="https://www.instagram.com/la.soci" target="_blank" class="social-btn" style="background:radial-gradient(circle at 30% 107%, #fdf497 0%, #fdf497 5%, #fd5949 45%, #d6249f 60%, #285AEB 90%)">
              <svg width="18" height="18" fill="white" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
            </a>
          </div>
        </div>
      </div>

      <!-- Mapa -->
      <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
        <iframe
          src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2992.8!2d2.1878!3d41.4068!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x12a4a2f5c5f5f5f5%3A0x0!2sSardenya%2C%20521-523%2C%2008024%20Barcelona!5e0!3m2!1ses!2ses!4v1"
          width="100%" height="260" style="border:0;" allowfullscreen loading="lazy"
          referrerpolicy="no-referrer-when-downgrade">
        </iframe>
        <div class="px-5 py-3 bg-gray-50 border-t border-gray-100">
          <a href="https://maps.google.com/?q=Sardenya+521+Barcelona" target="_blank"
            class="text-sm text-blue-700 font-semibold hover:underline">
            Ver en Google Maps →
          </a>
        </div>
      </div>

    </div>

    <!-- Columna derecha: formulario -->
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-6">
      <h2 class="text-lg font-bold text-gray-900 mb-1">Envíanos un mensaje</h2>
      <p class="text-sm text-gray-400 mb-6">Te responderemos en menos de 48 horas.</p>

      <div class="space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Nombre *</label>
            <input id="f-nombre" type="text" class="input-field" placeholder="Tu nombre" />
          </div>
          <div>
            <label class="block text-xs font-semibold text-gray-600 mb-1.5">Apellidos *</label>
            <input id="f-apellidos" type="text" class="input-field" placeholder="Tus apellidos" />
          </div>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">Email *</label>
          <input id="f-email" type="email" class="input-field" placeholder="tu@email.com"
            oninput="validateContactEmail()" />
          <p id="f-email-error" class="hidden text-xs text-red-500 mt-1">Introduce un email válido (ej: nombre@dominio.com)</p>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">Teléfono</label>
          <input id="f-telefono" type="tel" class="input-field" placeholder="612 345 678" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">Asunto *</label>
          <select id="f-asunto" class="input-field">
            <option value="">Selecciona un asunto</option>
            <option value="informacion">Información general</option>
            <option value="socio">Hacerse socio</option>
            <option value="seccion">Información sobre secciones</option>
            <option value="evento">Información sobre eventos</option>
            <option value="sugerencia">Sugerencia o queja</option>
            <option value="otro">Otro</option>
          </select>
        </div>

        <div>
          <label class="block text-xs font-semibold text-gray-600 mb-1.5">Mensaje *</label>
          <textarea id="f-mensaje" rows="5" class="input-field" placeholder="Escribe tu mensaje aquí..."></textarea>
        </div>

        <div class="flex items-start gap-2">
          <input id="f-privacidad" type="checkbox" class="mt-0.5 w-4 h-4 accent-blue-600" />
          <label for="f-privacidad" class="text-xs text-gray-500">
            He leído y acepto la <a href="/privacidad" class="text-blue-600 hover:underline">política de privacidad</a>
          </label>
        </div>

        <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm rounded-xl px-4 py-3"></div>
        <div id="form-ok" class="hidden bg-green-50 border border-green-200 text-green-700 text-sm rounded-xl px-4 py-3">
          ✅ Mensaje enviado correctamente. Te responderemos pronto.
        </div>

        <button id="btn-enviar" class="w-full bg-orange-500 text-white font-semibold py-3 rounded-xl hover:bg-orange-600 transition text-sm">
          Enviar mensaje
        </button>
      </div>
    </div>

  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  const RESEND_API_KEY = import.meta.env.PUBLIC_RESEND_API_KEY;

  function validateContactEmail() {
    const val = document.getElementById('f-email')?.value || '';
    const err = document.getElementById('f-email-error');
    const input = document.getElementById('f-email');
    const valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val.trim());
    if (val && !valid) {
      if (err) err.classList.remove('hidden');
      if (input) input.style.borderColor = '#ef4444';
    } else {
      if (err) err.classList.add('hidden');
      if (input) input.style.borderColor = '';
    }
  }

  document.getElementById('btn-enviar').addEventListener('click', async () => {
    const nombre    = document.getElementById('f-nombre').value.trim();
    const apellidos = document.getElementById('f-apellidos').value.trim();
    const email     = document.getElementById('f-email').value.trim();
    const telefono  = document.getElementById('f-telefono').value.trim();
    const asunto    = document.getElementById('f-asunto').value;
    const mensaje   = document.getElementById('f-mensaje').value.trim();
    const privacidad = document.getElementById('f-privacidad').checked;

    const errEl = document.getElementById('form-error');
    const okEl  = document.getElementById('form-ok');
    errEl.classList.add('hidden');
    okEl.classList.add('hidden');

    if (!nombre || !apellidos || !email || !asunto || !mensaje) {
      errEl.textContent = 'Por favor rellena todos los campos obligatorios.';
      errEl.classList.remove('hidden'); return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(email)) {
      errEl.textContent = 'El email no tiene un formato válido.';
      errEl.classList.remove('hidden');
      document.getElementById('f-email').style.borderColor = '#ef4444';
      document.getElementById('f-email-error').classList.remove('hidden');
      return;
    }
    if (!privacidad) {
      errEl.textContent = 'Debes aceptar la política de privacidad.';
      errEl.classList.remove('hidden'); return;
    }

    const btn = document.getElementById('btn-enviar');
    btn.textContent = 'Enviando...'; btn.disabled = true;

    // Guardar en Supabase
    const { error: dbError } = await supabase.from('contactos').insert({
      nombre, apellidos, email, telefono, asunto, mensaje
    });

    // Enviar email con Resend
    try {
      await fetch('https://api.resend.com/emails', {
        method: 'POST',
        headers: {
          'Authorization': `Bearer ${import.meta.env.PUBLIC_RESEND_API_KEY}`,
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          from: 'La Soci <noreply@lasoci.org>',
          to: ['info@lasoci.org'],
          subject: `Contacto web: ${asunto}`,
          html: `<h2>Nuevo mensaje de contacto</h2>
            <p><strong>Nombre:</strong> ${nombre} ${apellidos}</p>
            <p><strong>Email:</strong> ${email}</p>
            <p><strong>Teléfono:</strong> ${telefono || '—'}</p>
            <p><strong>Asunto:</strong> ${asunto}</p>
            <hr/>
            <p>${mensaje.replace(/\n/g,'<br>')}</p>`
        })
      });
    } catch(e) { console.error('Email error:', e); }

    btn.textContent = 'Enviar mensaje'; btn.disabled = false;

    if (dbError) {
      errEl.textContent = 'Error al enviar el mensaje. Inténtalo de nuevo.';
      errEl.classList.remove('hidden');
    } else {
      okEl.innerHTML = `✅ Mensaje enviado correctamente. Te responderemos en menos de 48 horas.<br><br>
        <a href="/seguimiento" style="color:#1d4ed8;text-decoration:underline;font-size:13px;">Consultar el estado de tus mensajes con tu email →</a>`;
      okEl.classList.remove('hidden');
      ['f-nombre','f-apellidos','f-email','f-telefono','f-mensaje'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('f-asunto').value = '';
      document.getElementById('f-privacidad').checked = false;
    }
  });
</script>

</Layout>
