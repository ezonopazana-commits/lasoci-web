---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Viajes — la Soci">
  <div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-4 px-6 text-center">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">la Soci</p>
    <h1 class="text-4xl font-bold mb-4" data-i18n="viajes_title">Viajes</h1>
    <p class="text-blue-200 max-w-xl mx-auto" data-i18n="viajes_sub">Descubre los mejores viajes con descuento exclusivo para asociados</p>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-12">
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
        <img src="https://www.lasoci.org/wp-content/uploads/2025/12/GrandesViajes-1-1024x240.jpg" alt="Grandes Viajes" class="w-full h-40 object-cover" />
        <div class="p-5">
          <h3 class="font-bold text-gray-800 text-lg mb-2" data-i18n="viajes_grandes">Grandes Viajes</h3>
          <p class="text-gray-500 text-sm" data-i18n="viajes_grandes_desc">Destinos únicos en todo el mundo con condiciones exclusivas para asociados.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
        <img src="https://www.lasoci.org/wp-content/uploads/2025/12/VacacionesInvierno-1-1024x240.jpg" alt="Vacaciones de Invierno" class="w-full h-40 object-cover" />
        <div class="p-5">
          <h3 class="font-bold text-gray-800 text-lg mb-2" data-i18n="viajes_invierno">Vacaciones de Invierno</h3>
          <p class="text-gray-500 text-sm" data-i18n="viajes_invierno_desc">Escapadas de esquí, nieve y montaña con precios especiales.</p>
        </div>
      </div>
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
        <img src="https://www.lasoci.org/wp-content/uploads/2025/12/CapitalesEuropeas-1-1024x240.jpg" alt="Capitales Europeas" class="w-full h-40 object-cover" />
        <div class="p-5">
          <h3 class="font-bold text-gray-800 text-lg mb-2" data-i18n="viajes_capitales">Capitales Europeas</h3>
          <p class="text-gray-500 text-sm" data-i18n="viajes_capitales_desc">City breaks a las mejores ciudades europeas con tarifas reducidas.</p>
        </div>
      </div>
    </div>

    <div class="bg-blue-50 border border-blue-200 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-blue-900 mb-3" data-i18n="viajes_portal">Portal de viajes exclusivo</h2>
      <p class="text-blue-700 mb-6" data-i18n="viajes_portal_desc">Accede a todas las ofertas de viaje con descuento a través de nuestro portal especializado Servitravel.</p>
      <a href="https://lasociservitravel.es/?lang=es" target="_blank" class="bg-orange-500 hover:bg-orange-600 text-white font-semibold px-8 py-3 rounded-xl transition inline-block" data-i18n="viajes_btn">
        Ver todos los viajes
      </a>
    </div>
  </div>

  <script>
    const T = {
      es: { viajes_title:'Viajes', viajes_sub:'Descubre los mejores viajes con descuento exclusivo para asociados', viajes_grandes:'Grandes Viajes', viajes_grandes_desc:'Destinos únicos en todo el mundo con condiciones exclusivas para asociados.', viajes_invierno:'Vacaciones de Invierno', viajes_invierno_desc:'Escapadas de esquí, nieve y montaña con precios especiales.', viajes_capitales:'Capitales Europeas', viajes_capitales_desc:'City breaks a las mejores ciudades europeas con tarifas reducidas.', viajes_portal:'Portal de viajes exclusivo', viajes_portal_desc:'Accede a todas las ofertas de viaje con descuento a través de nuestro portal especializado Servitravel.', viajes_btn:'Ver todos los viajes' },
      ca: { viajes_title:'Viatges', viajes_sub:"Descobreix els millors viatges amb descompte exclusiu per a associats", viajes_grandes:'Grans Viatges', viajes_grandes_desc:"Destinacions úniques arreu del món amb condicions exclusives per a associats.", viajes_invierno:"Vacances d'Hivern", viajes_invierno_desc:"Escapades d'esquí, neu i muntanya amb preus especials.", viajes_capitales:'Capitals Europees', viajes_capitales_desc:'City breaks a les millors ciutats europees amb tarifes reduïdes.', viajes_portal:'Portal de viatges exclusiu', viajes_portal_desc:'Accedeix a totes les ofertes de viatge amb descompte a través del nostre portal especialitzat Servitravel.', viajes_btn:'Veure tots els viatges' },
      en: { viajes_title:'Travel', viajes_sub:'Discover the best trips with exclusive discounts for members', viajes_grandes:'Grand Tours', viajes_grandes_desc:'Unique destinations worldwide with exclusive conditions for members.', viajes_invierno:'Winter Holidays', viajes_invierno_desc:'Ski, snow and mountain getaways at special prices.', viajes_capitales:'European Capitals', viajes_capitales_desc:'City breaks to the best European cities at reduced rates.', viajes_portal:'Exclusive travel portal', viajes_portal_desc:'Access all discounted travel offers through our specialised Servitravel portal.', viajes_btn:'View all trips' }
    };
    function applyLang(lang) { const t = T[lang]||T.es; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.getAttribute('data-i18n'); if(t[k]) el.textContent=t[k]; }); }
    applyLang(localStorage.getItem('lasoci_lang')||'es');
    window.addEventListener('langchange', e => applyLang(e.detail.lang));
  </script>
</Layout>
