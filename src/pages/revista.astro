---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Revista — la Soci">

<style>
  .revista-card { transition: transform .2s, box-shadow .2s; cursor: pointer; }
  .revista-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.15); }
  .revista-card.activa { ring: 2px solid #1e3a8a; }
  #visor-wrap { transition: all .3s; }
</style>

<!-- Hero -->
<div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-12 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">Publicación</p>
    <h1 class="text-4xl font-bold mb-3">Revista la Soci</h1>
    <p class="text-blue-200 text-base max-w-2xl">Desde 1935, la revista de la Asociación del Personal de "la Caixa". Información sobre actividades, secciones y la vida de nuestra comunidad. Publicación bimestral.</p>
  </div>
</div>

<div class="max-w-5xl mx-auto px-4 py-10">

  <!-- Última edición destacada -->
  <div class="mb-10">
    <h2 class="text-xl font-bold text-gray-900 mb-5">Última edición</h2>
    <div class="bg-white rounded-2xl border border-gray-100 shadow-sm overflow-hidden">
      <div class="flex flex-col md:flex-row gap-0">
        <div class="md:w-48 flex-shrink-0">
          <img src="https://admin.lasoci.org/documents/butlleti/imgs/612_portada_ES.jpg"
               alt="Revista 612" class="w-full h-full object-cover" style="min-height:200px;" />
        </div>
        <div class="p-8 flex flex-col justify-between flex-1">
          <div>
            <span class="bg-orange-100 text-orange-700 text-xs font-bold px-3 py-1 rounded-full">Número actual</span>
            <h3 class="text-2xl font-bold text-gray-900 mt-3 mb-2">Revista n° 612</h3>
            <p class="text-blue-700 font-medium mb-4">Junio - Julio 2026</p>
            <p class="text-gray-600 text-sm leading-relaxed">Pocas entidades hay que puedan decir que tienen una revista propia que se edita y no ha dejado de publicar desde 1935. Con los nombres de "Boletín" primero, "Revista" después y "La Soci" actualmente, ha sido y es el medio de comunicación de referencia de la Asociación.</p>
          </div>
          <div class="flex gap-3 mt-6">
            <button onclick="abrirVisor('https://pubhtml5.com/read/aargq/zpll/index.html', 'Revista n° 612')"
              class="bg-blue-900 text-white px-5 py-2.5 rounded-xl font-semibold text-sm hover:bg-blue-800 transition">
              📖 Leer revista
            </button>
            <a href="mailto:info@lasoci.org" class="border border-gray-200 text-gray-600 px-5 py-2.5 rounded-xl font-medium text-sm hover:bg-gray-50 transition">
              Solicitar edición anterior
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Visor embebido -->
  <div id="visor-wrap" class="hidden mb-10">
    <div class="flex items-center justify-between mb-3">
      <h3 id="visor-titulo" class="text-lg font-bold text-gray-900"></h3>
      <button onclick="cerrarVisor()" class="text-gray-400 hover:text-gray-600 text-sm font-medium">✕ Cerrar visor</button>
    </div>
    <div class="bg-gray-100 rounded-2xl overflow-hidden" style="height:600px;">
      <iframe id="visor-iframe" src="" width="100%" height="100%" style="border:0;" allowfullscreen></iframe>
    </div>
  </div>

  <!-- Ediciones anteriores -->
  <div>
    <h2 class="text-xl font-bold text-gray-900 mb-5">Ediciones anteriores</h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" id="grid-revistas">

      {[
        { num: 611, periodo: 'Abr - May 2026', img: '611_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/vbfs/' },
        { num: 610, periodo: 'Feb - Mar 2026', img: '610_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/swab/' },
        { num: 609, periodo: 'Dic 25 - Ene 26', img: '609_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/urys/' },
        { num: 608, periodo: 'Oct - Nov 2025', img: '608_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/zmsd/' },
        { num: 607, periodo: 'Ago - Sep 2025', img: '607_portada_ES.jpg', url: 'https://pubhtml5.com/aargq/pkab/' },
        { num: 606, periodo: 'Jun - Jul 2025', img: '606_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/jbef/' },
        { num: 605, periodo: 'Abr - May 2025', img: '605_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/clde/' },
        { num: 604, periodo: 'Feb - Mar 2025', img: '604_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/klyk/' },
        { num: 603, periodo: 'Dic 24 - Ene 25', img: '603_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/iemy/' },
        { num: 602, periodo: 'Oct - Nov 2024', img: '602_portada_ES.jpg', url: 'https://online.pubhtml5.com/aargq/hxfy/' },
        { num: 601, periodo: 'Ago - Sep 2024', img: '601_ES.jpg', url: 'https://online.pubhtml5.com/aargq/vltc/' },
        { num: 600, periodo: 'Jun - Jul 2024', img: '600_ES.jpg', url: 'https://online.pubhtml5.com/aargq/mcfl/' },
      ].map(r => (
        <div class="revista-card bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden"
          onclick={`abrirVisor('${r.url}', 'Revista n° ${r.num}')`}>
          <img src={`https://admin.lasoci.org/documents/butlleti/imgs/${r.img}`}
               alt={`Revista ${r.num}`} class="w-full object-cover" style="aspect-ratio:3/4;" />
          <div class="p-3">
            <p class="font-bold text-gray-900 text-sm">N° {r.num}</p>
            <p class="text-xs text-gray-400">{r.periodo}</p>
          </div>
        </div>
      ))}

    </div>
  </div>

  <!-- Otras publicaciones -->
  <div class="mt-12">
    <h2 class="text-xl font-bold text-gray-900 mb-5">Otras publicaciones</h2>
    <div class="flex gap-6">
      <div class="revista-card bg-white rounded-xl border border-gray-100 shadow-sm overflow-hidden w-40"
        onclick="abrirVisor('https://online.pubhtml5.com/aargq/gozr/', 'Centenario Teatre Barcelona – La Teatral')">
        <img src="https://www.lasoci.org/wp-content/uploads/2025/04/portada_ES_teatral-212x300.jpg"
             alt="La Teatral" class="w-full object-cover" style="aspect-ratio:3/4;" />
        <div class="p-3">
          <p class="font-bold text-gray-900 text-xs leading-tight">Centenario Teatre Barcelona</p>
          <p class="text-xs text-gray-400 mt-0.5">La Teatral</p>
        </div>
      </div>
    </div>
  </div>

</div>

<script>
  window.abrirVisor = function(url, titulo) {
    document.getElementById('visor-titulo').textContent = titulo;
    document.getElementById('visor-iframe').src = url;
    const wrap = document.getElementById('visor-wrap');
    wrap.classList.remove('hidden');
    wrap.scrollIntoView({ behavior: 'smooth', block: 'start' });
  };

  window.cerrarVisor = function() {
    document.getElementById('visor-wrap').classList.add('hidden');
    document.getElementById('visor-iframe').src = '';
  };
</script>

</Layout>
