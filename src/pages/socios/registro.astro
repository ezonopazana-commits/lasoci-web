      }
    };

    let currentStep = 1;
    const totalSteps = 4;
    let privacyAccepted = false;
    let privacyScrolled = false;
    let titularIban = null;

    function getLang() { return localStorage.getItem('lasoci_lang') || 'es'; }

    function applyLang(lang) {
      const t = T[lang] || T.es;
      const ids = {
        'banner-text': t.banner, 'sidebar-title': t.sidebar_title,
        'reg-title': t.reg_title, 's1-title': t.s1_title, 's1-sub': t.s1_sub, 's1-info': t.s1_info,
        's2-title': t.s2_title, 's2-sub': t.s2_sub, 's3-title': t.s3_title, 's3-sub': t.s3_sub,
        's4-title': t.s4_title, 's4-sub': t.s4_sub,
        'label-email': t.label_email, 'label-telefon': t.label_telefon,
        'label-nombre': t.label_nombre, 'label-apellidos': t.label_apellidos, 'label-dni': t.label_dni,
        'label-vinculacion': t.label_vinculacion, 'label-buscar-titular': t.label_buscar_titular,
        'opt-select': t.opt_select, 'opt-empleado': t.opt_empleado, 'opt-jubilado': t.opt_jubilado,
        'opt-beneficiario': t.opt_beneficiario, 'opt-empleado-lasoci': t.opt_empleado_lasoci,
        'label-iban': t.label_iban, 'label-idioma': t.label_idioma,
        'label-iban-tipo': t.label_iban_tipo,
        'opt-iban-propio-title': t.opt_iban_propio_title, 'opt-iban-propio-sub': t.opt_iban_propio_sub,
        'opt-iban-titular-title': t.opt_iban_titular_title, 'opt-iban-titular-sub': t.opt_iban_titular_sub,
        'aviso-sin-iban-text': t.aviso_sin_iban,
        'info-titular-nombre-label': t.info_titular_nombre_label, 'info-titular-iban-label': t.info_titular_iban_label,
        'label-pwd': t.label_pwd, 'label-pwd2': t.label_pwd2,
        'btn-continuar-1': t.btn_continuar, 'btn-continuar-2': t.btn_continuar, 'btn-continuar-3': t.btn_continuar,
        'btn-anterior-2': t.btn_anterior, 'btn-anterior-3': t.btn_anterior, 'btn-anterior-4': t.btn_anterior,
        'btn-crear': t.btn_crear, 'ya-socio': t.ya_socio, 'link-login': t.link_login,
        'rgpd-text': t.rgpd_text, 'open-privacy': t.open_privacy,
        'modal-title': t.modal_title, 'modal-warning': t.modal_warning,
        'privacy-heading': t.privacy_heading, 'btn-accept-privacy': t.btn_accept,
      };
      Object.entries(ids).forEach(([id, val]) => {
        const el = document.getElementById(id);
        if (el) el.textContent = val;
      });
      document.getElementById('buscar-titular').placeholder = t.buscar_placeholder;
      // Mostrar bloque de privacidad según idioma
      ['es','ca','en'].forEach(l => {
        const el = document.getElementById('privacy-body-' + l);
        if (el) el.classList.toggle('hidden', l !== lang);
      });
      renderSidebar(lang);
    }

    function renderSidebar(lang) {
      const t = T[lang] || T.es;
      const container = document.getElementById('steps-sidebar');
      container.innerHTML = t.steps.map((name, i) => {
        const step = i + 1;
        const isActive = step === currentStep;
        const isDone = step < currentStep;
        return `
          <div class="flex items-center gap-3 py-2">
            <div class="w-8 h-8 rounded-full flex items-center justify-center text-sm font-bold flex-shrink-0
              ${isDone ? 'bg-green-500 text-white' : isActive ? 'bg-orange-500 text-white' : 'border-2 border-gray-200 text-gray-400'}">
              ${isDone ? '✓' : step}
            </div>
            <span class="text-sm ${isActive ? 'font-bold text-gray-800' : isDone ? 'text-green-600 font-medium' : 'text-gray-400'}">${name}</span>
          </div>
          ${step < totalSteps ? '<div class="ml-4 w-px h-4 bg-gray-200"></div>' : ''}
        `;
      }).join('');
    }

    function showStep(step) {
      document.querySelectorAll('.step-panel').forEach(p => p.classList.add('hidden'));
      document.getElementById('step-' + step).classList.remove('hidden');
      currentStep = step;
      const pct = (step / totalSteps) * 100;
      document.getElementById('progress-bar').style.width = pct + '%';
      renderSidebar(getLang());
      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    window.nextStep = function(from) {
      const t = T[getLang()] || T.es;
      if (from === 1) {
        if (!document.getElementById('email').value.trim()) { alert(t.label_email); return; }
        if (!privacyAccepted) { alert(t.err_rgpd); return; }
      }
      if (from === 2) {
        const nombre = document.getElementById('nombre').value.trim();
        const apellidos = document.getElementById('apellidos').value.trim();
        const dni = document.getElementById('dni').value.trim();
        const vinculacion = document.getElementById('vinculacion').value;
        if (!nombre || !apellidos || !dni) return;
        if (!validateDNI(dni)) { document.getElementById('dni-error').textContent = t.err_dni; document.getElementById('dni-error').classList.remove('hidden'); return; }
        if (vinculacion === 'beneficiario' && !document.getElementById('titular-dni').value) { alert(t.err_titular); return; }
        // Mostrar/ocultar selector IBAN tipo en step 3
        document.getElementById('iban-tipo-section').classList.toggle('hidden', vinculacion !== 'beneficiario');
        if (vinculacion !== 'beneficiario') {
          document.getElementById('radio-iban-propio').checked = true;
          document.getElementById('iban-field-section').classList.remove('hidden');
          document.getElementById('info-iban-titular').classList.add('hidden');
          document.getElementById('aviso-sin-iban').classList.add('hidden');
        }
      }
      showStep(from + 1);
    };

    window.prevStep = function(from) { showStep(from - 1); };

    // ── IBAN tipo selector ──
    document.querySelectorAll('input[name="iban_tipo"]').forEach(radio => {
      radio.addEventListener('change', async (e) => {
        const esTitular = e.target.value === 'titular';
        document.getElementById('iban-field-section').classList.toggle('hidden', esTitular);
        document.getElementById('info-iban-titular').classList.add('hidden');
        document.getElementById('aviso-sin-iban').classList.add('hidden');
        titularIban = null;

        if (esTitular) {
          const titularDni = document.getElementById('titular-dni').value;
          if (titularDni) {
            const { data } = await db.from('socios').select('nombre, apellidos, iban').eq('dni', titularDni).single();
            if (data) {
              if (data.iban) {
                titularIban = data.iban;
                document.getElementById('info-titular-nombre-val').textContent = data.nombre + ' ' + data.apellidos;
                document.getElementById('info-titular-iban-val').textContent = data.iban.match(/.{1,4}/g)?.join(' ') || data.iban;
                document.getElementById('info-iban-titular').classList.remove('hidden');
              } else {
                document.getElementById('aviso-sin-iban').classList.remove('hidden');
              }
            }
          }
        }
      });
    });

    // ── Privacy ──
    document.getElementById('open-privacy').addEventListener('click', () => {
      document.getElementById('privacy-modal').classList.remove('hidden');
      document.getElementById('scroll-btn').classList.remove('hidden');
      privacyScrolled = false;
      document.getElementById('btn-accept-privacy').disabled = true;
      document.getElementById('btn-accept-privacy').className = 'bg-gray-300 text-gray-500 font-semibold px-10 py-3 rounded-xl transition text-sm cursor-not-allowed';
    });
    window.closePrivacy = function() {
      document.getElementById('privacy-modal').classList.add('hidden');
      document.getElementById('scroll-btn').classList.add('hidden');
    };
    window.checkScroll = function() {
      const el = document.getElementById('privacy-content');
      if (el.scrollHeight - el.scrollTop - el.clientHeight < 50 && !privacyScrolled) {
        privacyScrolled = true;
        const btn = document.getElementById('btn-accept-privacy');
        btn.disabled = false;
        btn.className = 'bg-orange-500 hover:bg-orange-600 text-white font-semibold px-10 py-3 rounded-xl transition text-sm cursor-pointer';
      }
    };
    window.scrollPrivacy = function() { document.getElementById('privacy-content').scrollBy({ top: 300, behavior: 'smooth' }); };
    window.acceptPrivacy = function() { privacyAccepted = true; document.getElementById('rgpd').checked = true; closePrivacy(); };
    document.getElementById('rgpd').addEventListener('change', (e) => {
      if (e.target.checked && !privacyAccepted) { e.target.checked = false; document.getElementById('open-privacy').click(); }
      else if (!e.target.checked) privacyAccepted = false;
    });

    // ── DNI ──
    function validateDNI(dni) {
      const clean = dni.toUpperCase().trim();
      if (!/^\d{8}[A-Z]$/.test(clean)) return false;
      return clean[8] === 'TRWAGMYFPDXBNJZSQVHLCKE'[parseInt(clean.substring(0, 8)) % 23];
    }
    document.getElementById('dni').addEventListener('input', (e) => {
      e.target.value = e.target.value.toUpperCase();
      const err = document.getElementById('dni-error');
      if (e.target.value.length === 9) {
        if (!validateDNI(e.target.value)) { err.textContent = T[getLang()].err_dni; err.classList.remove('hidden'); }
        else err.classList.add('hidden');
      } else err.classList.add('hidden');
    });

    // ── IBAN ──
    function validateIBAN(iban) {
      const clean = iban.toUpperCase().replace(/\s/g, '');
      if (!/^[A-Z]{2}[0-9]{2}[A-Z0-9]+$/.test(clean)) return false;
      const rearranged = clean.slice(4) + clean.slice(0, 4);
      let numeric = '';
      for (const c of rearranged) numeric += isNaN(c) ? (c.charCodeAt(0) - 55).toString() : c;
      let remainder = 0;
      for (const digit of numeric) remainder = (remainder * 10 + parseInt(digit)) % 97;
      return remainder === 1;
    }
    document.getElementById('iban').addEventListener('input', (e) => {
      const raw = e.target.value.toUpperCase().replace(/\s/g, '');
      e.target.value = raw.match(/.{1,4}/g)?.join(' ') || raw;
      const t = T[getLang()] || T.es;
      const err = document.getElementById('iban-error');
      const ok = document.getElementById('iban-ok');
      if (raw.length >= 15) {
        if (!validateIBAN(raw)) { err.textContent = t.err_iban; err.classList.remove('hidden'); ok.classList.add('hidden'); }
        else { err.classList.add('hidden'); ok.textContent = t.iban_ok; ok.classList.remove('hidden'); }
      } else { err.classList.add('hidden'); ok.classList.add('hidden'); }
    });

    // ── Toggle password ──
    document.getElementById('toggle-pwd').addEventListener('click', () => {
      const p = document.getElementById('password');
      p.type = p.type === 'password' ? 'text' : 'password';
    });

    // ── Vinculación ──
    document.getElementById('vinculacion').addEventListener('change', () => {
      const val = document.getElementById('vinculacion').value;
      document.getElementById('titular-section').classList.toggle('hidden', val !== 'beneficiario');
      if (val !== 'beneficiario') clearTitular();
    });

    // ── Buscar titular ──
    window.clearTitular = function() {
      document.getElementById('titular-dni').value = '';
      document.getElementById('titular-selected').classList.add('hidden');
      document.getElementById('buscar-titular').value = '';
      titularIban = null;
    };
    let searchTimeout;
    document.getElementById('buscar-titular').addEventListener('input', (e) => {
      clearTimeout(searchTimeout);
      const q = e.target.value.trim();
      if (q.length < 2) { document.getElementById('titular-resultados').classList.add('hidden'); return; }
      searchTimeout = setTimeout(() => buscarTitular(q), 300);
    });
    async function buscarTitular(q) {
      const { data } = await db.from('socios').select('dni, nombre, apellidos, vinculacion')
        .eq('activo', true).in('vinculacion', ['empleado', 'jubilado'])
        .or(`apellidos.ilike.%${q}%,nombre.ilike.%${q}%`).limit(10);
      const container = document.getElementById('titular-resultados');
      if (!data || data.length === 0) {
        container.innerHTML = '<p class="px-4 py-3 text-sm text-gray-500">No s\'han trobat resultats</p>';
      } else {
        container.innerHTML = data.map(s => `
          <button type="button" onclick="selectTitular('${s.dni}','${s.nombre} ${s.apellidos}','${s.vinculacion}')"
            class="w-full text-left px-4 py-3 hover:bg-blue-50 text-sm border-b border-gray-100 last:border-0">
            <span class="font-medium text-gray-800">${s.apellidos}, ${s.nombre}</span>
            <span class="text-xs text-gray-500 ml-2">${s.vinculacion === 'empleado' ? '👔' : '🏖️'}</span>
          </button>`).join('');
      }
      container.classList.remove('hidden');
    }
    window.selectTitular = function(dni, nombre, vinculacion) {
      document.getElementById('titular-dni').value = dni;
      document.getElementById('titular-nombre').textContent = nombre;
      document.getElementById('titular-vinculacion').textContent = vinculacion === 'empleado' ? '👔 Empleat CaixaBank' : '🏖️ Jubilat CaixaBank';
      document.getElementById('titular-selected').classList.remove('hidden');
      document.getElementById('titular-resultados').classList.add('hidden');
      document.getElementById('buscar-titular').value = '';
      // Reset iban tipo si cambia el titular
      document.getElementById('radio-iban-propio').checked = true;
      document.getElementById('iban-field-section').classList.remove('hidden');
      document.getElementById('info-iban-titular').classList.add('hidden');
      document.getElementById('aviso-sin-iban').classList.add('hidden');
      titularIban = null;
    };

    // ── Submit ──
    window.submitForm = async function() {
      const lang = getLang();
      const t = T[lang] || T.es;
      const errDiv = document.getElementById('reg-error');
      const okDiv = document.getElementById('reg-success');
      const btn = document.getElementById('btn-crear');
      errDiv.classList.add('hidden'); okDiv.classList.add('hidden');

      const pwd = document.getElementById('password').value;
      const pwd2 = document.getElementById('password2').value;
      if (pwd !== pwd2) {
        document.getElementById('pwd-error').textContent = t.err_pwd;
        document.getElementById('pwd-error').classList.remove('hidden');
        return;
      }
      document.getElementById('pwd-error').classList.add('hidden');

      btn.textContent = t.loading;
      const nombre = document.getElementById('nombre').value.trim();
      const apellidos = document.getElementById('apellidos').value.trim();
      const dni = document.getElementById('dni').value.trim().toUpperCase();
      const vinculacion = document.getElementById('vinculacion').value;
      const titular_dni = document.getElementById('titular-dni').value || null;
      const email = document.getElementById('email').value.trim();
      const telefon = document.getElementById('telefon').value.trim();
      const idioma = document.getElementById('idioma').value;
      const iban_tipo = document.querySelector('input[name="iban_tipo"]:checked')?.value || 'propio';
      let iban_raw = document.getElementById('iban').value.replace(/\s/g, '').toUpperCase();

      // Si eligió IBAN del titular, usar el IBAN del titular
      if (iban_tipo === 'titular' && titularIban) {
        iban_raw = titularIban;
      } else if (iban_tipo === 'titular' && !titularIban) {
        iban_raw = null;
      }

      const { data, error } = await db.auth.signUp({
        email, password: pwd,
        options: { data: { nombre, apellidos, dni, vinculacion, idioma } }
      });

      if (error) {
        errDiv.textContent = t.err_generic + ' ' + error.message;
        errDiv.classList.remove('hidden');
        btn.textContent = t.btn_crear;
        return;
      }

      if (data.user) {
        const res = await fetch('/api/registro', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            id: data.user.id, email, nombre, apellidos, dni,
            telefono: telefon || null,
            iban: iban_raw || null,
            vinculacion,
            titular_dni,
            iban_tipo
          })
        });
        const result = await res.json();
        if (!result.ok) {
          errDiv.textContent = t.err_generic + ' ' + result.error;
          errDiv.classList.remove('hidden');
          btn.textContent = t.btn_crear;
          return;
        }
        localStorage.setItem('lasoci_lang', idioma);
      }

      okDiv.textContent = t.success;
      okDiv.classList.remove('hidden');
      btn.textContent = t.btn_crear;
    };

    // ── Init ──
    const lang = getLang();
    document.getElementById('idioma').value = lang;
    applyLang(lang);
    window.addEventListener('langchange', (e) => applyLang(e.detail.lang));
    document.getElementById('idioma').addEventListener('change', () => {
      const l = document.getElementById('idioma').value;
      localStorage.setItem('lasoci_lang', l);
      applyLang(l);
    });
  </script>

</Layout>
