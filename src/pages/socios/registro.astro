        opt_iban_propio_title:'My own IBAN', opt_iban_propio_sub:'Enter your bank account number',
        opt_iban_titular_title:'Account holder IBAN (employee/retiree)', opt_iban_titular_sub:"The holder's registered IBAN will be used",
