---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Iniciar sessió — la Soci">
  <div class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-12">
    <div class="w-full max-w-md">
      <div class="bg-white rounded-2xl shadow-lg p-8">
        <div class="text-center mb-8">
          <a href="/"><span class="text-3xl font-bold text-orange-500">la</span><span class="text-3xl font-bold text-blue-900">Soci</span></a>
          <h1 class="text-xl font-bold text-gray-800 mt-3" id="login-title">Iniciar sesión</h1>
          <p class="text-gray-500 text-sm mt-1" id="login-sub">Accede a tu área privada</p>
        </div>
        <form id="login-form" class="space-y-5">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" id="label-email">Correo electrónico</label>
            <input type="email" id="email" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm" placeholder="nom@caixabank.com" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1" id="label-password">Contraseña</label>
            <div class="relative">
              <input type="password" id="password" required class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm pr-12" placeholder="••••••••" />
              <button type="button" id="toggle-pwd" class="absolute right-3 top-3 text-gray-400 hover:text-gray-600">👁️</button>
            </div>
          </div>
          <div id="login-error" class="hidden bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg text-sm"></div>
          <button type="submit" id="login-btn" class="w-full bg-orange-500 hover:bg-orange-600 text-white font-semibold py-3 rounded-lg transition text-sm">
            <span id="login-btn-text">Acceder</span>
          </button>
        </form>
        <div class="mt-6 text-center space-y-2">
          <a href="/socios/recuperar" class="text-sm text-blue-600 hover:underline" id="link-forgot">¿Olvidaste la contraseña?</a>
          <p class="text-sm text-gray-500">
            <span id="link-register-text">¿Aún no eres socio?</span>
            <a href="/socios/registro" class="text-orange-500 hover:underline font-medium" id="link-register">Regístrate</a>
          </p>
        </div>
      </div>
    </div>
  </div>
  <script>
    import { supabase } from '../../lib/supabase.ts';
    const T = {
      es: { title:'Iniciar sesión',sub:'Accede a tu área privada',label_email:'Correo electrónico',label_pwd:'Contraseña',btn:'Acceder',forgot:'¿Olvidaste la contraseña?',no_socio:'¿Aún no eres socio?',registro:'Regístrate',loading:'Accediendo...',error_invalid:'Email o contraseña incorrectos',error_generic:'Error al iniciar sesión.' },
      ca: { title:'Iniciar sessió',sub:'Accedeix al teu àrea privada',label_email:'Correu electrònic',label_pwd:'Contrasenya',btn:'Accedeix',forgot:'Has oblidat la contrasenya?',no_socio:'Encara no ets soci?',registro:"Registra't",loading:'Accedint...',error_invalid:'Email o contrasenya incorrectes',error_generic:"Error en iniciar sessió." }
    };
    function applyLang(lang) {
      const t=T[lang]||T.es;
      document.getElementById('login-title').textContent=t.title;
      document.getElementById('login-sub').textContent=t.sub;
      document.getElementById('label-email').textContent=t.label_email;
      document.getElementById('label-password').textContent=t.label_pwd;
      document.getElementById('login-btn-text').textContent=t.btn;
      document.getElementById('link-forgot').textContent=t.forgot;
      document.getElementById('link-register-text').textContent=t.no_socio;
      document.getElementById('link-register').textContent=t.registro;
    }
    const lang=localStorage.getItem('lasoci_lang')||'es';
    applyLang(lang);
    window.addEventListener('langchange',(e)=>applyLang(e.detail.lang));
    document.getElementById('toggle-pwd')?.addEventListener('click',()=>{const p=document.getElementById('password');p.type=p.type==='password'?'text':'password';});
    document.getElementById('login-form')?.addEventListener('submit',async(e)=>{
      e.preventDefault();
      const lang=localStorage.getItem('lasoci_lang')||'es';
      const t=T[lang]||T.es;
      const email=document.getElementById('email').value.trim();
      const password=document.getElementById('password').value;
      const btn=document.getElementById('login-btn-text');
      const errDiv=document.getElementById('login-error');
      btn.textContent=t.loading;
      errDiv.classList.add('hidden');
      const {error}=await supabase.auth.signInWithPassword({email,password});
      if(error){errDiv.textContent=error.message.includes('Invalid')?t.error_invalid:t.error_generic;errDiv.classList.remove('hidden');btn.textContent=t.btn;}
      else{window.location.href='/socios/dashboard';}
    });
  </script>
</Layout>
