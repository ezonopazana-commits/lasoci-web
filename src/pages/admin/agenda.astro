---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin — Agenda">

  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Gestión de Agenda</h1>
        <p class="text-sm text-gray-500 mt-1">Eventos y actividades</p>
      </div>
      <button id="btn-nuevo" class="bg-blue-900 text-white px-4 py-2 rounded-lg text-sm font-medium hover:bg-blue-800 transition">
        + Nuevo evento
      </button>
    </div>

    <div class="flex gap-3 mb-5 flex-wrap">
      <input id="search" type="text" placeholder="Buscar evento..." class="border border-gray-300 rounded-lg px-3 py-2 text-sm w-64 focus:outline-none focus:ring-2 focus:ring-blue-500" />
      <select id="filter-estado" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">Todos</option>
        <option value="true">Publicados</option>
        <option value="false">Borradores</option>
      </select>
    </div>

    <div class="bg-white rounded-xl shadow border border-gray-100 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Evento</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Fecha</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Lugar</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Inscritos</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Estado</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Acciones</th>
          </tr>
        </thead>
        <tbody id="tabla-body" class="divide-y divide-gray-100">
          <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL CREAR/EDITAR -->
  <div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h2 id="modal-titulo" class="text-lg font-bold text-gray-900">Nuevo evento</h2>
        <button id="btn-cerrar-modal" class="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
      </div>

      <div class="px-6 py-5 space-y-4">

        <!-- Tipo (primero para que condicione el resto) -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Tipo *</label>
          <select id="f-tipo" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
            <option value="general">General</option>
            <option value="seccion">Sección</option>
          </select>
        </div>

        <!-- Sección + Provincia (visible solo si tipo=seccion) -->
        <div id="wrap-seccion" style="display:none">
          <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Sección *</label>
            <select id="f-seccion" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">— Selecciona sección —</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Provincia</label>
            <input id="f-provincia" type="text" readonly class="w-full border border-gray-200 bg-gray-50 rounded-lg px-3 py-2 text-sm text-gray-500" placeholder="Se rellena al elegir sección" />
          </div>
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Título (ES) *</label>
          <input id="f-titulo" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Títol (CA)</label>
          <input id="f-titulo-ca" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
          <textarea id="f-descripcion" rows="4" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Fecha y hora inicio *</label>
            <input id="f-fecha-inicio" type="datetime-local" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Fecha y hora fin</label>
            <input id="f-fecha-fin" type="datetime-local" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Lugar</label>
          <input id="f-lugar" type="text" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Sede, sala, ciudad..." />
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Aforo máximo</label>
            <input id="f-aforo" type="number" min="1" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Vacío = sin límite" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">Precio (€)</label>
            <input id="f-precio" type="number" min="0" step="0.01" value="0" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" />
          </div>
        </div>

        <!-- Imagen -->
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-2">Imagen</label>
          <div class="flex border border-gray-200 rounded-lg overflow-hidden mb-3 w-fit">
            <button type="button" id="tab-pc" class="px-4 py-2 text-sm font-medium bg-blue-900 text-white transition">📁 Subir desde PC</button>
            <button type="button" id="tab-url" class="px-4 py-2 text-sm font-medium bg-white text-gray-600 hover:bg-gray-50 transition">🔗 URL externa</button>
          </div>
          <div id="img-preview-wrap" class="hidden mb-3">
            <img id="img-preview" src="" alt="" class="w-full h-40 object-cover rounded-lg border border-gray-200" />
            <button type="button" id="btn-quitar-imagen" class="mt-1 text-xs text-red-500 hover:underline">Quitar imagen</button>
          </div>
          <div id="panel-pc">
            <div id="upload-zone" class="border-2 border-dashed border-gray-300 rounded-xl p-5 text-center cursor-pointer hover:border-blue-400 hover:bg-blue-50 transition">
              <p class="text-sm text-gray-500">Arrastra o <span class="text-blue-600 font-medium">selecciona imagen</span></p>
              <p class="text-xs text-gray-400 mt-1">JPG, PNG, WebP · máx. 5 MB</p>
            </div>
            <input id="f-imagen-file" type="file" accept="image/jpeg,image/png,image/webp" class="hidden" />
            <div id="upload-progress-wrap" class="hidden mt-2">
              <div class="flex justify-between text-xs text-gray-500 mb-1"><span id="upload-filename"></span><span id="upload-pct">0%</span></div>
              <div class="w-full bg-gray-200 rounded-full h-1.5"><div id="upload-bar" class="bg-blue-600 h-1.5 rounded-full transition-all" style="width:0%"></div></div>
            </div>
          </div>
          <div id="panel-url" class="hidden">
            <input id="f-imagen-url-input" type="url" class="w-full border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="https://..." />
          </div>
          <input id="f-imagen-url" type="hidden" />
        </div>

        <div class="flex items-center gap-3">
          <input id="f-activo" type="checkbox" class="w-4 h-4 accent-blue-600" />
          <label for="f-activo" class="text-sm font-medium text-gray-700">Publicar inmediatamente</label>
        </div>

        <div id="form-error" class="hidden bg-red-50 border border-red-200 text-red-700 text-sm rounded-lg px-4 py-3"></div>
        <div id="form-ok" class="hidden bg-green-50 border border-green-200 text-green-700 text-sm rounded-lg px-4 py-3"></div>
      </div>

      <div class="px-6 py-4 border-t border-gray-200 flex justify-end gap-3">
        <button id="btn-cancelar" class="px-4 py-2 text-sm text-gray-600 border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
        <button id="btn-guardar" class="px-5 py-2 text-sm font-medium bg-blue-900 text-white rounded-lg hover:bg-blue-800 transition">Guardar</button>
      </div>
    </div>
  </div>

  <!-- MODAL INSCRITOS -->
  <div id="modal-inscritos" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[80vh] overflow-y-auto">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h2 id="inscritos-titulo" class="text-lg font-bold text-gray-900">Inscritos</h2>
        <button id="btn-cerrar-inscritos" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
      </div>
      <div id="inscritos-lista" class="px-6 py-4 space-y-2"></div>
    </div>
  </div>

  <!-- MODAL BORRAR -->
  <div id="modal-borrar" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-sm p-6 text-center">
      <div class="text-4xl mb-3">🗑️</div>
      <h3 class="text-lg font-bold mb-2">¿Eliminar evento?</h3>
      <p class="text-sm text-gray-500 mb-5">Se eliminarán también todas las inscripciones.</p>
      <div class="flex gap-3 justify-center">
        <button id="btn-cancelar-borrar" class="px-4 py-2 text-sm border border-gray-300 rounded-lg hover:bg-gray-50">Cancelar</button>
        <button id="btn-confirmar-borrar" class="px-4 py-2 text-sm bg-red-600 text-white rounded-lg hover:bg-red-700">Eliminar</button>
      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
    const BUCKET = 'noticias-imagenes';

    let eventos    = [];
    let secciones  = [];
    let editandoId = null;
    let borrandoId = null;
    let uploadedImageUrl = null;

    // ── INIT ──
    async function init() {
      const { data: secsData } = await supabase
        .from('secciones').select('id, nombre, provincia').eq('activa', true).order('nombre');
      secciones = secsData || [];
      const sel = document.getElementById('f-seccion');
      sel.innerHTML = '<option value="">— Selecciona sección —</option>' +
        secciones.map(s => `<option value="${s.id}" data-provincia="${s.provincia||''}">${s.nombre}</option>`).join('');

      const { data } = await supabase
        .from('eventos')
        .select('id, titulo, fecha_inicio, lugar, activo, plazas, tipo, seccion_id')
        .order('fecha_inicio', { ascending: true });
      eventos = data || [];
      renderTabla();
    }

    // ── TIPO CHANGE ──
    document.getElementById('f-tipo').addEventListener('change', function() {
      const wrap = document.getElementById('wrap-seccion');
      if (this.value === 'seccion') {
        wrap.style.display = 'block';
      } else {
        wrap.style.display = 'none';
      }
    });

    // ── SECCIÓN CHANGE ──
    document.getElementById('f-seccion').addEventListener('change', function() {
      const opt = this.options[this.selectedIndex];
      document.getElementById('f-provincia').value = opt ? (opt.dataset.provincia || '') : '';
    });

    // ── TABLA ──
    function renderTabla() {
      const search = document.getElementById('search').value.toLowerCase();
      const est    = document.getElementById('filter-estado').value;
      const lista  = eventos.filter(e => {
        return e.titulo.toLowerCase().includes(search) &&
               (est === '' || String(e.activo) === est);
      });
      const tbody = document.getElementById('tabla-body');
      if (!lista.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No hay eventos</td></tr>';
        return;
      }
      tbody.innerHTML = lista.map(e => {
        const fecha = new Date(e.fecha_inicio).toLocaleDateString('es-ES', { day:'2-digit', month:'short', year:'numeric' });
        const hora  = new Date(e.fecha_inicio).toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit' });
        const badge = e.activo
          ? '<span class="bg-green-100 text-green-700 text-xs px-2 py-0.5 rounded-full">Publicado</span>'
          : '<span class="bg-gray-100 text-gray-500 text-xs px-2 py-0.5 rounded-full">Borrador</span>';
        return `<tr class="hover:bg-gray-50">
          <td class="px-4 py-3 font-medium text-gray-900">${e.titulo} <span class="text-xs text-gray-400">${e.tipo}</span></td>
          <td class="px-4 py-3 text-gray-500 text-xs">${fecha} ${hora}h</td>
          <td class="px-4 py-3 text-gray-500 text-xs">${e.lugar || '—'}</td>
          <td class="px-4 py-3"><button data-ver-inscritos="${e.id}" data-titulo="${e.titulo}" class="text-xs text-blue-700 hover:underline">Ver inscritos</button></td>
          <td class="px-4 py-3">${badge}</td>
          <td class="px-4 py-3 text-right space-x-2">
            <button data-toggle="${e.id}" data-activo="${e.activo}" class="text-xs px-2 py-1 border rounded hover:bg-gray-50 text-gray-600">${e.activo ? 'Despublicar' : 'Publicar'}</button>
            <button data-editar="${e.id}" class="text-xs px-2 py-1 bg-blue-900 text-white rounded hover:bg-blue-800">Editar</button>
            <button data-borrar="${e.id}" class="text-xs px-2 py-1 bg-red-100 text-red-600 rounded hover:bg-red-200">Borrar</button>
          </td>
        </tr>`;
      }).join('');
    }

    // Delegación de eventos en tabla
    document.getElementById('tabla-body').addEventListener('click', async e => {
      const btn = e.target.closest('button');
      if (!btn) return;
      if (btn.dataset.toggle) {
        const activo = btn.dataset.activo === 'true';
        await supabase.from('eventos').update({ activo: !activo }).eq('id', btn.dataset.toggle);
        await init();
      }
      if (btn.dataset.editar) editarEvento(btn.dataset.editar);
      if (btn.dataset.borrar) { borrandoId = btn.dataset.borrar; document.getElementById('modal-borrar').classList.remove('hidden'); }
      if (btn.dataset.verInscritos) verInscritos(btn.dataset.verInscritos, btn.dataset.titulo);
    });

    // ── MODAL ABRIR/CERRAR ──
    function resetForm() {
      document.getElementById('f-tipo').value = 'general';
      document.getElementById('wrap-seccion').style.display = 'none';
      document.getElementById('f-seccion').value = '';
      document.getElementById('f-provincia').value = '';
      ['f-titulo','f-titulo-ca','f-descripcion','f-lugar'].forEach(id => document.getElementById(id).value = '');
      document.getElementById('f-fecha-inicio').value = '';
      document.getElementById('f-fecha-fin').value = '';
      document.getElementById('f-aforo').value = '';
      document.getElementById('f-precio').value = '0';
      document.getElementById('f-activo').checked = false;
      document.getElementById('f-imagen-url').value = '';
      document.getElementById('f-imagen-url-input').value = '';
      document.getElementById('f-imagen-file').value = '';
      document.getElementById('form-error').classList.add('hidden');
      document.getElementById('form-ok').classList.add('hidden');
      uploadedImageUrl = null;
      document.getElementById('img-preview-wrap').classList.add('hidden');
      document.getElementById('upload-zone').classList.remove('hidden');
    }

    function abrirModal(titulo) {
      document.getElementById('modal-titulo').textContent = titulo;
      document.getElementById('modal').classList.remove('hidden');
    }
    function cerrarModal() { document.getElementById('modal').classList.add('hidden'); }

    document.getElementById('btn-nuevo').addEventListener('click', () => {
      resetForm(); editandoId = null; abrirModal('Nuevo evento');
    });
    document.getElementById('btn-cerrar-modal').addEventListener('click', cerrarModal);
    document.getElementById('btn-cancelar').addEventListener('click', cerrarModal);

    // ── EDITAR ──
    async function editarEvento(id) {
      const { data: e } = await supabase.from('eventos').select('*').eq('id', id).single();
      if (!e) return;
      editandoId = id;
      resetForm();
      document.getElementById('f-tipo').value       = e.tipo || 'general';
      document.getElementById('wrap-seccion').style.display = e.tipo === 'seccion' ? 'block' : 'none';
      document.getElementById('f-seccion').value    = e.seccion_id || '';
      if (e.seccion_id) {
        const sec = secciones.find(s => s.id === e.seccion_id);
        document.getElementById('f-provincia').value = sec?.provincia || '';
      }
      document.getElementById('f-titulo').value     = e.titulo || '';
      document.getElementById('f-titulo-ca').value  = e.titulo_ca || '';
      document.getElementById('f-descripcion').value= e.descripcion || '';
      document.getElementById('f-lugar').value      = e.lugar || '';
      document.getElementById('f-fecha-inicio').value = e.fecha_inicio ? toLocalInput(e.fecha_inicio) : '';
      document.getElementById('f-fecha-fin').value    = e.fecha_fin   ? toLocalInput(e.fecha_fin)   : '';
      document.getElementById('f-aforo').value      = e.plazas || '';
      document.getElementById('f-precio').value     = e.precio || 0;
      document.getElementById('f-activo').checked   = e.activo || false;
      uploadedImageUrl = e.imagen_url || null;
      if (e.imagen_url) {
        document.getElementById('f-imagen-url').value = e.imagen_url;
        document.getElementById('img-preview').src = e.imagen_url;
        document.getElementById('img-preview-wrap').classList.remove('hidden');
        document.getElementById('upload-zone').classList.add('hidden');
      }
      abrirModal('Editar evento');
    }

    // ── GUARDAR ──
    document.getElementById('btn-guardar').addEventListener('click', async () => {
      const titulo      = document.getElementById('f-titulo').value.trim();
      const fechaInicio = document.getElementById('f-fecha-inicio').value;
      if (!titulo || !fechaInicio) { mostrarError('Título y fecha de inicio son obligatorios.'); return; }

      const btn = document.getElementById('btn-guardar');
      btn.textContent = 'Guardando...'; btn.disabled = true;
      document.getElementById('form-error').classList.add('hidden');

      const tipoVal   = document.getElementById('f-tipo').value;
      const seccionId = document.getElementById('f-seccion').value || null;

      // Auto titulo_corto para sección
      let tituloCorto = null;
      if (tipoVal === 'seccion' && seccionId) {
        const sec = secciones.find(s => s.id === seccionId);
        if (sec) tituloCorto = `${sec.nombre} ${sec.provincia||''}`.trim().slice(0,20);
      }

      const datos = {
        titulo,
        titulo_ca:    document.getElementById('f-titulo-ca').value.trim() || null,
        titulo_corto: tituloCorto,
        descripcion:  document.getElementById('f-descripcion').value.trim() || null,
        lugar:        document.getElementById('f-lugar').value.trim() || null,
        tipo:         tipoVal,
        seccion_id:   seccionId,
        plazas:       document.getElementById('f-aforo').value ? parseInt(document.getElementById('f-aforo').value) : null,
        precio:       parseFloat(document.getElementById('f-precio').value) || 0,
        activo:       document.getElementById('f-activo').checked,
        fecha_inicio: fechaInicio,
        fecha_fin:    document.getElementById('f-fecha-fin').value || null,
        imagen_url:   uploadedImageUrl || document.getElementById('f-imagen-url').value || null,
      };

      let error;
      if (editandoId) {
        ({ error } = await supabase.from('eventos').update(datos).eq('id', editandoId));
      } else {
        ({ error } = await supabase.from('eventos').insert(datos));
      }

      btn.textContent = 'Guardar'; btn.disabled = false;
      if (error) { mostrarError('Error: ' + error.message); }
      else {
        document.getElementById('form-ok').textContent = editandoId ? 'Evento actualizado.' : 'Evento creado.';
        document.getElementById('form-ok').classList.remove('hidden');
        await init();
        setTimeout(() => cerrarModal(), 1200);
      }
    });

    // ── IMAGEN ──
    document.getElementById('tab-pc').addEventListener('click', () => {
      document.getElementById('panel-pc').classList.remove('hidden');
      document.getElementById('panel-url').classList.add('hidden');
      document.getElementById('tab-pc').className = 'px-4 py-2 text-sm font-medium bg-blue-900 text-white transition';
      document.getElementById('tab-url').className = 'px-4 py-2 text-sm font-medium bg-white text-gray-600 hover:bg-gray-50 transition';
    });
    document.getElementById('tab-url').addEventListener('click', () => {
      document.getElementById('panel-url').classList.remove('hidden');
      document.getElementById('panel-pc').classList.add('hidden');
      document.getElementById('tab-url').className = 'px-4 py-2 text-sm font-medium bg-blue-900 text-white transition';
      document.getElementById('tab-pc').className = 'px-4 py-2 text-sm font-medium bg-white text-gray-600 hover:bg-gray-50 transition';
    });
    document.getElementById('upload-zone').addEventListener('click', () => document.getElementById('f-imagen-file').click());
    document.getElementById('f-imagen-file').addEventListener('change', e => subirImagen(e.target.files[0]));
    document.getElementById('f-imagen-url-input').addEventListener('input', function() {
      uploadedImageUrl = this.value.startsWith('http') ? this.value : null;
      document.getElementById('f-imagen-url').value = uploadedImageUrl || '';
      if (uploadedImageUrl) {
        document.getElementById('img-preview').src = uploadedImageUrl;
        document.getElementById('img-preview-wrap').classList.remove('hidden');
      }
    });
    document.getElementById('btn-quitar-imagen').addEventListener('click', () => {
      uploadedImageUrl = null;
      document.getElementById('f-imagen-url').value = '';
      document.getElementById('f-imagen-url-input').value = '';
      document.getElementById('f-imagen-file').value = '';
      document.getElementById('img-preview-wrap').classList.add('hidden');
      document.getElementById('upload-zone').classList.remove('hidden');
    });

    async function subirImagen(file) {
      if (!file) return;
      if (!['image/jpeg','image/png','image/webp'].includes(file.type)) { mostrarError('Solo JPG, PNG o WebP.'); return; }
      if (file.size > 5*1024*1024) { mostrarError('Máximo 5 MB.'); return; }
      const reader = new FileReader();
      reader.onload = e => { document.getElementById('img-preview').src = e.target.result; document.getElementById('img-preview-wrap').classList.remove('hidden'); document.getElementById('upload-zone').classList.add('hidden'); };
      reader.readAsDataURL(file);
      const wrap = document.getElementById('upload-progress-wrap');
      const bar  = document.getElementById('upload-bar');
      const pct  = document.getElementById('upload-pct');
      document.getElementById('upload-filename').textContent = file.name;
      wrap.classList.remove('hidden'); bar.style.width='20%'; pct.textContent='20%';
      const ext  = file.name.split('.').pop();
      const nombre = `eventos/${Date.now()}-${Math.random().toString(36).slice(2)}.${ext}`;
      try {
        const { data, error } = await supabase.storage.from(BUCKET).upload(nombre, file, { cacheControl:'3600', upsert:false });
        if (error) throw error;
        bar.style.width='100%'; pct.textContent='✓';
        const { data: urlData } = supabase.storage.from(BUCKET).getPublicUrl(data.path);
        uploadedImageUrl = urlData.publicUrl;
        document.getElementById('f-imagen-url').value = uploadedImageUrl;
        setTimeout(() => wrap.classList.add('hidden'), 1500);
      } catch(err) { wrap.classList.add('hidden'); mostrarError('Error al subir: ' + err.message); }
    }

    // ── INSCRITOS ──
    async function verInscritos(eventoId, titulo) {
      document.getElementById('inscritos-titulo').textContent = `Inscritos — ${titulo}`;
      const { data } = await supabase
        .from('inscripciones')
        .select('id, estado, created_at, socio:socio_id(nombre, apellidos, email)')
        .eq('evento_id', eventoId).order('created_at');
      const lista = document.getElementById('inscritos-lista');
      lista.innerHTML = !data?.length
        ? '<p class="text-gray-400 text-sm">Sin inscripciones.</p>'
        : data.map(i => `
          <div class="flex items-center justify-between py-2 border-b border-gray-100 last:border-0">
            <div>
              <p class="text-sm font-medium text-gray-900">${i.socio?.nombre} ${i.socio?.apellidos}</p>
              <p class="text-xs text-gray-400">${i.socio?.email}</p>
            </div>
            <span class="text-xs px-2 py-0.5 rounded-full ${i.estado==='confirmada'?'bg-green-100 text-green-700':i.estado==='espera'?'bg-yellow-100 text-yellow-700':'bg-gray-100 text-gray-500'}">${i.estado}</span>
          </div>`).join('');
      document.getElementById('modal-inscritos').classList.remove('hidden');
    }
    document.getElementById('btn-cerrar-inscritos').addEventListener('click', () => document.getElementById('modal-inscritos').classList.add('hidden'));

    // ── BORRAR ──
    document.getElementById('btn-cancelar-borrar').addEventListener('click', () => { document.getElementById('modal-borrar').classList.add('hidden'); borrandoId = null; });
    document.getElementById('btn-confirmar-borrar').addEventListener('click', async () => {
      if (!borrandoId) return;
      await supabase.from('eventos').delete().eq('id', borrandoId);
      document.getElementById('modal-borrar').classList.add('hidden');
      borrandoId = null;
      await init();
    });

    // ── FILTROS ──
    document.getElementById('search').addEventListener('input', renderTabla);
    document.getElementById('filter-estado').addEventListener('change', renderTabla);

    function mostrarError(msg) {
      const el = document.getElementById('form-error');
      el.textContent = msg; el.classList.remove('hidden');
    }

    function toLocalInput(isoStr) {
      const d = new Date(isoStr);
      const pad = n => String(n).padStart(2, '0');
      return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()) +
             'T' + pad(d.getHours()) + ':' + pad(d.getMinutes());
    }

    init();
  </script>

</Layout>
