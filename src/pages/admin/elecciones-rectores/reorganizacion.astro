---
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="CRM Reorganización (BD) — Panel Admin">
  <div class="min-h-screen bg-gray-100">

    <div class="bg-blue-900 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-10 shadow">
      <div class="flex items-center gap-2">
        <a href="/admin"><span class="text-lg font-bold text-orange-400">la</span><span class="text-lg font-bold text-white">Soci</span></a>
        <span class="text-blue-400 text-xs hidden sm:block">| CRM Reorganización</span>
      </div>
      <a href="/admin/elecciones-rectores" class="text-xs text-blue-300 hover:text-white">&larr; Resumen</a>
    </div>

    <div class="max-w-6xl mx-auto px-3 py-6">

      <div id="loading" class="flex items-center justify-center py-20">
        <div class="text-center">
          <div class="w-8 h-8 border-4 border-orange-500 border-t-transparent rounded-full animate-spin mx-auto mb-3"></div>
          <p class="text-gray-500 text-sm">Cargando...</p>
        </div>
      </div>

      <div id="access-denied" class="hidden text-center py-20">
        <div class="text-5xl mb-4">🚫</div>
        <h2 class="text-lg font-bold text-gray-800 mb-2">Acceso denegado</h2>
        <p class="text-gray-400 text-sm">Esta sección es solo para administradores de Rectores.</p>
        <a href="/socios/dashboard" class="bg-orange-500 text-white px-5 py-2 rounded-xl text-sm font-medium hover:bg-orange-600 transition mt-3 inline-block">Ir al dashboard</a>
      </div>

      <div id="content" class="hidden space-y-5">

        <div class="bg-white rounded-xl shadow-sm p-4 flex items-center justify-between flex-wrap gap-2">
          <div>
            <p class="text-xs text-gray-400 uppercase tracking-wide">Escenario</p>
            <h2 class="font-bold text-gray-800" id="escenario-nombre">-</h2>
          </div>
          <div class="text-right">
            <p class="text-xs text-gray-400">Total rectores objetivo</p>
            <p class="text-2xl font-bold text-blue-900" id="escenario-total">-</p>
          </div>
        </div>

        <!-- Notas de estrategia -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-100">
            <h2 class="font-bold text-gray-800 text-sm">📝 Notas de estrategia</h2>
          </div>
          <div id="lista-notas" class="divide-y divide-gray-50"></div>
        </div>

        <!-- Propuestas por CCAA -->
        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
            <h2 class="font-bold text-gray-800 text-sm">Reparto propuesto por territorio</h2>
            <select id="f-ccaa" class="form-input px-3 py-1.5 border-2 border-orange-300 rounded-xl text-xs bg-white"><option value="">Todas las CCAA</option></select>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead>
                <tr class="bg-gray-50 text-left">
                  <th class="px-4 py-2 text-xs font-semibold text-gray-500">CCAA</th>
                  <th class="px-4 py-2 text-xs font-semibold text-gray-500">Territorio propuesto</th>
                  <th class="px-4 py-2 text-xs font-semibold text-gray-500">Socios estimados</th>
                  <th class="px-4 py-2 text-xs font-semibold text-gray-500">Rectores objetivo</th>
                  <th class="px-4 py-2 text-xs font-semibold text-gray-500">Ratio</th>
                </tr>
              </thead>
              <tbody id="tabla-prop" class="divide-y divide-gray-50">
                <tr><td colspan="5" class="px-4 py-6 text-center text-gray-400 text-sm">Cargando...</td></tr>
              </tbody>
            </table>
          </div>
          <div class="px-4 py-2 bg-gray-50 text-xs text-gray-500" id="total-row"></div>
        </div>

      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../../../lib/supabase.ts';

    let propuestas = [];

    async function init() {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) { window.location.href = '/socios/login'; return; }
      const { data: socio } = await supabase.from('socios').select('rol').eq('id', user.id).single();
      if (!socio || socio.rol !== 'admin') {
        document.getElementById('loading').classList.add('hidden');
        document.getElementById('access-denied').classList.remove('hidden');
        return;
      }
      await loadData();
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('content').classList.remove('hidden');
    }

    async function loadData() {
      const { data: escenario } = await supabase.from('escenarios').select('*').order('created_at', { ascending: false }).limit(1).single();
      if (!escenario) return;
      document.getElementById('escenario-nombre').textContent = `${escenario.nombre} (${escenario.estado})`;

      const { data: notas } = await supabase.from('notas_estrategia').select('*').eq('escenario_id', escenario.id).order('created_at');
      const colorCat = { 'Hallazgo': 'bg-blue-50 text-blue-700 border-blue-200', 'Regla': 'bg-purple-50 text-purple-700 border-purple-200', 'Decisión': 'bg-amber-50 text-amber-700 border-amber-200', 'Pendiente': 'bg-gray-50 text-gray-600 border-gray-200' };
      document.getElementById('lista-notas').innerHTML = (notas || []).map(n => `
        <div class="px-4 py-3">
          <span class="text-xs font-bold px-2 py-0.5 rounded-full border ${colorCat[n.categoria] || colorCat.Pendiente}">${n.categoria}</span>
          <p class="text-sm text-gray-700 mt-1.5">${n.texto}</p>
        </div>`).join('') || '<p class="px-4 py-6 text-center text-gray-400 text-sm">Sin notas</p>';

      const { data: props } = await supabase
        .from('territorios_propuestos')
        .select('id, nombre, socios_estimados, rectores_objetivo, ccaa(id, nombre)')
        .eq('escenario_id', escenario.id)
        .order('rectores_objetivo', { ascending: false });
      propuestas = props || [];

      const total = propuestas.reduce((s, p) => s + p.rectores_objetivo, 0);
      document.getElementById('escenario-total').textContent = total;

      const selCcaa = document.getElementById('f-ccaa');
      const ccaaUnicas = [...new Map(propuestas.map(p => [p.ccaa.id, p.ccaa.nombre])).entries()];
      ccaaUnicas.sort((a, b) => a[1].localeCompare(b[1])).forEach(([id, nombre]) => selCcaa.insertAdjacentHTML('beforeend', `<option value="${id}">${nombre}</option>`));
      selCcaa.addEventListener('change', render);

      render();
    }

    function render() {
      const fCcaa = document.getElementById('f-ccaa').value;
      const filtradas = propuestas.filter(p => !fCcaa || p.ccaa.id === fCcaa);

      document.getElementById('tabla-prop').innerHTML = filtradas.map((p, i) => {
        const ratio = p.rectores_objetivo > 0 ? Math.round(p.socios_estimados / p.rectores_objetivo) : 0;
        return `<tr class="${i % 2 === 0 ? 'bg-white' : 'bg-gray-50'}">
          <td class="px-4 py-2.5 text-gray-500 text-xs">${p.ccaa.nombre}</td>
          <td class="px-4 py-2.5 font-medium text-gray-700">${p.nombre}</td>
          <td class="px-4 py-2.5 text-gray-600">${p.socios_estimados.toLocaleString('es-ES')}</td>
          <td class="px-4 py-2.5 font-bold text-blue-900">${p.rectores_objetivo}</td>
          <td class="px-4 py-2.5 text-xs text-gray-500">${ratio} socios/rector</td>
        </tr>`;
      }).join('');

      const totalRect = filtradas.reduce((s, p) => s + p.rectores_objetivo, 0);
      document.getElementById('total-row').textContent = `${filtradas.length} territorios · ${totalRect} rectores`;
    }

    init();
  </script>
</Layout>
