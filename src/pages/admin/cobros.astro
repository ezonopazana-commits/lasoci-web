---
import Layout from '../../layouts/Layout.astro';
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL ?? '';
const supabaseKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY ?? '';
const resendKey   = import.meta.env.RESEND_API_KEY ?? '';
---

<Layout title="Módulo Cobros/Abonos — Admin la Soci">
<div class="min-h-screen bg-gray-100">

  <!-- TOP BAR -->
  <div class="bg-blue-900 text-white px-4 py-3 flex items-center justify-between sticky top-0 z-10 shadow">
    <div class="flex items-center gap-2">
      <a href="/"><span class="text-lg font-bold text-orange-400">la</span><span class="text-lg font-bold">Soci</span></a>
      <span class="text-blue-400 text-xs hidden sm:block">| Cobros y Abonos</span>
    </div>
    <div class="flex items-center gap-3">
      <a href="/admin" class="text-xs text-blue-300 hover:text-white">← Panel Admin</a>
      <button id="btn-logout" class="text-xs bg-blue-800 hover:bg-blue-700 px-3 py-1.5 rounded-lg">Salir</button>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-3 py-6">
    <div id="loading" class="flex justify-center py-20">
      <div class="w-8 h-8 border-4 border-orange-500 border-t-transparent rounded-full animate-spin"></div>
    </div>
    <div id="access-denied" class="hidden text-center py-20">
      <div class="text-5xl mb-4">🚫</div>
      <a href="/socios/dashboard" class="bg-orange-500 text-white px-5 py-2 rounded-xl text-sm">Ir al dashboard</a>
    </div>

    <div id="content" class="hidden space-y-6">

      <!-- Tabs -->
      <div class="flex gap-2 bg-white rounded-xl shadow-sm p-2">
        <button onclick="setTab('pendientes')" id="tab-pendientes" class="tab-btn flex-1 py-2 rounded-lg text-sm font-medium bg-blue-900 text-white transition">💳 Pendientes</button>
        <button onclick="setTab('generar')" id="tab-generar" class="tab-btn flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition">⚙️ Generar remesa</button>
        <button onclick="setTab('csb')" id="tab-csb" class="tab-btn flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition">📄 Fichero CSB</button>
        <button onclick="setTab('sepa')" id="tab-sepa" class="tab-btn flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition">🏦 SEPA XML</button>
        <button onclick="setTab('historial')" id="tab-historial" class="tab-btn flex-1 py-2 rounded-lg text-sm font-medium text-gray-500 hover:bg-gray-50 transition">📋 Historial</button>
      </div>

      <!-- ══ PANEL PENDIENTES ══ -->
      <div id="panel-pendientes" class="space-y-4">
        <div class="grid grid-cols-3 gap-3">
          <div class="bg-white rounded-xl shadow-sm p-4 text-center">
            <p class="text-xs text-gray-400 mb-1">Cargos pendientes</p>
            <p class="text-2xl font-bold text-red-500" id="stat-cargos">-</p>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-4 text-center">
            <p class="text-xs text-gray-400 mb-1">Abonos pendientes</p>
            <p class="text-2xl font-bold text-green-600" id="stat-abonos">-</p>
          </div>
          <div class="bg-white rounded-xl shadow-sm p-4 text-center">
            <p class="text-xs text-gray-400 mb-1">Total importe</p>
            <p class="text-2xl font-bold text-blue-900" id="stat-total">-</p>
          </div>
        </div>

        <div class="bg-white rounded-xl shadow-sm overflow-hidden">
          <div class="px-4 py-3 border-b border-gray-100 flex items-center justify-between">
            <h3 class="font-bold text-gray-800 text-sm">Operaciones pendientes</h3>
            <div class="flex gap-2">
              <button onclick="seleccionarTodos()" class="text-xs text-blue-600 hover:underline">Seleccionar todos</button>
              <button onclick="enviarEmails()" class="text-xs bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg transition">📧 Notificar seleccionados</button>
            </div>
          </div>
          <table class="w-full text-sm">
            <thead class="bg-gray-50 border-b border-gray-100">
              <tr>
                <th class="px-4 py-3 w-8"><input type="checkbox" id="chk-all" onchange="toggleAll(this)" /></th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Socio</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase hidden md:table-cell">Concepto</th>
                <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Tipo</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Importe</th>
                <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Acciones</th>
              </tr>
            </thead>
            <tbody id="tabla-pendientes" class="divide-y divide-gray-50"></tbody>
          </table>
        </div>
      </div>

      <!-- ══ PANEL GENERAR ══ -->
      <div id="panel-generar" class="hidden bg-white rounded-xl shadow-sm p-6 space-y-5">
        <h3 class="font-bold text-gray-800">Generar cargos/abonos por evento</h3>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-gray-500 block mb-1">Seleccionar evento</label>
            <select id="gen-evento" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="">-- Selecciona un evento --</option>
            </select>
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">Tipo de operación</label>
            <select id="gen-tipo" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
              <option value="cargo">💳 Cargo — coste total del evento</option>
              <option value="abono">💰 Abono — subvención correspondiente</option>
            </select>
          </div>
        </div>

        <!-- Preview evento seleccionado -->
        <div id="gen-preview" class="hidden bg-blue-50 border border-blue-200 rounded-xl p-4 text-sm space-y-2">
          <div class="grid grid-cols-2 md:grid-cols-4 gap-3 text-center">
            <div><p class="text-xs text-gray-400">Evento</p><p class="font-bold text-gray-800" id="prev-titulo">-</p></div>
            <div><p class="text-xs text-gray-400">Inscritos</p><p class="font-bold text-blue-900" id="prev-inscritos">-</p></div>
            <div><p class="text-xs text-gray-400">Precio/socio</p><p class="font-bold text-gray-800" id="prev-precio">-</p></div>
            <div><p class="text-xs text-gray-400">Total remesa</p><p class="font-bold text-orange-600" id="prev-total">-</p></div>
          </div>
        </div>

        <div id="gen-inscritos-lista" class="hidden">
          <h4 class="text-sm font-semibold text-gray-600 mb-3">Socios a incluir en la remesa</h4>
          <div id="gen-tabla" class="border border-gray-200 rounded-xl overflow-hidden">
            <table class="w-full text-sm">
              <thead class="bg-gray-50">
                <tr>
                  <th class="px-4 py-2 text-left text-xs text-gray-500">Socio</th>
                  <th class="px-4 py-2 text-left text-xs text-gray-500 hidden md:table-cell">IBAN</th>
                  <th class="px-4 py-2 text-right text-xs text-gray-500">Importe</th>
                  <th class="px-4 py-2 text-center text-xs text-gray-500">IBAN OK</th>
                </tr>
              </thead>
              <tbody id="gen-tbody" class="divide-y divide-gray-50"></tbody>
            </table>
          </div>
        </div>

        <div class="flex gap-3">
          <button onclick="generarOperaciones()" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2.5 rounded-xl text-sm font-semibold transition">
            ⚙️ Generar operaciones
          </button>
          <button onclick="generarYNotificar()" class="bg-blue-600 hover:bg-blue-700 text-white px-6 py-2.5 rounded-xl text-sm font-semibold transition">
            ⚙️ Generar + notificar por email
          </button>
        </div>
        <p id="gen-msg" class="hidden text-sm"></p>
      </div>

      <!-- ══ PANEL CSB ══ -->
      <div id="panel-csb" class="hidden bg-white rounded-xl shadow-sm p-6 space-y-5">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-bold text-gray-800 mb-1">Exportar fichero CSB 34</h3>
            <p class="text-sm text-gray-500">Formato normativo para envío de remesas de cobros/abonos al banco.</p>
          </div>
          <button onclick="exportarCSB()" class="bg-blue-900 hover:bg-blue-800 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition">
            📥 Descargar CSB34
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-gray-500 block mb-1">Ordenante (nombre empresa)</label>
            <input id="csb-ordenante" value="ASSOCIACIÓ DEL PERSONAL DE LA CAIXA" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">IBAN ordenante</label>
            <input id="csb-iban" placeholder="ES00 0000 0000 0000 0000 0000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono uppercase" />
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">Fecha de cargo</label>
            <input id="csb-fecha" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">Tipo de registro</label>
            <select id="csb-tipo-reg" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm">
              <option value="cargo">Solo cargos</option>
              <option value="abono">Solo abonos</option>
              <option value="todos">Todos</option>
            </select>
          </div>
        </div>
        <div id="csb-preview" class="bg-gray-900 text-green-400 font-mono text-xs p-4 rounded-xl overflow-x-auto max-h-48 hidden">
          <p class="text-gray-500 mb-2">-- Preview fichero CSB34 --</p>
          <pre id="csb-content"></pre>
        </div>
        <button onclick="previewCSB()" class="text-xs text-blue-600 hover:underline">👁 Ver preview del fichero</button>
      </div>

      <!-- ══ PANEL SEPA ══ -->
      <div id="panel-sepa" class="hidden bg-white rounded-xl shadow-sm p-6 space-y-5">
        <div class="flex items-start justify-between">
          <div>
            <h3 class="font-bold text-gray-800 mb-1">Exportar fichero SEPA XML (pain.008)</h3>
            <p class="text-sm text-gray-500">Formato estándar europeo para domiciliaciones SEPA Direct Debit.</p>
          </div>
          <button onclick="exportarSEPA()" class="bg-purple-700 hover:bg-purple-800 text-white px-5 py-2.5 rounded-xl text-sm font-semibold transition">
            📥 Descargar SEPA XML
          </button>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <div>
            <label class="text-xs text-gray-500 block mb-1">Creditor Name</label>
            <input id="sepa-nombre" value="ASSOCIACIÓ DEL PERSONAL DE LA CAIXA" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">Creditor IBAN</label>
            <input id="sepa-iban" placeholder="ES00 0000 0000 0000 0000 0000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono uppercase" />
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">Creditor Identifier (CI)</label>
            <input id="sepa-ci" placeholder="ES00ZZZ000000000" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm font-mono uppercase" />
          </div>
          <div>
            <label class="text-xs text-gray-500 block mb-1">Fecha de cobro</label>
            <input id="sepa-fecha" type="date" class="w-full px-3 py-2 border border-gray-300 rounded-lg text-sm" />
          </div>
        </div>
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-800">
          ⚠️ Para domiciliaciones SEPA es necesario disponer del <strong>mandato firmado</strong> por cada socio. El IBAN registrado en el perfil se usa como cuenta de domiciliación.
        </div>
      </div>

      <!-- ══ PANEL HISTORIAL ══ -->
      <div id="panel-historial" class="hidden bg-white rounded-xl shadow-sm overflow-hidden">
        <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-3">
          <h3 class="font-bold text-gray-800 text-sm">Historial de operaciones</h3>
          <select id="hist-filtro" class="ml-auto text-xs border border-gray-200 rounded-lg px-2 py-1">
            <option value="">Todos</option>
            <option value="pendiente">Pendientes</option>
            <option value="procesado">Procesados</option>
            <option value="cargo">Cargos</option>
            <option value="abono">Abonos</option>
          </select>
        </div>
        <table class="w-full text-sm">
          <thead class="bg-gray-50 border-b border-gray-100">
            <tr>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Socio</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase hidden md:table-cell">Concepto</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Tipo</th>
              <th class="text-right px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Importe</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase hidden md:table-cell">Fecha</th>
              <th class="text-left px-4 py-3 text-xs font-semibold text-gray-500 uppercase">Estado</th>
            </tr>
          </thead>
          <tbody id="tabla-historial" class="divide-y divide-gray-50"></tbody>
        </table>
      </div>

    </div>
  </div>
</div>

<script define:vars={{ supabaseUrl, supabaseKey, resendKey }}>
  window.__SB_URL = supabaseUrl;
  window.__SB_KEY = supabaseKey;
  window.__RESEND = resendKey;
</script>
<script type="module">
  import { createClient } from 'https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2/+esm';
  const db = createClient(window.__SB_URL, window.__SB_KEY);

  let operaciones = [];
  let eventos = [];
  let eventoSeleccionado = null;
  let inscritosEvento = [];

  // ── INIT ──
  async function init() {
    const { data: { session } } = await db.auth.getSession();
    if (!session) { window.location.href = '/socios/login'; return; }
    const { data: socio } = await db.from('socios').select('rol').eq('id', session.user.id).single();
    if (!socio || socio.rol !== 'admin') {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('access-denied').classList.remove('hidden');
      return;
    }
    await Promise.all([cargarOperaciones(), cargarEventos()]);
    document.getElementById('loading').classList.add('hidden');
    document.getElementById('content').classList.remove('hidden');

    // Fecha por defecto hoy
    const hoy = new Date().toISOString().split('T')[0];
    document.getElementById('csb-fecha').value = hoy;
    document.getElementById('sepa-fecha').value = hoy;
  }

  async function cargarOperaciones() {
    const { data } = await db.from('cobros_abonos')
      .select('*, socio:socio_id(nombre, apellidos, email)')
      .order('created_at', { ascending: false });
    operaciones = data || [];
    actualizarStats();
    renderPendientes();
    renderHistorial();
  }

  async function cargarEventos() {
    const { data } = await db.from('eventos').select('id, titulo, precio, fecha_inicio').eq('activo', true).order('fecha_inicio', { ascending: false });
    eventos = data || [];
    const sel = document.getElementById('gen-evento');
    eventos.forEach(e => {
      const o = document.createElement('option');
      o.value = e.id;
      o.textContent = `${e.titulo} — ${new Date(e.fecha_inicio).toLocaleDateString('es-ES')}`;
      sel.appendChild(o);
    });
    sel.addEventListener('change', onEventoChange);
  }

  async function onEventoChange() {
    const id = document.getElementById('gen-evento').value;
    eventoSeleccionado = eventos.find(e => e.id === id) || null;
    if (!eventoSeleccionado) { document.getElementById('gen-preview').classList.add('hidden'); document.getElementById('gen-inscritos-lista').classList.add('hidden'); return; }

    const { data: inscritos } = await db.from('inscripciones')
      .select('socio:socio_id(id, nombre, apellidos, email, iban, subvencion_disponible)')
      .eq('evento_id', id).eq('estado', 'confirmada');
    inscritosEvento = (inscritos || []).map(i => i.socio).filter(Boolean);

    const tipo = document.getElementById('gen-tipo').value;
    const precio = Number(eventoSeleccionado.precio) || 0;
    const subvPorSocio = Math.min(precio * 0.3, 50); // ejemplo: 30% subvencionado hasta 50€
    const importeOp = tipo === 'cargo' ? precio : subvPorSocio;

    document.getElementById('prev-titulo').textContent = eventoSeleccionado.titulo;
    document.getElementById('prev-inscritos').textContent = inscritosEvento.length;
    document.getElementById('prev-precio').textContent = importeOp.toFixed(2) + ' €';
    document.getElementById('prev-total').textContent = (importeOp * inscritosEvento.length).toFixed(2) + ' €';
    document.getElementById('gen-preview').classList.remove('hidden');

    document.getElementById('gen-tbody').innerHTML = inscritosEvento.map((s, i) => {
      const ibanOk = s.iban && s.iban.length >= 20;
      const ibanMask = s.iban ? s.iban.replace(/\s/g,'').substring(0,4) + ' **** **** **** ' + s.iban.replace(/\s/g,'').slice(-4) : '—';
      return `<tr class="${i%2===0?'bg-white':'bg-gray-50'} hover:bg-orange-50 transition-colors">
        <td class="px-4 py-2">${s.apellidos}, ${s.nombre}</td>
        <td class="px-4 py-2 font-mono text-xs hidden md:table-cell">${ibanMask}</td>
        <td class="px-4 py-2 text-right font-semibold">${importeOp.toFixed(2)} €</td>
        <td class="px-4 py-2 text-center">${ibanOk ? '✅' : '<span class="text-red-500 text-xs">❌ Sin IBAN</span>'}</td>
      </tr>`;
    }).join('');
    document.getElementById('gen-inscritos-lista').classList.remove('hidden');
  }

  document.getElementById('gen-tipo').addEventListener('change', () => { if (eventoSeleccionado) onEventoChange(); });

  // ── STATS ──
  function actualizarStats() {
    const pendientes = operaciones.filter(o => o.estado === 'pendiente');
    const cargos = pendientes.filter(o => o.tipo === 'cargo').reduce((s, o) => s + Number(o.importe), 0);
    const abonos = pendientes.filter(o => o.tipo === 'abono').reduce((s, o) => s + Number(o.importe), 0);
    document.getElementById('stat-cargos').textContent = pendientes.filter(o => o.tipo === 'cargo').length;
    document.getElementById('stat-abonos').textContent = pendientes.filter(o => o.tipo === 'abono').length;
    document.getElementById('stat-total').textContent = (cargos + abonos).toFixed(2) + ' €';
  }

  // ── RENDER PENDIENTES ──
  function renderPendientes() {
    const lista = operaciones.filter(o => o.estado === 'pendiente');
    const tbody = document.getElementById('tabla-pendientes');
    if (!lista.length) { tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400 text-sm">No hay operaciones pendientes</td></tr>'; return; }
    tbody.innerHTML = lista.map(o => `
      <tr class="even:bg-gray-50 hover:bg-orange-50 transition-colors">
        <td class="px-4 py-3"><input type="checkbox" class="chk-op" data-id="${o.id}" /></td>
        <td class="px-4 py-3"><p class="font-medium text-gray-800">${o.socio?.apellidos}, ${o.socio?.nombre}</p><p class="text-xs text-gray-400">${o.socio?.email}</p></td>
        <td class="px-4 py-3 text-gray-500 hidden md:table-cell text-xs">${o.descripcion || '—'}</td>
        <td class="px-4 py-3"><span class="text-xs px-2 py-1 rounded-full font-medium ${o.tipo === 'cargo' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'}">${o.tipo === 'cargo' ? '💳 Cargo' : '💰 Abono'}</span></td>
        <td class="px-4 py-3 text-right font-bold ${o.tipo === 'cargo' ? 'text-red-600' : 'text-green-600'}">${Number(o.importe).toFixed(2)} €</td>
        <td class="px-4 py-3 text-right">
          <button onclick="marcarProcesado('${o.id}')" class="text-xs bg-gray-100 hover:bg-gray-200 text-gray-600 px-3 py-1.5 rounded-lg mr-1">✓ Procesado</button>
          <button onclick="enviarEmailUno('${o.id}')" class="text-xs bg-blue-50 hover:bg-blue-100 text-blue-600 px-3 py-1.5 rounded-lg">📧</button>
        </td>
      </tr>`).join('');
  }

  // ── RENDER HISTORIAL ──
  function renderHistorial(filtro = '') {
    let lista = operaciones;
    if (filtro === 'pendiente') lista = lista.filter(o => o.estado === 'pendiente');
    else if (filtro === 'procesado') lista = lista.filter(o => o.estado === 'procesado');
    else if (filtro === 'cargo') lista = lista.filter(o => o.tipo === 'cargo');
    else if (filtro === 'abono') lista = lista.filter(o => o.tipo === 'abono');

    const tbody = document.getElementById('tabla-historial');
    if (!lista.length) { tbody.innerHTML = '<tr><td colspan="6" class="text-center py-8 text-gray-400 text-sm">No hay operaciones</td></tr>'; return; }
    tbody.innerHTML = lista.map(o => `
      <tr class="hover:bg-gray-50 text-sm">
        <td class="px-4 py-3"><p class="font-medium text-gray-800">${o.socio?.apellidos || ''}, ${o.socio?.nombre || ''}</p></td>
        <td class="px-4 py-3 text-gray-500 hidden md:table-cell text-xs truncate max-w-xs">${o.descripcion || '—'}</td>
        <td class="px-4 py-3"><span class="text-xs px-2 py-1 rounded-full ${o.tipo === 'cargo' ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'}">${o.tipo === 'cargo' ? 'Cargo' : 'Abono'}</span></td>
        <td class="px-4 py-3 text-right font-bold ${o.tipo === 'cargo' ? 'text-red-600' : 'text-green-600'}">${Number(o.importe).toFixed(2)} €</td>
        <td class="px-4 py-3 text-xs text-gray-400 hidden md:table-cell">${new Date(o.created_at).toLocaleDateString('es-ES')}</td>
        <td class="px-4 py-3"><span class="text-xs px-2 py-1 rounded-full ${o.estado === 'procesado' ? 'bg-green-100 text-green-700' : o.estado === 'error' ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}">${o.estado}</span></td>
      </tr>`).join('');
  }

  document.getElementById('hist-filtro').addEventListener('change', e => renderHistorial(e.target.value));

  // ── GENERAR OPERACIONES ──
  window.generarOperaciones = async function(notificar = false) {
    if (!eventoSeleccionado || !inscritosEvento.length) return;
    const tipo = document.getElementById('gen-tipo').value;
    const precio = Number(eventoSeleccionado.precio) || 0;
    const subvPorSocio = Math.min(precio * 0.3, 50);
    const importe = tipo === 'cargo' ? precio : subvPorSocio;
    const descripcion = `${tipo === 'cargo' ? 'Cargo' : 'Abono subvención'}: ${eventoSeleccionado.titulo}`;

    const rows = inscritosEvento.filter(s => s.iban).map(s => ({
      socio_id: s.id, evento_id: eventoSeleccionado.id, tipo, importe,
      iban: s.iban, descripcion, estado: 'pendiente'
    }));

    if (!rows.length) { mostrarMsg('gen-msg', '❌ Ningún socio tiene IBAN registrado.', 'red'); return; }

    const { error } = await db.from('cobros_abonos').insert(rows);
    if (error) { mostrarMsg('gen-msg', '❌ Error: ' + error.message, 'red'); return; }

    // Actualizar subvención disponible si es abono
    if (tipo === 'abono') {
      for (const s of inscritosEvento) {
        const nueva = Math.max(0, (s.subvencion_disponible ?? 400) - subvPorSocio);
        await db.from('socios').update({ subvencion_disponible: nueva }).eq('id', s.id);
        // Registrar en subvenciones_detalle
        await db.from('subvenciones_detalle').insert({
          socio_id: s.id, evento_id: eventoSeleccionado.id,
          fecha: new Date().toISOString().split('T')[0],
          descripcion: eventoSeleccionado.titulo,
          importe_total: precio, importe_subvencionado: subvPorSocio,
          anio: new Date().getFullYear()
        });
      }
    }

    if (notificar) await enviarEmailsMasivo(rows, inscritosEvento, tipo, importe, descripcion);

    mostrarMsg('gen-msg', `✅ ${rows.length} operaciones generadas correctamente.`, 'green');
    await cargarOperaciones();
  };

  window.generarYNotificar = () => generarOperaciones(true);

  // ── EMAIL ──
  async function enviarEmailsMasivo(rows, socios, tipo, importe, descripcion) {
    const promises = socios.filter(s => s.email && s.iban).map(s =>
      enviarEmailNotificacion(s.email, s.nombre, tipo, importe, descripcion)
    );
    await Promise.allSettled(promises);
  }

  async function enviarEmailNotificacion(email, nombre, tipo, importe, descripcion) {
    try {
      await fetch('https://api.resend.com/emails', {
        method: 'POST',
        headers: { 'Authorization': `Bearer ${window.__RESEND}`, 'Content-Type': 'application/json' },
        body: JSON.stringify({
          from: 'la Soci <noreply@lasoci.pages.dev>',
          to: [email],
          subject: tipo === 'cargo' ? `la Soci — Cargo por ${descripcion}` : `la Soci — Abono subvención: ${descripcion}`,
          html: `<div style="font-family:Arial,sans-serif;max-width:520px;margin:0 auto;padding:24px;">
            <div style="background:#1e3a8a;color:white;padding:20px 24px;border-radius:12px 12px 0 0;">
              <span style="font-size:20px;font-weight:bold;color:#fb923c;">la</span>
              <span style="font-size:20px;font-weight:bold;">Soci</span>
            </div>
            <div style="background:white;border:1px solid #e5e7eb;padding:24px;border-radius:0 0 12px 12px;">
              <p style="color:#374151;">Hola <strong>${nombre}</strong>,</p>
              <p style="color:#374151;">Te informamos de la siguiente operación en tu cuenta:</p>
              <div style="background:${tipo === 'cargo' ? '#fef2f2' : '#f0fdf4'};border:1px solid ${tipo === 'cargo' ? '#fecaca' : '#bbf7d0'};border-radius:8px;padding:16px;margin:16px 0;text-align:center;">
                <p style="font-size:24px;font-weight:bold;color:${tipo === 'cargo' ? '#dc2626' : '#16a34a'};margin:0;">${tipo === 'cargo' ? '−' : '+'}${Number(importe).toFixed(2)} €</p>
                <p style="color:#6b7280;margin:4px 0 0;">${tipo === 'cargo' ? '💳 Cargo' : '💰 Abono subvención'}</p>
              </div>
              <p style="color:#374151;"><strong>Concepto:</strong> ${descripcion}</p>
              <p style="color:#9ca3af;font-size:12px;margin-top:24px;">Este es un mensaje automático de la Soci. Por favor no respondas a este email.</p>
            </div>
          </div>`
        })
      });
    } catch(e) { console.error('Email error:', e); }
  }

  window.enviarEmailUno = async function(id) {
    const op = operaciones.find(o => o.id === id);
    if (!op || !op.socio?.email) return;
    await enviarEmailNotificacion(op.socio.email, op.socio.nombre, op.tipo, op.importe, op.descripcion || 'Operación la Soci');
    alert('Email enviado a ' + op.socio.email);
  };

  window.enviarEmails = async function() {
    const seleccionados = [...document.querySelectorAll('.chk-op:checked')].map(c => c.dataset.id);
    if (!seleccionados.length) { alert('Selecciona al menos una operación.'); return; }
    const ops = operaciones.filter(o => seleccionados.includes(o.id));
    for (const op of ops) {
      if (op.socio?.email) await enviarEmailNotificacion(op.socio.email, op.socio.nombre, op.tipo, op.importe, op.descripcion || 'Operación la Soci');
    }
    alert(`${ops.length} emails enviados.`);
  };

  // ── MARCAR PROCESADO ──
  window.marcarProcesado = async function(id) {
    await db.from('cobros_abonos').update({ estado: 'procesado', procesado_at: new Date().toISOString() }).eq('id', id);
    await cargarOperaciones();
  };

  // ── SELECCIONAR TODOS ──
  window.seleccionarTodos = function() {
    document.querySelectorAll('.chk-op').forEach(c => c.checked = true);
    document.getElementById('chk-all').checked = true;
  };
  window.toggleAll = function(chk) {
    document.querySelectorAll('.chk-op').forEach(c => c.checked = chk.checked);
  };

  // ── CSB 34 ──
  function generarCSB34(ops, ordenante, ibanOrdenante, fecha) {
    const fmtFecha = fecha.replace(/-/g,'').slice(2); // YYMMDD
    const fmtFechaLarga = fecha.replace(/-/g,''); // YYYYMMDD
    const nifOrdenante = '00000000000'; // pendiente configuración real
    const ibanLimpio = ibanOrdenante.replace(/\s/g,'');

    let lineas = [];
    // Registro cabecera (tipo 03)
    lineas.push(('03' + ordenante.padEnd(40).substring(0,40) + nifOrdenante + fmtFecha + '0' + '0' + ' '.repeat(20)).substring(0, 80));

    let sumImportes = 0;
    ops.forEach((op, idx) => {
      const importe = Math.round(Number(op.importe) * 100);
      sumImportes += importe;
      const ibanSocio = (op.iban || '').replace(/\s/g,'').padEnd(24).substring(0,24);
      const nombre = ((op.socio?.apellidos || '') + ' ' + (op.socio?.nombre || '')).padEnd(40).substring(0,40);
      const ref = String(idx + 1).padStart(10, '0');
      const imp = String(importe).padStart(12, '0');
      // Registro detalle (tipo 06 cargo / 03 abono)
      lineas.push(('06' + ref + ibanSocio + nombre + imp + ' '.repeat(10)).substring(0, 80));
    });

    // Registro total (tipo 08)
    const total = String(sumImportes).padStart(12,'0');
    lineas.push(('08' + String(ops.length).padStart(10,'0') + total + ' '.repeat(58)).substring(0,80));

    return lineas.join('\r\n');
  }

  window.previewCSB = function() {
    const ops = operaciones.filter(o => o.estado === 'pendiente');
    const tipofil = document.getElementById('csb-tipo-reg').value;
    const filtradas = tipofil === 'todos' ? ops : ops.filter(o => o.tipo === tipofil);
    const csb = generarCSB34(filtradas, document.getElementById('csb-ordenante').value, document.getElementById('csb-iban').value, document.getElementById('csb-fecha').value);
    document.getElementById('csb-content').textContent = csb;
    document.getElementById('csb-preview').classList.remove('hidden');
  };

  window.exportarCSB = function() {
    const ops = operaciones.filter(o => o.estado === 'pendiente');
    const tipofil = document.getElementById('csb-tipo-reg').value;
    const filtradas = tipofil === 'todos' ? ops : ops.filter(o => o.tipo === tipofil);
    const csb = generarCSB34(filtradas, document.getElementById('csb-ordenante').value, document.getElementById('csb-iban').value, document.getElementById('csb-fecha').value);
    descargar(csb, `remesa_csb34_${document.getElementById('csb-fecha').value}.txt`, 'text/plain');
  };

  // ── SEPA XML ──
  window.exportarSEPA = function() {
    const ops = operaciones.filter(o => o.estado === 'pendiente' && o.tipo === 'cargo');
    if (!ops.length) { alert('No hay cargos pendientes.'); return; }
    const nombre = document.getElementById('sepa-nombre').value;
    const iban = document.getElementById('sepa-iban').value.replace(/\s/g,'');
    const ci = document.getElementById('sepa-ci').value;
    const fecha = document.getElementById('sepa-fecha').value;
    const msgId = `LASOCI${Date.now()}`;
    const total = ops.reduce((s,o) => s + Number(o.importe), 0).toFixed(2);

    const txns = ops.map((op, i) => {
      const ibanSocio = (op.iban || '').replace(/\s/g,'');
      const nomSocio = `${op.socio?.apellidos || ''} ${op.socio?.nombre || ''}`.trim();
      return `<DrctDbtTxInf>
        <PmtId><EndToEndId>LASOCI${i+1}</EndToEndId></PmtId>
        <InstdAmt Ccy="EUR">${Number(op.importe).toFixed(2)}</InstdAmt>
        <DrctDbtTx><MndtRltdInf><MndtId>MNDTLASOCI${i+1}</MndtId><DtOfSgntr>${fecha}</DtOfSgntr></MndtRltdInf></DrctDbtTx>
        <DbtrAgt><FinInstnId><BICFI>CAIXESBB</BICFI></FinInstnId></DbtrAgt>
        <Dbtr><Nm>${nomSocio}</Nm></Dbtr>
        <DbtrAcct><Id><IBAN>${ibanSocio}</IBAN></Id></DbtrAcct>
        <Purp><Cd>OTHR</Cd></Purp>
        <RmtInf><Ustrd>${op.descripcion || 'Cargo la Soci'}</Ustrd></RmtInf>
      </DrctDbtTxInf>`;
    }).join('\n');

    const xml = `<?xml version="1.0" encoding="UTF-8"?>
<Document xmlns="urn:iso:std:iso:20022:tech:xsd:pain.008.001.02">
  <CstmrDrctDbtInitn>
    <GrpHdr>
      <MsgId>${msgId}</MsgId>
      <CreDtTm>${new Date().toISOString().slice(0,19)}</CreDtTm>
      <NbOfTxs>${ops.length}</NbOfTxs>
      <CtrlSum>${total}</CtrlSum>
      <InitgPty><Nm>${nombre}</Nm></InitgPty>
    </GrpHdr>
    <PmtInf>
      <PmtInfId>${msgId}PMT</PmtInfId>
      <PmtMtd>DD</PmtMtd>
      <NbOfTxs>${ops.length}</NbOfTxs>
      <CtrlSum>${total}</CtrlSum>
      <PmtTpInf><SvcLvl><Cd>SEPA</Cd></SvcLvl><LclInstrm><Cd>CORE</Cd></LclInstrm><SeqTp>FRST</SeqTp></PmtTpInf>
      <ReqdColltnDt>${fecha}</ReqdColltnDt>
      <Cdtr><Nm>${nombre}</Nm></Cdtr>
      <CdtrAcct><Id><IBAN>${iban}</IBAN></Id></CdtrAcct>
      <CdtrAgt><FinInstnId><BICFI>CAIXESBB</BICFI></FinInstnId></CdtrAgt>
      <CdtrSchmeId><Id><PrvtId><Othr><Id>${ci}</Id><SchmeNm><Prtry>SEPA</Prtry></SchmeNm></Othr></PrvtId></Id></CdtrSchmeId>
      ${txns}
    </PmtInf>
  </CstmrDrctDbtInitn>
</Document>`;
    descargar(xml, `sepa_pain008_${fecha}.xml`, 'application/xml');
  };

  // ── TABS ──
  window.setTab = function(tab) {
    ['pendientes','generar','csb','sepa','historial'].forEach(t => {
      document.getElementById('panel-' + t).classList.toggle('hidden', t !== tab);
      const btn = document.getElementById('tab-' + t);
      btn.classList.toggle('bg-blue-900', t === tab);
      btn.classList.toggle('text-white', t === tab);
      btn.classList.toggle('text-gray-500', t !== tab);
    });
  };

  // ── HELPERS ──
  function descargar(contenido, nombre, tipo) {
    const blob = new Blob([contenido], { type: tipo });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = nombre;
    a.click();
  }

  function mostrarMsg(id, texto, color) {
    const el = document.getElementById(id);
    el.className = `text-sm px-4 py-3 rounded-xl ${color === 'green' ? 'bg-green-50 text-green-700' : 'bg-red-50 text-red-700'}`;
    el.textContent = texto;
    el.classList.remove('hidden');
    setTimeout(() => el.classList.add('hidden'), 4000);
  }

  document.getElementById('btn-logout').addEventListener('click', async () => { await db.auth.signOut(); window.location.href = '/socios/login'; });

  init();
</script>
</Layout>
