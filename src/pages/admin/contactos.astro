---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Admin — Contactos">

  <div class="max-w-5xl mx-auto px-4 py-8">
    <div class="flex items-center justify-between mb-6">
      <div>
        <h1 class="text-2xl font-bold text-gray-900">Mensajes de Contacto</h1>
        <p class="text-sm text-gray-500 mt-1">Formularios recibidos desde la web</p>
      </div>
      <div class="flex gap-3">
        <span id="badge-nuevos" class="hidden bg-red-100 text-red-700 text-xs font-bold px-3 py-1.5 rounded-full"></span>
      </div>
    </div>

    <!-- Filtros -->
    <div class="flex gap-3 mb-5">
      <select id="filter-leido" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">Todos</option>
        <option value="false">No leídos</option>
        <option value="true">Leídos</option>
      </select>
      <select id="filter-asunto" class="border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="">Todos los asuntos</option>
        <option value="informacion">Información general</option>
        <option value="socio">Hacerse socio</option>
        <option value="seccion">Secciones</option>
        <option value="evento">Eventos</option>
        <option value="sugerencia">Sugerencia o queja</option>
        <option value="otro">Otro</option>
      </select>
    </div>

    <div class="bg-white rounded-xl shadow border border-gray-100 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-gray-50 border-b border-gray-200">
          <tr>
            <th class="text-left px-4 py-3 font-medium text-gray-600 w-8"></th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Nombre</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Email</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Asunto</th>
            <th class="text-left px-4 py-3 font-medium text-gray-600">Fecha</th>
            <th class="text-right px-4 py-3 font-medium text-gray-600">Acciones</th>
          </tr>
        </thead>
        <tbody id="tabla-body" class="divide-y divide-gray-100">
          <tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- MODAL VER MENSAJE -->
  <div id="modal" class="hidden fixed inset-0 z-50 flex items-center justify-center bg-black/50 p-4">
    <div class="bg-white rounded-2xl shadow-2xl w-full max-w-lg max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between px-6 py-4 border-b border-gray-200">
        <h2 class="text-lg font-bold text-gray-900">Mensaje de contacto</h2>
        <button id="btn-cerrar" class="text-gray-400 hover:text-gray-600 text-2xl">&times;</button>
      </div>
      <div class="px-6 py-5 space-y-4">
        <div class="grid grid-cols-2 gap-4">
          <div>
            <p class="text-xs text-gray-400 font-medium mb-1">Nombre</p>
            <p id="m-nombre" class="font-semibold text-gray-900"></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium mb-1">Email</p>
            <a id="m-email" href="" class="text-blue-700 hover:underline"></a>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium mb-1">Teléfono</p>
            <p id="m-telefono" class="text-gray-700"></p>
          </div>
          <div>
            <p class="text-xs text-gray-400 font-medium mb-1">Asunto</p>
            <p id="m-asunto" class="text-gray-700"></p>
          </div>
        </div>
        <div>
          <p class="text-xs text-gray-400 font-medium mb-1">Fecha</p>
          <p id="m-fecha" class="text-gray-500 text-sm"></p>
        </div>
        <div>
          <p class="text-xs text-gray-400 font-medium mb-2">Mensaje</p>
          <div id="m-mensaje" class="bg-gray-50 rounded-xl p-4 text-sm text-gray-700 leading-relaxed whitespace-pre-wrap"></div>
        </div>
        <div class="flex gap-3 pt-2">
          <a id="btn-responder" href="" class="flex-1 text-center bg-blue-900 text-white px-4 py-2.5 rounded-xl text-sm font-semibold hover:bg-blue-800 transition">
            ✉️ Responder por email
          </a>
          <button id="btn-marcar" class="px-4 py-2.5 border border-gray-200 rounded-xl text-sm font-medium text-gray-600 hover:bg-gray-50 transition">
            Marcar como leído
          </button>
          <button id="btn-borrar-msg" class="px-4 py-2.5 bg-red-50 text-red-600 rounded-xl text-sm font-medium hover:bg-red-100 transition">
            Borrar
          </button>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );

    let mensajes = [];
    let msgActual = null;

    async function init() {
      const { data } = await supabase
        .from('contactos')
        .select('*')
        .order('created_at', { ascending: false });
      mensajes = data || [];

      const noLeidos = mensajes.filter(m => !m.leido).length;
      const badge = document.getElementById('badge-nuevos');
      if (noLeidos > 0) {
        badge.textContent = `${noLeidos} nuevo${noLeidos > 1 ? 's' : ''}`;
        badge.classList.remove('hidden');
      } else {
        badge.classList.add('hidden');
      }

      renderTabla();
    }

    function renderTabla() {
      const filtroLeido  = document.getElementById('filter-leido').value;
      const filtroAsunto = document.getElementById('filter-asunto').value;

      const lista = mensajes.filter(m => {
        const ml = filtroLeido  === '' ? true : String(m.leido) === filtroLeido;
        const ma = filtroAsunto === '' ? true : m.asunto === filtroAsunto;
        return ml && ma;
      });

      const tbody = document.getElementById('tabla-body');
      if (!lista.length) {
        tbody.innerHTML = '<tr><td colspan="6" class="px-4 py-8 text-center text-gray-400">No hay mensajes</td></tr>';
        return;
      }

      const ASUNTOS = {
        informacion: 'Información general', socio: 'Hacerse socio',
        seccion: 'Secciones', evento: 'Eventos',
        sugerencia: 'Sugerencia o queja', otro: 'Otro'
      };

      tbody.innerHTML = lista.map(m => {
        const fecha = new Date(m.created_at).toLocaleDateString('es-ES', { day:'2-digit', month:'short', year:'numeric' });
        const hora  = new Date(m.created_at).toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit' });
        const punto = m.leido ? '' : '<div class="w-2.5 h-2.5 rounded-full bg-blue-600 flex-shrink-0"></div>';
        const rowClass = m.leido ? 'hover:bg-gray-50' : 'bg-blue-50/40 hover:bg-blue-50 font-medium';
        return `<tr class="${rowClass} cursor-pointer" data-id="${m.id}">
          <td class="px-4 py-3">${punto}</td>
          <td class="px-4 py-3 text-gray-900">${m.nombre} ${m.apellidos || ''}</td>
          <td class="px-4 py-3 text-gray-500">${m.email}</td>
          <td class="px-4 py-3 text-gray-500">${ASUNTOS[m.asunto] || m.asunto || '—'}</td>
          <td class="px-4 py-3 text-gray-400 text-xs">${fecha} ${hora}</td>
          <td class="px-4 py-3 text-right">
            <button data-ver="${m.id}" class="text-xs px-3 py-1 bg-blue-900 text-white rounded-lg hover:bg-blue-800">Ver</button>
          </td>
        </tr>`;
      }).join('');
    }

    document.getElementById('tabla-body').addEventListener('click', async e => {
      const btn = e.target.closest('button[data-ver]') || e.target.closest('tr[data-id]');
      if (!btn) return;
      const id = btn.dataset.ver || btn.dataset.id;
      const m = mensajes.find(x => x.id === id);
      if (!m) return;
      msgActual = m;
      abrirModal(m);
      // Marcar como leído automáticamente
      if (!m.leido) {
        await supabase.from('contactos').update({ leido: true }).eq('id', id);
        m.leido = true;
        renderTabla();
        const noLeidos = mensajes.filter(x => !x.leido).length;
        const badge = document.getElementById('badge-nuevos');
        if (noLeidos > 0) { badge.textContent = `${noLeidos} nuevo${noLeidos > 1 ? 's' : ''}`; }
        else { badge.classList.add('hidden'); }
      }
    });

    const ASUNTOS = {
      informacion: 'Información general', socio: 'Hacerse socio',
      seccion: 'Secciones', evento: 'Eventos',
      sugerencia: 'Sugerencia o queja', otro: 'Otro'
    };

    function abrirModal(m) {
      document.getElementById('m-nombre').textContent   = `${m.nombre} ${m.apellidos || ''}`;
      document.getElementById('m-email').textContent    = m.email;
      document.getElementById('m-email').href           = `mailto:${m.email}`;
      document.getElementById('m-telefono').textContent = m.telefono || '—';
      document.getElementById('m-asunto').textContent   = ASUNTOS[m.asunto] || m.asunto || '—';
      document.getElementById('m-fecha').textContent    = new Date(m.created_at).toLocaleString('es-ES');
      document.getElementById('m-mensaje').textContent  = m.mensaje;
      const asunto = encodeURIComponent(`Re: ${ASUNTOS[m.asunto] || m.asunto || 'Contacto web'}`);
      document.getElementById('btn-responder').href = `mailto:${m.email}?subject=${asunto}`;
      document.getElementById('btn-marcar').textContent = m.leido ? 'Marcar como no leído' : 'Marcar como leído';
      document.getElementById('modal').classList.remove('hidden');
    }

    document.getElementById('btn-cerrar').addEventListener('click', () => document.getElementById('modal').classList.add('hidden'));

    document.getElementById('btn-marcar').addEventListener('click', async () => {
      if (!msgActual) return;
      const nuevoEstado = !msgActual.leido;
      await supabase.from('contactos').update({ leido: nuevoEstado }).eq('id', msgActual.id);
      msgActual.leido = nuevoEstado;
      await init();
      document.getElementById('modal').classList.add('hidden');
    });

    document.getElementById('btn-borrar-msg').addEventListener('click', async () => {
      if (!msgActual || !confirm('¿Eliminar este mensaje?')) return;
      await supabase.from('contactos').delete().eq('id', msgActual.id);
      document.getElementById('modal').classList.add('hidden');
      await init();
    });

    document.getElementById('filter-leido').addEventListener('change', renderTabla);
    document.getElementById('filter-asunto').addEventListener('change', renderTabla);

    init();
  </script>

</Layout>
