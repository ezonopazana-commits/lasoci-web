---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Secciones — la Soci">

<style>
  .seccion-row { transition: background .15s, transform .1s; }
  .seccion-row:hover { background: #f0f7ff; transform: translateX(2px); }
  .filtro-pill { transition: all .15s; cursor: pointer; }
  .filtro-pill.activo { background: white; color: #1e3a8a; font-weight: 700; }
  .filtro-pill:not(.activo) { background: rgba(255,255,255,0.15); color: white; }
  .filtro-pill:not(.activo):hover { background: rgba(255,255,255,0.25); }
</style>

<!-- Hero con filtros integrados -->
<div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white px-6 pt-8 pb-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-1">Secciones</p>
    <h1 class="text-3xl font-bold mb-5">Nuestras secciones</h1>

    <!-- Filtros en una línea -->
    <div class="flex flex-wrap items-center gap-3">

      <!-- Tipo -->
      <div class="flex gap-1.5" id="filtros-tipo">
        <button data-tipo="" class="filtro-pill activo text-xs px-3 py-1.5 rounded-full border border-white/30">Todas</button>
        <button data-tipo="deportiva" class="filtro-pill text-xs px-3 py-1.5 rounded-full border border-white/20">⚽ Deportivas</button>
        <button data-tipo="cultural" class="filtro-pill text-xs px-3 py-1.5 rounded-full border border-white/20">🎭 Culturales</button>
      </div>

      <!-- Separador -->
      <div class="w-px h-6 bg-white/20"></div>

      <!-- Provincia -->
      <div class="flex gap-1.5 flex-wrap" id="filtros-provincia">
        <button data-provincia="" class="filtro-pill activo text-xs px-3 py-1.5 rounded-full border border-white/30">Todas</button>
      </div>

      <!-- Separador -->
      <div class="w-px h-6 bg-white/20"></div>

      <!-- Búsqueda -->
      <input id="search-seccion" type="text" placeholder="🔍 Buscar..."
        class="bg-white/15 border border-white/20 text-white placeholder-white/50 text-xs px-3 py-1.5 rounded-full focus:outline-none focus:bg-white/25 w-36" />

    </div>

    <!-- Contador -->
    <p id="contador" class="text-blue-300 text-xs mt-3"></p>
  </div>
</div>

<!-- Grid 2 columnas -->
<div class="max-w-5xl mx-auto px-4 py-6">
  <div id="grid-secciones" class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <div class="col-span-2 text-center py-12 text-gray-300">
      <p>Cargando secciones...</p>
    </div>
  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  let todasSecciones = [];
  let filtroTipo  = '';
  let filtroProv  = '';
  let busqueda    = '';

  async function init() {
    const { data: secciones } = await supabase
      .from('secciones')
      .select('id, nombre, descripcion, imagen_url, provincia, tipo, delegado:delegado_id(nombre, apellidos)')
      .eq('activa', true)
      .order('nombre');

    todasSecciones = secciones || [];

    // Contar miembros
    const { data: miembros } = await supabase.from('secciones_miembros').select('seccion_id');
    const conteo = {};
    (miembros || []).forEach(m => { conteo[m.seccion_id] = (conteo[m.seccion_id] || 0) + 1; });
    todasSecciones = todasSecciones.map(s => ({ ...s, nMiembros: conteo[s.id] || 0 }));

    // Provincias dinámicas
    const provincias = [...new Set(todasSecciones.map(s => s.provincia).filter(Boolean))].sort();
    const wrapProv = document.getElementById('filtros-provincia');
    provincias.forEach(p => {
      const btn = document.createElement('button');
      btn.dataset.provincia = p;
      btn.className = 'filtro-pill text-xs px-3 py-1.5 rounded-full border border-white/20';
      btn.textContent = '📍 ' + p;
      wrapProv.appendChild(btn);
    });

    renderGrid();
  }

  function renderGrid() {
    const lista = todasSecciones.filter(s => {
      const mt = !filtroTipo || s.tipo === filtroTipo;
      const mp = !filtroProv || s.provincia === filtroProv;
      const mb = !busqueda  || s.nombre.toLowerCase().includes(busqueda);
      return mt && mp && mb;
    });

    document.getElementById('contador').textContent = `${lista.length} sección${lista.length !== 1 ? 'es' : ''} encontradas`;

    const grid = document.getElementById('grid-secciones');
    if (!lista.length) {
      grid.innerHTML = '<div class="col-span-2 text-center py-12 text-gray-300"><p>No hay secciones que coincidan</p></div>';
      return;
    }

    grid.innerHTML = lista.map(s => {
      const tipoBadge = s.tipo === 'cultural'
        ? '<span class="text-xs font-semibold text-purple-600 bg-purple-50 px-2 py-0.5 rounded-full">🎭 Cultural</span>'
        : '<span class="text-xs font-semibold text-blue-600 bg-blue-50 px-2 py-0.5 rounded-full">⚽ Deportiva</span>';
      const img = s.imagen_url
        ? `<img src="${s.imagen_url}" class="w-12 h-12 rounded-xl object-cover flex-shrink-0" />`
        : `<div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center text-xl flex-shrink-0">${s.tipo === 'cultural' ? '🎭' : '⚽'}</div>`;
      return `
        <a href="/secciones/${s.id}" class="seccion-row flex items-center gap-4 bg-white rounded-xl border border-gray-100 shadow-sm p-4 hover:shadow-md">
          ${img}
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 mb-1">
              <h3 class="font-bold text-gray-900 truncate">${s.nombre}</h3>
              ${tipoBadge}
            </div>
            <div class="flex items-center gap-3 text-xs text-gray-400">
              ${s.provincia ? `<span>📍 ${s.provincia}</span>` : ''}
              <span>👥 ${s.nMiembros} miembro${s.nMiembros !== 1 ? 's' : ''}</span>
              ${s.delegado ? `<span>👤 ${s.delegado.nombre} ${s.delegado.apellidos}</span>` : ''}
            </div>
            ${s.descripcion ? `<p class="text-xs text-gray-400 mt-1 truncate">${s.descripcion}</p>` : ''}
          </div>
          <span class="text-gray-300 text-lg flex-shrink-0">›</span>
        </a>`;
    }).join('');
  }

  // ── FILTROS TIPO ──
  document.getElementById('filtros-tipo').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filtroTipo = btn.dataset.tipo;
    document.querySelectorAll('#filtros-tipo button').forEach(b => {
      b.className = `filtro-pill text-xs px-3 py-1.5 rounded-full border ${b.dataset.tipo === filtroTipo ? 'activo border-white/30' : 'border-white/20'}`;
    });
    renderGrid();
  });

  // ── FILTROS PROVINCIA ──
  document.getElementById('filtros-provincia').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filtroProv = btn.dataset.provincia;
    document.querySelectorAll('#filtros-provincia button').forEach(b => {
      b.className = `filtro-pill text-xs px-3 py-1.5 rounded-full border ${b.dataset.provincia === filtroProv ? 'activo border-white/30' : 'border-white/20'}`;
    });
    renderGrid();
  });

  // ── BÚSQUEDA ──
  document.getElementById('search-seccion').addEventListener('input', e => {
    busqueda = e.target.value.toLowerCase();
    renderGrid();
  });

  init();
</script>

</Layout>
