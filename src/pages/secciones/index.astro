---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Secciones — la Soci">

<style>
  .seccion-card { transition: transform .2s, box-shadow .2s; }
  .seccion-card:hover { transform: translateY(-4px); box-shadow: 0 16px 40px rgba(0,0,0,0.12); }
  .filtro-btn { transition: all .15s; }
  .filtro-btn.activo { background: #1e3a8a; color: white; border-color: #1e3a8a; }
</style>

<!-- Hero -->
<div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-6 px-6">
  <div class="max-w-5xl mx-auto">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">Secciones</p>
    <h1 class="text-4xl font-bold mb-3">Nuestras secciones</h1>
    <p class="text-blue-200 text-base max-w-xl">Descubre todas las actividades y grupos de la Soci. Únete a la que más te guste.</p>
  </div>
</div>

<div class="max-w-5xl mx-auto px-4 py-4">

  <!-- Filtros -->
  <div class="bg-white rounded-2xl border border-gray-100 shadow-sm p-4 mb-4 space-y-3">

    <!-- Tipo -->
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Tipo</p>
      <div id="filtros-tipo" class="flex flex-wrap gap-2">
        <button data-tipo="" class="filtro-btn activo px-4 py-1.5 rounded-full text-sm font-medium border-2 border-blue-900 bg-blue-900 text-white">Todas</button>
        <button data-tipo="deportiva" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border-2 border-gray-200 text-gray-600 hover:border-blue-300">⚽ Deportivas</button>
        <button data-tipo="cultural" class="filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border-2 border-gray-200 text-gray-600 hover:border-blue-300">🎭 Culturales</button>
      </div>
    </div>

    <!-- Provincia -->
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Provincia</p>
      <div id="filtros-provincia" class="flex flex-wrap gap-2">
        <button data-provincia="" class="filtro-btn activo px-4 py-1.5 rounded-full text-sm font-medium border-2 border-blue-900 bg-blue-900 text-white">Todas</button>
      </div>
    </div>

    <!-- Nombre -->
    <div>
      <p class="text-xs font-semibold text-gray-400 uppercase tracking-widest mb-2">Buscar por nombre</p>
      <input id="search-seccion" type="text" placeholder="Buscar sección..." class="w-full border border-gray-200 rounded-xl px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-400" />
    </div>

  </div>

  <!-- Contador -->
  <p id="contador" class="text-sm text-gray-400 mb-5"></p>

  <!-- Grid -->
  <div id="grid-secciones" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
    <div class="col-span-3 text-center py-16 text-gray-300">
      <div class="text-5xl mb-3">⏳</div>
      <p>Cargando secciones...</p>
    </div>
  </div>

</div>

<script>
  import { createClient } from '@supabase/supabase-js';
  const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY
  );

  let todasSecciones = [];
  let filtroTipo     = '';
  let filtroProv     = '';
  let busqueda       = '';

  async function init() {
    const { data: secciones } = await supabase
      .from('secciones')
      .select('id, nombre, descripcion, imagen_url, provincia, tipo, delegado:delegado_id(nombre, apellidos, avatar_url)')
      .eq('activa', true)
      .order('nombre');

    todasSecciones = secciones || [];

    // Contar miembros
    const { data: miembros } = await supabase.from('secciones_miembros').select('seccion_id');
    const conteo = {};
    (miembros || []).forEach(m => { conteo[m.seccion_id] = (conteo[m.seccion_id] || 0) + 1; });
    todasSecciones = todasSecciones.map(s => ({ ...s, nMiembros: conteo[s.id] || 0 }));

    // Poblar filtros de provincia dinámicamente
    const provincias = [...new Set(todasSecciones.map(s => s.provincia).filter(Boolean))].sort();
    const wrapProv = document.getElementById('filtros-provincia');
    provincias.forEach(p => {
      const btn = document.createElement('button');
      btn.dataset.provincia = p;
      btn.className = 'filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border-2 border-gray-200 text-gray-600 hover:border-blue-300';
      btn.textContent = '📍 ' + p;
      wrapProv.appendChild(btn);
    });

    renderGrid();
  }

  function renderGrid() {
    const lista = todasSecciones.filter(s => {
      const mt = !filtroTipo || s.tipo === filtroTipo;
      const mp = !filtroProv || s.provincia === filtroProv;
      const mb = !busqueda  || s.nombre.toLowerCase().includes(busqueda);
      return mt && mp && mb;
    });

    const grid = document.getElementById('grid-secciones');
    document.getElementById('contador').textContent = `${lista.length} sección${lista.length !== 1 ? 'es' : ''}`;

    if (!lista.length) {
      grid.innerHTML = '<div class="col-span-3 text-center py-16 text-gray-300"><div class="text-5xl mb-3">🔍</div><p>No hay secciones que coincidan</p></div>';
      return;
    }

    grid.innerHTML = lista.map(s => {
      const tipoBadge = s.tipo === 'cultural'
        ? '<span class="absolute top-3 left-3 bg-purple-600/90 text-white text-xs font-bold px-2 py-0.5 rounded-full">🎭 Cultural</span>'
        : '<span class="absolute top-3 left-3 bg-blue-600/90 text-white text-xs font-bold px-2 py-0.5 rounded-full">⚽ Deportiva</span>';
      const img = s.imagen_url
        ? `<img src="${s.imagen_url}" class="w-full h-48 object-cover" />`
        : `<div class="w-full h-48 bg-gradient-to-br from-blue-100 to-blue-200 flex items-center justify-center text-6xl">${s.tipo === 'cultural' ? '🎭' : '⚽'}</div>`;
      const delegado = s.delegado
        ? `<div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-100">
            ${s.delegado.avatar_url ? `<img src="${s.delegado.avatar_url}" class="w-7 h-7 rounded-full object-cover" />` : `<div class="w-7 h-7 rounded-full bg-blue-100 flex items-center justify-center text-xs text-blue-600 font-bold">${s.delegado.nombre?.[0]||'?'}</div>`}
            <span class="text-xs text-gray-400">Delegado/a: <span class="font-medium text-gray-600">${s.delegado.nombre} ${s.delegado.apellidos}</span></span>
          </div>` : '';
      return `
        <a href="/secciones/${s.id}" class="seccion-card bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm flex flex-col">
          <div class="relative">
            ${img}
            ${tipoBadge}
            ${s.provincia ? `<span class="absolute top-3 right-3 bg-white/90 backdrop-blur text-xs font-semibold text-gray-700 px-2 py-1 rounded-full">📍 ${s.provincia}</span>` : ''}
          </div>
          <div class="p-5 flex-1 flex flex-col">
            <h3 class="text-lg font-bold text-gray-900 mb-2">${s.nombre}</h3>
            ${s.descripcion ? `<p class="text-sm text-gray-500 line-clamp-3 flex-1">${s.descripcion}</p>` : '<div class="flex-1"></div>'}
            <div class="flex items-center justify-between mt-4">
              <span class="text-xs text-gray-400">👥 ${s.nMiembros} miembro${s.nMiembros !== 1 ? 's' : ''}</span>
              <span class="text-xs font-semibold text-blue-900">Ver sección →</span>
            </div>
            ${delegado}
          </div>
        </a>`;
    }).join('');
  }

  // ── FILTROS ──
  document.getElementById('filtros-tipo').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filtroTipo = btn.dataset.tipo;
    document.querySelectorAll('#filtros-tipo button').forEach(b => {
      b.className = `filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border-2 transition ${b.dataset.tipo === filtroTipo ? 'border-blue-900 bg-blue-900 text-white' : 'border-gray-200 text-gray-600 hover:border-blue-300'}`;
    });
    renderGrid();
  });

  document.getElementById('filtros-provincia').addEventListener('click', e => {
    const btn = e.target.closest('button');
    if (!btn) return;
    filtroProv = btn.dataset.provincia;
    document.querySelectorAll('#filtros-provincia button').forEach(b => {
      b.className = `filtro-btn px-4 py-1.5 rounded-full text-sm font-medium border-2 transition ${b.dataset.provincia === filtroProv ? 'border-blue-900 bg-blue-900 text-white' : 'border-gray-200 text-gray-600 hover:border-blue-300'}`;
    });
    renderGrid();
  });

  document.getElementById('search-seccion').addEventListener('input', e => {
    busqueda = e.target.value.toLowerCase();
    renderGrid();
  });

  init();

</script>

</Layout>
