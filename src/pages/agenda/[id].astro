---
import Layout from '../../layouts/Layout.astro';
const { id } = Astro.params;
---

<Layout title="Evento — la Soci">

  <div id="evento-wrap" class="max-w-3xl mx-auto px-4 py-10">
    <p class="text-gray-400 text-center py-20">Cargando evento...</p>
  </div>

  <script>
    import { createClient } from '@supabase/supabase-js';
    const supabase = createClient(
      import.meta.env.PUBLIC_SUPABASE_URL,
      import.meta.env.PUBLIC_SUPABASE_ANON_KEY
    );
    const eventoId = window.location.pathname.split('/').pop();

    async function init() {
      const { data: ev } = await supabase
        .from('eventos')
        .select('*')
        .eq('id', eventoId)
        .eq('activo', true)
        .single();

      if (!ev) {
        document.getElementById('evento-wrap').innerHTML = '<p class="text-center text-gray-400 py-20">Evento no encontrado.</p>';
        return;
      }

      // Contar inscritos
      const { count: inscritos } = await supabase
        .from('inscripciones')
        .select('*', { count: 'exact', head: true })
        .eq('evento_id', ev.id)
        .eq('estado', 'confirmada');

      // Ver si el usuario está inscrito
      const { data: { user } } = await supabase.auth.getUser();
      let miInscripcion = null;
      if (user) {
        const { data } = await supabase
          .from('inscripciones')
          .select('id, estado')
          .eq('evento_id', ev.id)
          .eq('socio_id', user.id)
          .single();
        miInscripcion = data;
      }

      const fecha    = new Date(ev.fecha_inicio);
      const diaStr   = fecha.toLocaleDateString('es-ES', { weekday:'long', day:'numeric', month:'long', year:'numeric' });
      const horaStr  = fecha.toLocaleTimeString('es-ES', { hour:'2-digit', minute:'2-digit' });
      const precio   = ev.precio > 0 ? `${Number(ev.precio).toFixed(2)} € (cargo en cuenta)` : 'Gratuito';
      const plazasLibres = ev.plazas ? ev.plazas - (inscritos || 0) : null;
      const agotado  = plazasLibres !== null && plazasLibres <= 0;

      // Comprobar plazo de inscripción (2 días antes del evento)
      const ahora = new Date();
      const fechaEvento = new Date(ev.fecha_inicio);
      const diasRestantes = (fechaEvento - ahora) / (1000 * 60 * 60 * 24);
      const plazoCerrado = diasRestantes < 2;

      // Cargar datos del delegado si el plazo está cerrado y el evento es de sección
      let delegadoInfo = null;
      if (plazoCerrado && ev.seccion_id) {
        const { data: sec } = await supabase
          .from('secciones')
          .select('nombre, delegado_id')
          .eq('id', ev.seccion_id)
          .single();
        if (sec?.delegado_id) {
          const { data: delegado } = await supabase
            .from('socios')
            .select('nombre, apellidos, email, telefono')
            .eq('id', sec.delegado_id)
            .single();
          if (delegado) delegadoInfo = delegado;
        }
      }

      let btnInscripcion = '';
      if (plazoCerrado) {
        const contacto = delegadoInfo
          ? `<div class="mt-3 bg-white border border-amber-200 rounded-xl p-4">
              <p class="text-xs font-bold text-amber-700 uppercase tracking-wide mb-2">Contacta con el delegado/a</p>
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-orange-100 flex items-center justify-center text-orange-600 font-bold text-sm flex-shrink-0">
                  ${delegadoInfo.nombre.charAt(0)}${delegadoInfo.apellidos.charAt(0)}
                </div>
                <div>
                  <p class="font-semibold text-gray-800 text-sm">${delegadoInfo.nombre} ${delegadoInfo.apellidos}</p>
                  <div class="flex flex-wrap gap-3 mt-1">
                    <a href="mailto:${delegadoInfo.email}" class="flex items-center gap-1 text-xs text-blue-600 hover:underline">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                      ${delegadoInfo.email}
                    </a>
                    ${delegadoInfo.telefono ? `<a href="tel:${delegadoInfo.telefono}" class="flex items-center gap-1 text-xs text-green-600 hover:underline">
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
                      ${delegadoInfo.telefono}
                    </a>` : ''}
                  </div>
                </div>
              </div>
            </div>`
          : `<p class="text-sm text-gray-600 mt-2">Contacta con el delegado de tu sección para inscribirte.</p>`;
        btnInscripcion = `
          <div class="bg-amber-50 border border-amber-200 rounded-xl px-5 py-4">
            <p class="font-semibold text-amber-800">⏰ Plazo de inscripción cerrado</p>
            <p class="text-sm text-amber-700 mt-1">El plazo de inscripción online finalizó 2 días antes del evento.</p>
            ${contacto}
          </div>`;
      } else if (!user) {
        btnInscripcion = `<a href="/socios/login" class="inline-block bg-blue-900 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-800 transition">Inicia sesión para inscribirte</a>`;
      } else if (miInscripcion?.estado === 'confirmada') {
        btnInscripcion = `
          <div class="flex items-center gap-3">
            <span class="bg-green-100 text-green-700 px-4 py-2 rounded-xl font-medium text-sm">✅ Inscrito/a</span>
            <button onclick="cancelarInscripcion('${miInscripcion.id}')" class="text-sm text-red-500 hover:underline">Cancelar inscripción</button>
          </div>`;
      } else if (miInscripcion?.estado === 'espera') {
        btnInscripcion = `
          <div class="flex items-center gap-3">
            <span class="bg-yellow-100 text-yellow-700 px-4 py-2 rounded-xl font-medium text-sm">⏳ En lista de espera</span>
            <button onclick="cancelarInscripcion('${miInscripcion.id}')" class="text-sm text-red-500 hover:underline">Cancelar</button>
          </div>`;
      } else if (agotado) {
        btnInscripcion = `<button onclick="inscribirse()" class="bg-yellow-500 text-white px-6 py-3 rounded-xl font-semibold hover:bg-yellow-600 transition">Apuntarse a lista de espera</button>`;
      } else {
        btnInscripcion = `<button onclick="inscribirse()" class="bg-blue-900 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-800 transition">Inscribirse</button>`;
      }

      document.getElementById('evento-wrap').innerHTML = `
        <a href="/agenda" class="text-sm text-blue-700 hover:underline mb-6 inline-block">← Volver a la agenda</a>
        ${ev.imagen_url ? `<img src="${ev.imagen_url}" class="w-full h-72 object-cover rounded-2xl mb-6" />` : ''}
        <div class="flex items-center gap-2 mb-3">
          <span class="text-xs font-semibold uppercase tracking-widest px-3 py-1 rounded-full ${ev.tipo === 'seccion' ? 'bg-purple-100 text-purple-700' : 'bg-blue-100 text-blue-700'}">${ev.tipo === 'seccion' ? 'Sección' : 'General'}</span>
          ${ev.precio > 0 ? `<span class="text-xs font-semibold bg-orange-100 text-orange-700 px-3 py-1 rounded-full">${Number(ev.precio).toFixed(2)} €</span>` : '<span class="text-xs font-semibold bg-green-100 text-green-700 px-3 py-1 rounded-full">Gratuito</span>'}
        </div>
        <h1 class="text-3xl font-bold text-gray-900 mb-4">${ev.titulo}</h1>
        <div class="flex flex-wrap gap-4 text-sm text-gray-600 mb-6">
          <span>📅 ${diaStr} · ${horaStr}h</span>
          ${ev.lugar ? `<span>📍 ${ev.lugar}</span>` : ''}
          ${ev.plazas ? `<span>👥 ${inscritos || 0} / ${ev.plazas} inscritos${agotado ? ' · <span class="text-red-500 font-medium">Completo</span>' : ` · <span class="text-green-600">${plazasLibres} plazas libres</span>`}</span>` : ''}
          ${!plazoCerrado ? `<span class="text-green-600 text-xs font-medium">✅ Inscripción abierta (cierra ${Math.ceil(diasRestantes - 2) <= 1 ? 'mañana' : `en ${Math.ceil(diasRestantes - 2)} días`})</span>` : ''}
        </div>
        ${ev.descripcion ? `<div class="prose prose-sm max-w-none text-gray-700 mb-8">${ev.descripcion}</div>` : ''}
        <div id="btn-wrap" class="flex items-center gap-4">
          ${btnInscripcion}
        </div>
        <div id="msg-inscripcion" class="hidden mt-4 text-sm rounded-lg px-4 py-3"></div>
      `;
    }

    window.inscribirse = async function() {
      const { data: { user } } = await supabase.auth.getUser();
      if (!user) { window.location.href = '/socios/login'; return; }

      // Verificar plazo
      const { data: evCheck } = await supabase.from('eventos').select('fecha_inicio, plazas').eq('id', eventoId).single();
      const diasR = (new Date(evCheck.fecha_inicio) - new Date()) / (1000 * 60 * 60 * 24);
      if (diasR < 2) {
        const msg = document.getElementById('msg-inscripcion');
        msg.classList.remove('hidden');
        msg.className = 'mt-4 text-sm rounded-lg px-4 py-3 bg-amber-50 text-amber-700';
        msg.textContent = 'El plazo de inscripción ha cerrado. Contacta con el delegado de sección.';
        return;
      }

      const { count } = await supabase
        .from('inscripciones')
        .select('*', { count: 'exact', head: true })
        .eq('evento_id', eventoId)
        .eq('estado', 'confirmada');

      const { data: ev } = await supabase.from('eventos').select('plazas').eq('id', eventoId).single();
      const enEspera = ev.plazas && count >= ev.plazas;

      const { error } = await supabase.from('inscripciones').insert({
        evento_id: eventoId,
        socio_id: user.id,
        estado: enEspera ? 'espera' : 'confirmada'
      });

      const msg = document.getElementById('msg-inscripcion');
      msg.classList.remove('hidden');
      if (error) {
        msg.className = 'mt-4 text-sm rounded-lg px-4 py-3 bg-red-50 text-red-700';
        msg.textContent = 'Error: ' + error.message;
      } else {
        msg.className = 'mt-4 text-sm rounded-lg px-4 py-3 bg-green-50 text-green-700';
        msg.textContent = enEspera ? 'Añadido/a a la lista de espera.' : '¡Inscripción confirmada!';
        setTimeout(() => location.reload(), 1200);
      }
    };

    window.cancelarInscripcion = async function(inscripcionId) {
      await supabase.from('inscripciones').update({ estado: 'cancelada' }).eq('id', inscripcionId);
      location.reload();
    };

    init();
  </script>

</Layout>
