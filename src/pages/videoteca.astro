---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Videoteca — la Soci">
  <div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-4 px-6 text-center">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">la Soci</p>
    <h1 class="text-2xl font-bold mb-4" data-i18n="vid_title">Videoteca</h1>
    <p class="text-blue-200 max-w-xl mx-auto" data-i18n="vid_sub">Vídeos institucionales, de eventos y de vida asociativa</p>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Categorías -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🏛️</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_institucional">Institucional</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🎓</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_formacion">Formación</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">🎤</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_eventos">Eventos</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md transition">
        <div class="text-3xl mb-2">💬</div>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_entrevistas">Entrevistas</h3>
      </div>
    </div>

    <h2 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="vid_destacados">Vídeos destacados</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {[1,2,3].map(() => (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
          <div class="relative bg-gray-100 h-36 flex items-center justify-center">
            <span class="text-4xl">▶️</span>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-800 mb-1" data-i18n="vid_proximamente_titulo">Próximamente</h3>
            <p class="text-gray-500 text-xs" data-i18n="vid_proximamente_desc">Estamos preparando el primer contenido de la Videoteca.</p>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
      <p class="text-amber-800 text-sm" data-i18n="vid_info">La Videoteca se irá llenando con vídeos propios de la Soci: bienvenida a nuevos socios, agenda de eventos grabada y entrevistas. No requiere ningún acuerdo externo para empezar.</p>
    </div>
  </div>

  <script>
    const T = {
      es: { vid_title:'Videoteca', vid_sub:'Vídeos institucionales, de eventos y de vida asociativa', vid_institucional:'Institucional', vid_formacion:'Formación', vid_eventos:'Eventos', vid_entrevistas:'Entrevistas', vid_destacados:'Vídeos destacados', vid_proximamente_titulo:'Próximamente', vid_proximamente_desc:'Estamos preparando el primer contenido de la Videoteca.', vid_info:'La Videoteca se irá llenando con vídeos propios de la Soci: bienvenida a nuevos socios, agenda de eventos grabada y entrevistas. No requiere ningún acuerdo externo para empezar.' },
      ca: { vid_title:'Videoteca', vid_sub:'V\u00eddeos institucionals, d\u2019esdeveniments i de vida associativa', vid_institucional:'Institucional', vid_formacion:'Formaci\u00f3', vid_eventos:'Esdeveniments', vid_entrevistas:'Entrevistes', vid_destacados:'V\u00eddeos destacats', vid_proximamente_titulo:'Properament', vid_proximamente_desc:'Estem preparant el primer contingut de la Videoteca.', vid_info:'La Videoteca s\u2019anir\u00e0 omplint amb v\u00eddeos propis de la Soci: benvinguda a nous socis, agenda d\u2019esdeveniments enregistrada i entrevistes. No requereix cap acord extern per comen\u00e7ar.' },
      en: { vid_title:'Video Library', vid_sub:'Institutional, event and association life videos', vid_institucional:'Institutional', vid_formacion:'Training', vid_eventos:'Events', vid_entrevistas:'Interviews', vid_destacados:'Featured videos', vid_proximamente_titulo:'Coming soon', vid_proximamente_desc:'We are preparing the first Video Library content.', vid_info:'The Video Library will grow with la Soci\u2019s own videos: welcome to new members, recorded event agendas and interviews. No external agreement is needed to get started.' }
    };
    function applyLang(lang) { const t=T[lang]||T.es; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.getAttribute('data-i18n'); if(t[k]) el.textContent=t[k]; }); }
    applyLang(localStorage.getItem('lasoci_lang')||'es');
    window.addEventListener('langchange', e => applyLang(e.detail.lang));
  </script>
</Layout>
