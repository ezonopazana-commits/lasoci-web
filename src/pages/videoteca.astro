---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Videoteca — la Soci">
  <div class="bg-gradient-to-br from-blue-950 to-blue-800 text-white py-4 px-6 text-center">
    <p class="text-orange-400 text-xs font-bold uppercase tracking-widest mb-2">la Soci</p>
    <h1 class="text-2xl font-bold mb-4" data-i18n="vid_title">Videoteca</h1>
    <p class="text-blue-200 max-w-xl mx-auto" data-i18n="vid_sub">Vídeos institucionales, de eventos y de vida asociativa</p>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-12">

    <!-- Categorías -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-12">
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2M5 21H3m16 0h-2M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_institucional">Institucional</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_formacion">Formación</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_eventos">Eventos</h3>
      </div>
      <div class="bg-white rounded-xl shadow-sm border border-gray-100 p-5 text-center hover:shadow-md hover:-translate-y-0.5 transition-all">
        <svg class="w-8 h-8 mx-auto mb-2 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
        <h3 class="font-semibold text-gray-800 text-sm" data-i18n="vid_entrevistas">Entrevistas</h3>
      </div>
    </div>

    <!-- DEMO: reproductor real -->
    <div class="rounded-2xl border-2 border-dashed border-blue-200 bg-blue-50/40 p-6 mb-12">
      <div class="flex items-center gap-2 mb-1">
        <span class="bg-blue-600 text-white text-[10px] font-bold uppercase tracking-wide px-2.5 py-1 rounded-full" data-i18n="vid_demo_badge">Demo</span>
        <h2 class="text-xl font-bold text-gray-800" data-i18n="vid_demo_titulo">Así se verá la Videoteca</h2>
      </div>
      <p class="text-gray-500 text-sm mb-5" data-i18n="vid_demo_sub">Reproductor de muestra — el contenido real de la Soci llegará próximamente.</p>

      <div class="bg-black rounded-xl overflow-hidden shadow-lg mb-3">
        <video controls class="w-full aspect-video" preload="metadata" poster="">
          <source src="https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/BigBuckBunny.mp4" type="video/mp4" />
        </video>
      </div>
      <p class="text-[11px] text-gray-400 text-center" data-i18n="vid_demo_nota">Vídeo de muestra con licencia libre (Blender Foundation), solo para probar el reproductor.</p>
    </div>

    <h2 class="text-2xl font-bold text-gray-800 mb-6" data-i18n="vid_destacados">Próximos vídeos</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mb-12">
      {[1,2,3].map(() => (
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 overflow-hidden hover:shadow-md transition">
          <div class="relative bg-gray-100 h-36 flex items-center justify-center">
            <svg class="w-10 h-10 text-blue-900/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5"><path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"/><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          </div>
          <div class="p-4">
            <h3 class="font-bold text-gray-800 mb-1" data-i18n="vid_proximamente_titulo">Próximamente</h3>
            <p class="text-gray-500 text-xs" data-i18n="vid_proximamente_desc">Estamos preparando el primer contenido de la Videoteca.</p>
          </div>
        </div>
      ))}
    </div>

    <div class="bg-amber-50 border border-amber-200 rounded-2xl p-6 text-center">
      <p class="text-amber-800 text-sm" data-i18n="vid_info">La Videoteca se irá llenando con vídeos propios de la Soci: bienvenida a nuevos socios, agenda de eventos grabada y entrevistas. No requiere ningún acuerdo externo para empezar.</p>
    </div>
  </div>

  <script>
    const T = {
      es: { vid_title:'Videoteca', vid_sub:'Vídeos institucionales, de eventos y de vida asociativa', vid_institucional:'Institucional', vid_formacion:'Formación', vid_eventos:'Eventos', vid_entrevistas:'Entrevistas', vid_demo_badge:'Demo', vid_demo_titulo:'Así se verá la Videoteca', vid_demo_sub:'Reproductor de muestra — el contenido real de la Soci llegará próximamente.', vid_demo_nota:'Vídeo de muestra con licencia libre (Blender Foundation), solo para probar el reproductor.', vid_destacados:'Próximos vídeos', vid_proximamente_titulo:'Próximamente', vid_proximamente_desc:'Estamos preparando el primer contenido de la Videoteca.', vid_info:'La Videoteca se irá llenando con vídeos propios de la Soci: bienvenida a nuevos socios, agenda de eventos grabada y entrevistas. No requiere ningún acuerdo externo para empezar.' },
      ca: { vid_title:'Videoteca', vid_sub:'V\u00eddeos institucionals, d\u2019esdeveniments i de vida associativa', vid_institucional:'Institucional', vid_formacion:'Formaci\u00f3', vid_eventos:'Esdeveniments', vid_entrevistas:'Entrevistes', vid_demo_badge:'Demo', vid_demo_titulo:'Aix\u00ed es veur\u00e0 la Videoteca', vid_demo_sub:'Reproductor de mostra — el contingut real de la Soci arribar\u00e0 properament.', vid_demo_nota:'V\u00eddeo de mostra amb llic\u00e8ncia lliure (Blender Foundation), nom\u00e9s per provar el reproductor.', vid_destacados:'Pr\u00f2xims v\u00eddeos', vid_proximamente_titulo:'Properament', vid_proximamente_desc:'Estem preparant el primer contingut de la Videoteca.', vid_info:'La Videoteca s\u2019anir\u00e0 omplint amb v\u00eddeos propis de la Soci: benvinguda a nous socis, agenda d\u2019esdeveniments enregistrada i entrevistes. No requereix cap acord extern per comen\u00e7ar.' },
      en: { vid_title:'Video Library', vid_sub:'Institutional, event and association life videos', vid_institucional:'Institutional', vid_formacion:'Training', vid_eventos:'Events', vid_entrevistas:'Interviews', vid_demo_badge:'Demo', vid_demo_titulo:'A preview of the Video Library', vid_demo_sub:'Sample player — la Soci\u2019s real content is coming soon.', vid_demo_nota:'Free-licensed sample video (Blender Foundation), just to test the player.', vid_destacados:'Coming videos', vid_proximamente_titulo:'Coming soon', vid_proximamente_desc:'We are preparing the first Video Library content.', vid_info:'The Video Library will grow with la Soci\u2019s own videos: welcome to new members, recorded event agendas and interviews. No external agreement is needed to get started.' }
    };
    function applyLang(lang) { const t=T[lang]||T.es; document.querySelectorAll('[data-i18n]').forEach(el => { const k=el.getAttribute('data-i18n'); if(t[k]) el.textContent=t[k]; }); }
    applyLang(localStorage.getItem('lasoci_lang')||'es');
    window.addEventListener('langchange', e => applyLang(e.detail.lang));
  </script>
</Layout>
